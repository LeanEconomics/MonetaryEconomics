import NeoWicksellianFramework.Learning
import Mathlib.Analysis.Calculus.FDeriv.Mul
import Mathlib.Analysis.Calculus.FDeriv.Prod
import Mathlib.LinearAlgebra.Matrix.Adjugate

/-!
# Preston's long-horizon learning: the `T`-map

Woodford (2003), *Interest and Prices*, Chapter 4, §2.3, pp. 272–275 ((2.28)–(2.30) and the
setting of Proposition 4.10), following Preston (2005), "Learning about Monetary Policy Rules
when Long-Horizon Expectations Matter", *International Journal of Central Banking* 1(2),
§§1–3 and Appendix 4 (cited by the book as Preston (2002a)).

## The learning setup

`z = (π, x, î)` (components `0, 1, 2`). The exogenous states follow (2.24),
`s_{t+1} = C s_t + e_{t+1}` (`Learning.Regression.StateLaw`), the natural rate is
`r̂ⁿ_t = f_r′ s_t` and the Taylor-rule intercept `ī_t = c_ī + f_ī′ s_t`. Agents hold an estimated
model `(Φ̂, Ĉ)`: regression of `z_τ` on `s̄_{τ−1}` (intercepts `Φ̂₀`, slopes `Φ̂ₛ`) and of `s_τ` on
`s_{τ−1}` (`Ĉ`). Their forecasts are `Ê_t z_{t+k+1} = Φ̂₀ + Φ̂ₛ Ĉᵏ s_t` (`fcast`) and
`Ê_t r̂ⁿ_{t+k} = f_r′ Ĉᵏ s_t` (`rnfc`); current values are known (`subj`).

* `IS229`, `AS230`, `TaylorRule`: (2.29), (2.30) and (1.14) at date `t`, literally, with these
  forecasts (genuine infinite sums, `tsum`).
* `hasSum_fcast`, `hasSum_rnfc`, `hasSum_subj`: the sums converge and are geometric series in
  the estimated coefficients, `∑ aᵏ Ê_t z_{t+k+1} = Φ̂₀/(1 − a) + Φ̂ₛ (I − aĈ)⁻¹ s_t`, whenever
  every eigenvalue of `βĈ` lies inside the unit circle (`hasSum_smul_pow`, from Gelfand's formula
  via `BlanchardKahn.pow_entry_bound`; `hasSum_pow_of_bound`).
* `tempEqm_iff`, `decisionRules_iff`: **the actual law of motion** — the three relations hold at
  `t` iff `z_t = tempSol(s_t) = A₁ ∑(αβ)ᵏÊz + A₂ ∑βᵏÊz + …` (Preston's App. 4), and
  `tempSol_eq`: `z_t = T₀(Φ̂₀) + Mₛ(Φ̂ₛ, Ĉ) s_t`.
* `tMapP`: **the `T`-map** `(Φ, C) = T(Φ̂, Ĉ) = ((T₀(Φ̂₀), Mₛ(Φ̂ₛ, Ĉ) C), C)`;
  `E_succ_eq_tMapP`: the rational forecast `E_t z_{t+1}` of the data generated by `(Φ̂, Ĉ)` is
  the forecast of `T(Φ̂, Ĉ)` (PLM → ALM).

## The Jacobian

* `tVecP`: the `T`-map in coordinates `(Φ̂₀, vec Φ̂ₛ, vec Ĉ)`; `differentiableAt_tVecP` (the
  inverses `(I − aĈ)⁻¹` are differentiable by Cramer's rule, `DiffEnt`).
* `aInt` (`DT₀`), `hMat` (`H = ((I − αβC)⁻¹C)′ ⊗ A₁ + ((I − βC)⁻¹C)′ ⊗ A₂`), `dTP`
  (`DT_Φ = blockdiag(DT₀, H)`); `tVecP_inl_eq`, `tVecP_inr` ("the part of the `T` mapping that
  determines `C` is a constant function").
* `toMatrix_fderiv_of_block`, `isEig_fromBlocks_zero_iff`, `eStable_fromBlocks_zero_iff`,
  `eStableAt_iff_of_block`: the Jacobian is `[[DT_Φ, ∗], [0, 0]]`; its eigenvalues are those of
  `DT_Φ` and zeros.
* `eStableAt_tVecP_iff`, `eStable_dTP_of_eStableAt`: a fixed point is E-stable (`EStableAt`, the
  project's definition used for Propositions 4.8–4.9) iff `DT_Φ` is.
-/

namespace Woodford.NeoWicksellianFramework.PrestonLearning

open Matrix Filter Topology Determinacy2
open Determinacy2Learning (EStable EStableAt eStable_iff)
open scoped _root_.Kronecker

/-! ### The temporary equilibrium under long-horizon forecasts -/

/-- Woodford (2003), (2.29) p. 273 (Preston (2005), (18)): the weights of the discounted
forecasts `∑ βᵏ Ê_t z_{t+k+1}` of `z = (π, x, î)` in aggregate demand, `(σ, 1 − β, −σβ)`. -/
def demandW (β σ : ℝ) : Fin 3 → ℝ := ![σ, 1 - β, -(σ * β)]

/-- Woodford (2003), (2.30) p. 273 (Preston (2005), (19)): the weights of the discounted
forecasts `∑ (αβ)ᵏ Ê_t z_{t+k+1}` in the inflation equation, `((1 − α)β, καβ, 0)`. -/
def supplyW (α β κ : ℝ) : Fin 3 → ℝ := ![(1 - α) * β, κ * (α * β), 0]

/-- Woodford (2003), p. 274 (Preston (2005), App. 4): the response of `(π, x, î)` to the
supply-side forecast aggregate, `(1 + σφ_x/4, −σφ_π, φ_π)/Δ`, `Δ = 1 + σφ_x/4 + σκφ_π`. -/
noncomputable def colS (σ κ φπ φx : ℝ) : Fin 3 → ℝ :=
  ![(1 + σ * φx / 4) / taylorDelta σ κ φπ φx, -(σ * φπ) / taylorDelta σ κ φπ φx,
    φπ / taylorDelta σ κ φπ φx]

/-- Woodford (2003), p. 274 (Preston (2005), App. 4): the response of `(π, x, î)` to the
demand-side forecast aggregate, `(κ, 1, κφ_π + φ_x/4)/Δ`. -/
noncomputable def colD (σ κ φπ φx : ℝ) : Fin 3 → ℝ :=
  ![κ / taylorDelta σ κ φπ φx, 1 / taylorDelta σ κ φπ φx,
    (κ * φπ + φx / 4) / taylorDelta σ κ φπ φx]

/-- Woodford (2003), (1.14): the interest-rate coordinate `(0, 0, 1)` of `z = (π, x, î)`. -/
def eI : Fin 3 → ℝ := ![0, 0, 1]

/-- Woodford (2003), p. 274 (Preston (2005), App. 4, `A₁`): the rank-one matrix mapping the
supply-side forecast sums `∑ (αβ)ᵏ Ê_t z_{t+k+1}` into `z_t`. -/
noncomputable def matS (α β κ σ φπ φx : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  vecMulVec (colS σ κ φπ φx) (supplyW α β κ)

/-- Woodford (2003), p. 274 (Preston (2005), App. 4, `A₂`): the rank-one matrix mapping the
demand-side forecast sums `∑ βᵏ Ê_t z_{t+k+1}` into `z_t`. -/
noncomputable def matD (β κ σ φπ φx : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  vecMulVec (colD σ κ φπ φx) (demandW β σ)

/-- Woodford (2003), (2.29)–(2.30) and (1.14), pp. 273–274: **the temporary equilibrium**.
Given the forecast aggregates `Zs = ∑ (αβ)ᵏ Ê_t z_{t+k+1}`, `Zd = ∑ βᵏ Ê_t z_{t+k+1}`, the
forecast sum `R = ∑ βᵏ Ê_t r̂ⁿ_{t+k}` and the Taylor-rule intercept `c`, the three relations
`x = −σ î + d′Zd + σR`, `π = κx + s′Zs`, `î = c + φ_π π + φ_x x/4` hold iff
`z = A₁ Zs + A₂ Zd + (σR − σc) colD + c e_î` (Preston (2005), App. 4). -/
theorem tempEqm_iff {α β κ σ φπ φx : ℝ} (hΔ : taylorDelta σ κ φπ φx ≠ 0)
    (z Zs Zd : Fin 3 → ℝ) (R c : ℝ) :
    (z 1 = -(σ * z 2) + (demandW β σ ⬝ᵥ Zd + σ * R) ∧
        z 0 = κ * z 1 + supplyW α β κ ⬝ᵥ Zs ∧ z 2 = c + φπ * z 0 + φx / 4 * z 1) ↔
      z = matS α β κ σ φπ φx *ᵥ Zs + matD β κ σ φπ φx *ᵥ Zd +
        (σ * R - σ * c) • colD σ κ φπ φx + c • eI := by
  have hS : matS α β κ σ φπ φx *ᵥ Zs = (supplyW α β κ ⬝ᵥ Zs) • colS σ κ φπ φx := by
    funext j
    simp [matS, mulVec, dotProduct, vecMulVec_apply, Finset.mul_sum, mul_comm, mul_left_comm]
  have hD : matD β κ σ φπ φx *ᵥ Zd = (demandW β σ ⬝ᵥ Zd) • colD σ κ φπ φx := by
    funext j
    simp [matD, mulVec, dotProduct, vecMulVec_apply, Finset.mul_sum, mul_comm, mul_left_comm]
  rw [hS, hD]
  set a := supplyW α β κ ⬝ᵥ Zs
  set D := demandW β σ ⬝ᵥ Zd
  have hΔe : taylorDelta σ κ φπ φx = 1 + σ * φx / 4 + σ * κ * φπ := rfl
  have hinv : taylorDelta σ κ φπ φx * (taylorDelta σ κ φπ φx)⁻¹ = 1 := mul_inv_cancel₀ hΔ
  constructor
  · rintro ⟨h1, h2, h3⟩
    have hz1 : z 1 = (D + σ * R - σ * c - σ * φπ * a) * (taylorDelta σ κ φπ φx)⁻¹ := by
      rw [← div_eq_mul_inv, eq_div_iff hΔ, hΔe]
      linear_combination h1 - σ * h3 - σ * φπ * h2
    funext j
    fin_cases j
    · simp only [colS, colD, eI, Fin.zero_eta, Fin.isValue, Pi.add_apply, Pi.smul_apply,
        smul_eq_mul, Matrix.cons_val_zero, div_eq_mul_inv]
      linear_combination h2 + κ * hz1 - a * hinv + a * (taylorDelta σ κ φπ φx)⁻¹ * hΔe
    · simp only [colS, colD, eI, Fin.mk_one, Fin.isValue, Pi.add_apply, Pi.smul_apply,
        smul_eq_mul, Matrix.cons_val_one, Matrix.cons_val_zero, div_eq_mul_inv]
      linear_combination hz1
    · simp only [colS, colD, eI, Fin.reduceFinMk, Fin.isValue, Pi.add_apply, Pi.smul_apply,
        smul_eq_mul, Matrix.cons_val_two,
        Nat.succ_eq_add_one, Nat.reduceAdd, Matrix.tail_cons, Matrix.head_cons, div_eq_mul_inv]
      linear_combination h3 + φπ * h2 + (φπ * κ + φx / 4) * hz1 - φπ * a * hinv +
        φπ * a * (taylorDelta σ κ φπ φx)⁻¹ * hΔe
  · intro hz
    have h0 := congrFun hz 0
    have h1 := congrFun hz 1
    have h2 := congrFun hz 2
    simp only [colS, colD, eI, Fin.isValue, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Nat.succ_eq_add_one,
      Nat.reduceAdd, Matrix.tail_cons, Matrix.head_cons, div_eq_mul_inv] at h0 h1 h2
    refine ⟨?_, ?_, ?_⟩
    · rw [h1, h2]
      linear_combination (D + σ * R - σ * c) * hinv -
        (D + σ * R - σ * c) * (taylorDelta σ κ φπ φx)⁻¹ * hΔe
    · rw [h0, h1]
      linear_combination a * hinv - a * (taylorDelta σ κ φπ φx)⁻¹ * hΔe
    · rw [h0, h1, h2]
      ring

/-! ### Geometric series of matrices -/

/-- Woodford (2003), p. 274 (Preston (2005), App. 4, `∑ βᵏ Cᵏ = (I − βC)⁻¹`): if the entries of
`Kᵏ` decay geometrically, `∑ₖ Kᵏ` converges (entrywise) to `(I − K)⁻¹`. -/
theorem hasSum_pow_of_bound {n : ℕ} (K : Matrix (Fin n) (Fin n) ℝ) {Cb ρ : ℝ} (hρ0 : 0 ≤ ρ)
    (hρ1 : ρ < 1) (hb : ∀ k i j, |(K ^ k) i j| ≤ Cb * ρ ^ k) :
    HasSum (fun k => K ^ k) (1 - K)⁻¹ := by
  have hs : Summable (fun k => K ^ k) := by
    refine Pi.summable.mpr fun i => Pi.summable.mpr fun j => ?_
    exact Summable.of_norm_bounded ((summable_geometric_of_lt_one hρ0 hρ1).mul_left Cb)
      fun k => by rw [Real.norm_eq_abs]; exact hb k i j
  have ht : Tendsto (fun k => K ^ k) atTop (𝓝 0) := by
    refine tendsto_pi_nhds.mpr fun i => tendsto_pi_nhds.mpr fun j => ?_
    have hg : Tendsto (fun k => Cb * ρ ^ k) atTop (𝓝 0) := by
      simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hρ0 hρ1).const_mul Cb
    exact squeeze_zero_norm (fun k => by rw [Real.norm_eq_abs]; exact hb k i j) hg
  have h1 : Tendsto (fun N => (1 - K) * ∑ k ∈ Finset.range N, K ^ k) atTop
      (𝓝 ((1 - K) * ∑' k, K ^ k)) :=
    hs.hasSum.tendsto_sum_nat.const_mul (1 - K)
  have h2 : Tendsto (fun N => (1 - K) * ∑ k ∈ Finset.range N, K ^ k) atTop (𝓝 1) := by
    have : (fun N => (1 - K) * ∑ k ∈ Finset.range N, K ^ k) = fun N => 1 - K ^ N := by
      funext N; exact mul_neg_geom_sum K N
    rw [this]
    simpa using (tendsto_const_nhds (x := (1 : Matrix (Fin n) (Fin n) ℝ))).sub ht
  have h3 : (1 - K) * ∑' k, K ^ k = 1 := tendsto_nhds_unique h1 h2
  rw [Matrix.inv_eq_right_inv h3]
  exact hs.hasSum

/-- Woodford (2003), p. 270 (`C` "with all eigenvalues inside the unit circle"): the entries of
`Kᵏ` decay geometrically when every complex eigenvalue of `K` has modulus `< 1` (restated from
`BlanchardKahn.pow_entry_bound` in terms of `IsEig`). -/
theorem pow_bound_of_isEig {n : ℕ} (K : Matrix (Fin n) (Fin n) ℝ)
    (hK : ∀ w, KroneckerSpectrum.IsEig (K.map Complex.ofReal) w → ‖w‖ < 1) :
    ∃ Cb ρ : ℝ, 0 ≤ Cb ∧ 0 < ρ ∧ ρ < 1 ∧ ∀ k i j, |(K ^ k) i j| ≤ Cb * ρ ^ k := by
  refine BlanchardKahn.pow_entry_bound K fun w hw => hK w ?_
  rw [KroneckerSpectrum.isEig_iff_det]
  have : Matrix.scalar (Fin n) w = w • (1 : Matrix (Fin n) (Fin n) ℂ) := by
    ext i j
    by_cases h : i = j <;> simp [h, Matrix.scalar_apply]
  rw [← this]
  exact hw

/-- Woodford (2003), p. 274: for `|a| ≤ 1` and `K` with every eigenvalue inside the unit
circle, `∑ₖ (aK)ᵏ = (I − aK)⁻¹`. -/
theorem hasSum_smul_pow {n : ℕ} (K : Matrix (Fin n) (Fin n) ℝ)
    (hK : ∀ w, KroneckerSpectrum.IsEig (K.map Complex.ofReal) w → ‖w‖ < 1) {a : ℝ}
    (ha : |a| ≤ 1) : HasSum (fun k => (a • K) ^ k) (1 - a • K)⁻¹ := by
  obtain ⟨Cb, ρ, hCb, hρ0, hρ1, hb⟩ := pow_bound_of_isEig K hK
  refine hasSum_pow_of_bound (a • K) (Cb := Cb) hρ0.le hρ1 fun k i j => ?_
  rw [smul_pow, Matrix.smul_apply, smul_eq_mul, abs_mul, abs_pow]
  exact (mul_le_of_le_one_left (abs_nonneg _) (pow_le_one₀ (abs_nonneg a) ha)).trans (hb k i j)

/-- Woodford (2003), p. 274: a convergent series of matrices can be summed inside the bilinear
form `p′ X v`. -/
theorem hasSum_dotProduct_mulVec {n : ℕ} {X : ℕ → Matrix (Fin n) (Fin n) ℝ}
    {S : Matrix (Fin n) (Fin n) ℝ} (h : HasSum X S) (p v : Fin n → ℝ) :
    HasSum (fun k => p ⬝ᵥ (X k *ᵥ v)) (p ⬝ᵥ (S *ᵥ v)) := by
  simp only [dotProduct, mulVec, Finset.mul_sum]
  refine hasSum_sum fun i _ => hasSum_sum fun j _ => ?_
  have hij : HasSum (fun k => X k i j) (S i j) := Pi.hasSum.mp (Pi.hasSum.mp h i) j
  exact (hij.mul_right (v j)).mul_left (p i)

/-! ### Forecasts and Preston's decision rules -/

variable {Ω : Type*} {n : ℕ}

/-- Woodford (2003), (2.24) p. 270: the exogenous state vector `s_t(ω)`. -/
def sv (s : ℕ → Fin n → Ω → ℝ) (t : ℕ) (ω : Ω) : Fin n → ℝ := fun l => s t l ω

/-- Woodford (2003), p. 274 (Preston (2005), (24), (40)): the subjective forecast implied by the
estimated model `(Φ̂, Ĉ)`, `Ê_t z_{t+k+1} = Φ̂₀ + Φ̂ₛ Ĉᵏ s_t` (component `j` of
`z = (π, x, î)`). -/
def fcast (Φ : Learning.Regression.Belief (Fin 3) (Fin n)) (Ch : Matrix (Fin n) (Fin n) ℝ)
    (s : ℕ → Fin n → Ω → ℝ) (t k : ℕ) (j : Fin 3) (ω : Ω) : ℝ :=
  Φ.1 j + Φ.2 j ⬝ᵥ (Ch ^ k *ᵥ sv s t ω)

/-- Woodford (2003), (2.24) and p. 274: the subjective forecast of the natural rate
`Ê_t r̂ⁿ_{t+k} = f_r′ Ĉᵏ s_t` from the estimated law of motion of the states. -/
def rnfc (gr : Fin n → ℝ) (Ch : Matrix (Fin n) (Fin n) ℝ) (s : ℕ → Fin n → Ω → ℝ)
    (t k : ℕ) (ω : Ω) : ℝ :=
  gr ⬝ᵥ (Ch ^ k *ᵥ sv s t ω)

/-- Woodford (2003), (2.29)–(2.30) p. 273: the subjective forecast `Ê_t z_{t+m}` entering the
long-horizon rules: the current value for `m = 0` (known at `t`), the model forecast for
`m ≥ 1`. -/
def subj (z : ℕ → Fin 3 → Ω → ℝ) (Φ : Learning.Regression.Belief (Fin 3) (Fin n))
    (Ch : Matrix (Fin n) (Fin n) ℝ) (s : ℕ → Fin n → Ω → ℝ) (t m : ℕ) (j : Fin 3)
    (ω : Ω) : ℝ :=
  if m = 0 then z t j ω else fcast Φ Ch s t (m - 1) j ω

/-- Woodford (2003), **(2.29)** p. 273, at date `t`, with the forecasts of the estimated model:
`x_t = ∑_{k ≥ 0} βᵏ [(1 − β) Ê_t x_{t+k+1} − σ (Ê_t î_{t+k} − Ê_t π_{t+k+1} − Ê_t r̂ⁿ_{t+k})]`.
Components of `z`: `0 = π`, `1 = x`, `2 = î`. -/
def IS229 (β σ : ℝ) (gr : Fin n → ℝ) (Φ : Learning.Regression.Belief (Fin 3) (Fin n))
    (Ch : Matrix (Fin n) (Fin n) ℝ) (s : ℕ → Fin n → Ω → ℝ) (z : ℕ → Fin 3 → Ω → ℝ)
    (t : ℕ) : Prop :=
  ∀ ω, z t 1 ω = ∑' k, β ^ k * ((1 - β) * subj z Φ Ch s t (k + 1) 1 ω -
    σ * (subj z Φ Ch s t k 2 ω - subj z Φ Ch s t (k + 1) 0 ω - rnfc gr Ch s t k ω))

/-- Woodford (2003), **(2.30)** p. 273, at date `t`, with the forecasts of the estimated model:
`π_t = ∑_{k ≥ 0} (αβ)ᵏ [κ Ê_t x_{t+k} + (1 − α)β Ê_t π_{t+k+1}]`. -/
def AS230 (α β κ : ℝ) (Φ : Learning.Regression.Belief (Fin 3) (Fin n))
    (Ch : Matrix (Fin n) (Fin n) ℝ) (s : ℕ → Fin n → Ω → ℝ) (z : ℕ → Fin 3 → Ω → ℝ)
    (t : ℕ) : Prop :=
  ∀ ω, z t 0 ω = ∑' k, (α * β) ^ k *
    (κ * subj z Φ Ch s t k 1 ω + (1 - α) * β * subj z Φ Ch s t (k + 1) 0 ω)

/-- Woodford (2003), **(1.14)** p. 254 at date `t`: `î_t = ī_t + φ_π (π_t − π̄) + φ_x (x_t − x̄)/4`
with `ī_t = c_ī + f_ī′ s_t` (the book's `u_t = f′ s_t`, plus a constant). -/
def TaylorRule (φπ φx πbar xbar ci : ℝ) (gi : Fin n → ℝ) (s : ℕ → Fin n → Ω → ℝ)
    (z : ℕ → Fin 3 → Ω → ℝ) (t : ℕ) : Prop :=
  ∀ ω, z t 2 ω = (ci + gi ⬝ᵥ sv s t ω) + φπ * (z t 0 ω - πbar) + φx / 4 * (z t 1 ω - xbar)

/-- Woodford (2003), p. 274 (Preston (2005), App. 4, `f_α`): the closed form of
`∑ (αβ)ᵏ Ê_t z_{t+k+1} = Φ̂₀/(1 − αβ) + Φ̂ₛ (I − αβĈ)⁻¹ s_t`. -/
noncomputable def sumS (α β : ℝ) (Φ : Learning.Regression.Belief (Fin 3) (Fin n))
    (Ch : Matrix (Fin n) (Fin n) ℝ) (v : Fin n → ℝ) : Fin 3 → ℝ :=
  fun j => Φ.1 j / (1 - α * β) + Φ.2 j ⬝ᵥ ((1 - (α * β) • Ch)⁻¹ *ᵥ v)

/-- Woodford (2003), p. 274 (Preston (2005), App. 4, `f_β`): the closed form of
`∑ βᵏ Ê_t z_{t+k+1} = Φ̂₀/(1 − β) + Φ̂ₛ (I − βĈ)⁻¹ s_t`. -/
noncomputable def sumD (β : ℝ) (Φ : Learning.Regression.Belief (Fin 3) (Fin n))
    (Ch : Matrix (Fin n) (Fin n) ℝ) (v : Fin n → ℝ) : Fin 3 → ℝ :=
  fun j => Φ.1 j / (1 - β) + Φ.2 j ⬝ᵥ ((1 - β • Ch)⁻¹ *ᵥ v)

/-- Woodford (2003), p. 274 (Preston (2005), App. 4, `f_γ`): the closed form of
`∑ βᵏ Ê_t r̂ⁿ_{t+k} = f_r′ (I − βĈ)⁻¹ s_t`. -/
noncomputable def sumR (β : ℝ) (gr : Fin n → ℝ) (Ch : Matrix (Fin n) (Fin n) ℝ)
    (v : Fin n → ℝ) : ℝ :=
  gr ⬝ᵥ ((1 - β • Ch)⁻¹ *ᵥ v)

/-- Woodford (2003), p. 274: **the infinite sums of forecasts are geometric series in the
estimated coefficients**: for `|a| < 1` and `∑ (aĈ)ᵏ = S`,
`∑ aᵏ Ê_t z_{t+k+1} = Φ̂₀/(1 − a) + Φ̂ₛ S s_t` (summable, no junk values). -/
theorem hasSum_fcast {a : ℝ} (ha : |a| < 1) {Ch S : Matrix (Fin n) (Fin n) ℝ}
    (hS : HasSum (fun k => (a • Ch) ^ k) S) (Φ : Learning.Regression.Belief (Fin 3) (Fin n))
    (s : ℕ → Fin n → Ω → ℝ) (t : ℕ) (j : Fin 3) (ω : Ω) :
    HasSum (fun k => a ^ k * fcast Φ Ch s t k j ω)
      (Φ.1 j / (1 - a) + Φ.2 j ⬝ᵥ (S *ᵥ sv s t ω)) := by
  have h1 : HasSum (fun k => a ^ k * Φ.1 j) (Φ.1 j / (1 - a)) := by
    rw [div_eq_inv_mul]
    exact (hasSum_geometric_of_abs_lt_one ha).mul_right (Φ.1 j)
  have h2 := hasSum_dotProduct_mulVec hS (Φ.2 j) (sv s t ω)
  convert h1.add h2 using 1
  funext k
  simp only [fcast, smul_pow, Matrix.smul_mulVec, dotProduct_smul, smul_eq_mul]
  ring

/-- Woodford (2003), p. 274: `∑ aᵏ Ê_t r̂ⁿ_{t+k} = f_r′ S s_t` when `∑ (aĈ)ᵏ = S`. -/
theorem hasSum_rnfc {a : ℝ} {Ch S : Matrix (Fin n) (Fin n) ℝ}
    (hS : HasSum (fun k => (a • Ch) ^ k) S) (gr : Fin n → ℝ) (s : ℕ → Fin n → Ω → ℝ)
    (t : ℕ) (ω : Ω) :
    HasSum (fun k => a ^ k * rnfc gr Ch s t k ω) (gr ⬝ᵥ (S *ᵥ sv s t ω)) := by
  convert hasSum_dotProduct_mulVec hS gr (sv s t ω) using 1
  funext k
  simp only [rnfc, smul_pow, Matrix.smul_mulVec, dotProduct_smul, smul_eq_mul]

/-- Woodford (2003), p. 273: the discounted sum of `Ê_t z_{t+m}`, `m ≥ 0`, starting with the
known current value: `∑ aᵐ Ê_t z_{t+m} = z_t + a ∑ aᵏ Ê_t z_{t+k+1}`. -/
theorem hasSum_subj {a : ℝ} (ha : |a| < 1) {Ch S : Matrix (Fin n) (Fin n) ℝ}
    (hS : HasSum (fun k => (a • Ch) ^ k) S) (z : ℕ → Fin 3 → Ω → ℝ)
    (Φ : Learning.Regression.Belief (Fin 3) (Fin n)) (s : ℕ → Fin n → Ω → ℝ) (t : ℕ)
    (j : Fin 3) (ω : Ω) :
    HasSum (fun m => a ^ m * subj z Φ Ch s t m j ω)
      (z t j ω + a * (Φ.1 j / (1 - a) + Φ.2 j ⬝ᵥ (S *ᵥ sv s t ω))) := by
  refine (hasSum_nat_add_iff' 1).mp ?_
  convert (hasSum_fcast ha hS Φ s t j ω).mul_left a using 1
  · funext k
    simp only [subj, Nat.add_eq_zero_iff, one_ne_zero, and_false, ↓reduceIte,
      Nat.add_sub_cancel, pow_succ]
    ring
  · simp [subj]

/-! ### The actual law of motion generated by the estimated model -/

/-- Woodford (2003), (1.14): the constant of the Taylor rule written as
`î_t = c + f_ī′ s_t + φ_π π_t + φ_x x_t/4`, `c = c_ī − φ_π π̄ − φ_x x̄/4`. -/
noncomputable def taylorConst (φπ φx πbar xbar ci : ℝ) : ℝ := ci - φπ * πbar - φx / 4 * xbar

/-- Woodford (2003), p. 274 (Preston (2005), App. 4, `z_t = A₁f_α + A₂f_β + A₃f_γ`): the
temporary equilibrium `z_t` as a function of the state `s_t = v`, given the estimated model. -/
noncomputable def tempSol (α β κ σ φπ φx c : ℝ) (gr gi : Fin n → ℝ)
    (Φ : Learning.Regression.Belief (Fin 3) (Fin n)) (Ch : Matrix (Fin n) (Fin n) ℝ)
    (v : Fin n → ℝ) : Fin 3 → ℝ :=
  matS α β κ σ φπ φx *ᵥ sumS α β Φ Ch v + matD β κ σ φπ φx *ᵥ sumD β Φ Ch v +
    (σ * sumR β gr Ch v - σ * (c + gi ⬝ᵥ v)) • colD σ κ φπ φx + (c + gi ⬝ᵥ v) • eI

/-- Woodford (2003), pp. 273–274: **the actual law of motion under the estimated model
`(Φ̂, Ĉ)`**. For `0 < β < 1`, `0 ≤ α < 1`, `Δ ≠ 0`, and beliefs `Ĉ` with every eigenvalue of
`βĈ` inside the unit circle (so that every discounted forecast sum converges), the
long-horizon rules (2.29), (2.30) and the Taylor rule (1.14) hold at date `t` iff
`z_t = tempSol(s_t)`. -/
theorem decisionRules_iff {α β κ σ φπ φx πbar xbar ci : ℝ} {gr gi : Fin n → ℝ}
    (hβ0 : 0 < β) (hβ1 : β < 1) (hα0 : 0 ≤ α) (hα1 : α < 1)
    (hΔ : taylorDelta σ κ φπ φx ≠ 0) {Φ : Learning.Regression.Belief (Fin 3) (Fin n)}
    {Ch : Matrix (Fin n) (Fin n) ℝ}
    (hK : ∀ w, KroneckerSpectrum.IsEig ((β • Ch).map Complex.ofReal) w → ‖w‖ < 1)
    (s : ℕ → Fin n → Ω → ℝ) (z : ℕ → Fin 3 → Ω → ℝ) (t : ℕ) :
    (IS229 β σ gr Φ Ch s z t ∧ AS230 α β κ Φ Ch s z t ∧
        TaylorRule φπ φx πbar xbar ci gi s z t) ↔
      ∀ ω, (fun j => z t j ω) =
        tempSol α β κ σ φπ φx (taylorConst φπ φx πbar xbar ci) gr gi Φ Ch (sv s t ω) := by
  have hβa : |β| < 1 := by rw [abs_lt]; constructor <;> linarith
  have hαβa : |α * β| < 1 := by rw [abs_lt]; constructor <;> nlinarith
  have hSβ : HasSum (fun k => (β • Ch) ^ k) (1 - β • Ch)⁻¹ := by
    simpa using hasSum_smul_pow (β • Ch) hK (a := 1) (by norm_num)
  have hSαβ : HasSum (fun k => ((α * β) • Ch) ^ k) (1 - (α * β) • Ch)⁻¹ := by
    have := hasSum_smul_pow (β • Ch) hK (a := α) (abs_le.mpr ⟨by linarith, by linarith⟩)
    simpa [smul_smul] using this
  have hIS : ∀ ω, HasSum (fun k => β ^ k * ((1 - β) * subj z Φ Ch s t (k + 1) 1 ω -
      σ * (subj z Φ Ch s t k 2 ω - subj z Φ Ch s t (k + 1) 0 ω - rnfc gr Ch s t k ω)))
      (-(σ * z t 2 ω) + (demandW β σ ⬝ᵥ sumD β Φ Ch (sv s t ω) +
        σ * sumR β gr Ch (sv s t ω))) := by
    intro ω
    have h1 := hasSum_fcast hβa hSβ Φ s t 1 ω
    have h0 := hasSum_fcast hβa hSβ Φ s t 0 ω
    have hr := hasSum_rnfc hSβ gr s t ω
    have hi := hasSum_subj hβa hSβ z Φ s t 2 ω
    convert (((h1.mul_left (1 - β)).add (h0.mul_left σ)).add (hr.mul_left σ)).sub
      (hi.mul_left σ) using 1
    · funext k
      simp only [subj, Nat.add_eq_zero_iff, one_ne_zero, and_false, ↓reduceIte,
        Nat.add_sub_cancel]
      ring
    · simp only [demandW, sumD, sumR, dotProduct, Fin.sum_univ_three, Fin.isValue,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Nat.succ_eq_add_one,
        Nat.reduceAdd, Matrix.tail_cons, Matrix.head_cons]
      have : (1 - β) ≠ 0 := by linarith
      field_simp
      ring
  have hAS : ∀ ω, HasSum (fun k => (α * β) ^ k *
      (κ * subj z Φ Ch s t k 1 ω + (1 - α) * β * subj z Φ Ch s t (k + 1) 0 ω))
      (κ * z t 1 ω + supplyW α β κ ⬝ᵥ sumS α β Φ Ch (sv s t ω)) := by
    intro ω
    have hx := hasSum_subj hαβa hSαβ z Φ s t 1 ω
    have hp := hasSum_fcast hαβa hSαβ Φ s t 0 ω
    convert (hx.mul_left κ).add (hp.mul_left ((1 - α) * β)) using 1
    · funext k
      simp only [subj, Nat.add_eq_zero_iff, one_ne_zero, and_false, ↓reduceIte,
        Nat.add_sub_cancel]
      ring
    · simp only [supplyW, sumS, dotProduct, Fin.sum_univ_three, Fin.isValue,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Nat.succ_eq_add_one,
        Nat.reduceAdd, Matrix.tail_cons, Matrix.head_cons]
      ring
  have hIS' : IS229 β σ gr Φ Ch s z t ↔ ∀ ω, z t 1 ω = -(σ * z t 2 ω) +
      (demandW β σ ⬝ᵥ sumD β Φ Ch (sv s t ω) + σ * sumR β gr Ch (sv s t ω)) :=
    forall_congr' fun ω => by rw [(hIS ω).tsum_eq]
  have hAS' : AS230 α β κ Φ Ch s z t ↔ ∀ ω, z t 0 ω = κ * z t 1 ω +
      supplyW α β κ ⬝ᵥ sumS α β Φ Ch (sv s t ω) :=
    forall_congr' fun ω => by rw [(hAS ω).tsum_eq]
  have hTR : TaylorRule φπ φx πbar xbar ci gi s z t ↔ ∀ ω, z t 2 ω =
      (taylorConst φπ φx πbar xbar ci + gi ⬝ᵥ sv s t ω) + φπ * z t 0 ω + φx / 4 * z t 1 ω :=
    forall_congr' fun ω => by
      unfold taylorConst
      constructor <;> intro h <;> linarith
  rw [hIS', hAS', hTR, ← forall_and, ← forall_and]
  exact forall_congr' fun ω => tempEqm_iff hΔ (fun j => z t j ω) _ _ _ _

/-- Woodford (2003), p. 274 (Preston (2005), App. 4): the intercept of the actual law of
motion, `T₀(Φ̂₀) = A₁Φ̂₀/(1 − αβ) + A₂Φ̂₀/(1 − β) − σc colD + c e_î`. -/
noncomputable def interceptP (α β κ σ φπ φx c : ℝ) (Φ0 : Fin 3 → ℝ) : Fin 3 → ℝ :=
  matS α β κ σ φπ φx *ᵥ ((1 - α * β)⁻¹ • Φ0) + matD β κ σ φπ φx *ᵥ ((1 - β)⁻¹ • Φ0) +
    (-(σ * c)) • colD σ κ φπ φx + c • eI

/-- Woodford (2003), p. 274 (Preston (2005), App. 4): the slope of the actual law of motion on
`s_t`, `A₁Φ̂ₛ(I − αβĈ)⁻¹ + A₂Φ̂ₛ(I − βĈ)⁻¹ + σ colD f_r′(I − βĈ)⁻¹ + (e_î − σ colD) f_ī′`. -/
noncomputable def slopeP (α β κ σ φπ φx : ℝ) (gr gi : Fin n → ℝ)
    (Φs : Matrix (Fin 3) (Fin n) ℝ) (Ch : Matrix (Fin n) (Fin n) ℝ) : Matrix (Fin 3) (Fin n) ℝ :=
  matS α β κ σ φπ φx * Φs * (1 - (α * β) • Ch)⁻¹ + matD β κ σ φπ φx * Φs * (1 - β • Ch)⁻¹ +
    σ • vecMulVec (colD σ κ φπ φx) (gr ᵥ* (1 - β • Ch)⁻¹) +
    vecMulVec (eI - σ • colD σ κ φπ φx) gi

/-- Woodford (2003), p. 274: `vecMulVec u w *ᵥ v = (w′v) u`. -/
theorem vecMulVec_mulVec' {m : Type*} (u : Fin 3 → ℝ) (w v : m → ℝ) [Fintype m] :
    vecMulVec u w *ᵥ v = (w ⬝ᵥ v) • u := by
  funext i
  simp only [mulVec, dotProduct, vecMulVec_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_mul]
  exact Finset.sum_congr rfl fun x _ => by ring

/-- Woodford (2003), p. 274: "the elements of `z_t` are determined as linear functions of
`s̄_t`": `tempSol(v) = T₀(Φ̂₀) + Mₛ(Φ̂ₛ, Ĉ) v`. -/
theorem tempSol_eq (α β κ σ φπ φx c : ℝ) (gr gi : Fin n → ℝ)
    (Φ : Learning.Regression.Belief (Fin 3) (Fin n)) (Ch : Matrix (Fin n) (Fin n) ℝ)
    (v : Fin n → ℝ) :
    tempSol α β κ σ φπ φx c gr gi Φ Ch v =
      interceptP α β κ σ φπ φx c Φ.1 + slopeP α β κ σ φπ φx gr gi Φ.2 Ch *ᵥ v := by
  have hS : sumS α β Φ Ch v =
      (1 - α * β)⁻¹ • Φ.1 + Φ.2 *ᵥ ((1 - (α * β) • Ch)⁻¹ *ᵥ v) := by
    funext j
    simp only [sumS, Pi.add_apply, Pi.smul_apply, smul_eq_mul, div_eq_inv_mul]
    rfl
  have hD : sumD β Φ Ch v = (1 - β)⁻¹ • Φ.1 + Φ.2 *ᵥ ((1 - β • Ch)⁻¹ *ᵥ v) := by
    funext j
    simp only [sumD, Pi.add_apply, Pi.smul_apply, smul_eq_mul, div_eq_inv_mul]
    rfl
  have hR : (gr ᵥ* (1 - β • Ch)⁻¹) ⬝ᵥ v = sumR β gr Ch v := by
    rw [sumR, dotProduct_mulVec]
  simp only [tempSol, interceptP, slopeP, hS, hD, Matrix.mulVec_add, Matrix.add_mulVec,
    ← Matrix.mulVec_mulVec, Matrix.smul_mulVec, vecMulVec_mulVec', hR]
  module

/-- Woodford (2003), p. 274: **the `T`-map** `(Φ, C) = T(Φ̂, Ĉ)` of Proposition 4.10: the
correct regression of `z_{t+1}` on `s̄_t` has intercept `T₀(Φ̂₀)` and slopes `Mₛ(Φ̂ₛ, Ĉ) C`; the
correct regression of `s_{t+1}` on `s_t` has slopes `C` ("a constant function"). -/
noncomputable def tMapP (α β κ σ φπ φx c : ℝ) (gr gi : Fin n → ℝ) (C : Matrix (Fin n) (Fin n) ℝ)
    (B : Learning.Regression.Belief (Fin 3) (Fin n) × Matrix (Fin n) (Fin n) ℝ) :
    Learning.Regression.Belief (Fin 3) (Fin n) × Matrix (Fin n) (Fin n) ℝ :=
  ((interceptP α β κ σ φπ φx c B.1.1, slopeP α β κ σ φπ φx gr gi B.1.2 B.2 * C), C)

/-- Woodford (2003), p. 274: **the `T`-map is the map from the perceived to the actual law of
motion.** If at date `t + 1` the long-horizon rules (2.29)–(2.30) and the Taylor rule hold
with the estimated model `(Φ̂, Ĉ)`, and the states follow (2.24) with matrix `C`, then the
rational forecast `E_t z_{t+1}` is the forecast of the model `T(Φ̂, Ĉ)`. -/
theorem E_succ_eq_tMapP {𝔼 : ExpectationSystem Ω} {C : Matrix (Fin n) (Fin n) ℝ}
    {s e : ℕ → Fin n → Ω → ℝ} (h : Learning.Regression.StateLaw 𝔼 C s e)
    {α β κ σ φπ φx πbar xbar ci : ℝ} {gr gi : Fin n → ℝ}
    (hβ0 : 0 < β) (hβ1 : β < 1) (hα0 : 0 ≤ α) (hα1 : α < 1)
    (hΔ : taylorDelta σ κ φπ φx ≠ 0) {Φ : Learning.Regression.Belief (Fin 3) (Fin n)}
    {Ch : Matrix (Fin n) (Fin n) ℝ}
    (hK : ∀ w, KroneckerSpectrum.IsEig ((β • Ch).map Complex.ofReal) w → ‖w‖ < 1)
    (z : ℕ → Fin 3 → Ω → ℝ) (t : ℕ)
    (hz : IS229 β σ gr Φ Ch s z (t + 1) ∧ AS230 α β κ Φ Ch s z (t + 1) ∧
        TaylorRule φπ φx πbar xbar ci gi s z (t + 1)) (j : Fin 3) :
    𝔼.E t (z (t + 1) j) = Learning.Regression.forecast
      (tMapP α β κ σ φπ φx (taylorConst φπ φx πbar xbar ci) gr gi C (Φ, Ch)).1 s t j := by
  have hz' := (decisionRules_iff hβ0 hβ1 hα0 hα1 hΔ hK s z (t + 1)).mp hz
  have hzj : z (t + 1) j = Learning.Regression.affRV
      (interceptP α β κ σ φπ φx (taylorConst φπ φx πbar xbar ci) Φ.1 j)
      (slopeP α β κ σ φπ φx gr gi Φ.2 Ch j) (s (t + 1)) := by
    funext ω
    have := congrFun (hz' ω) j
    rw [tempSol_eq] at this
    rw [this]
    simp [Learning.Regression.affRV, mulVec, dotProduct, sv]
  rw [hzj, Learning.Regression.E_affRV_succ h]
  rfl

/-! ### The Jacobian of the `T`-map -/

/-- Woodford (2003), p. 275 (Preston (2005), App. 4, `A = (1 − αβ)⁻¹A₁ + (1 − β)⁻¹A₂`): the
Jacobian `DT₀` of the intercept part of the `T`-map. -/
noncomputable def aInt (α β κ σ φπ φx : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  (1 - α * β)⁻¹ • matS α β κ σ φπ φx + (1 - β)⁻¹ • matD β κ σ φπ φx

/-- Woodford (2003), p. 275 (Preston (2005), App. 4, `H`): the Jacobian of the slope part of
the `T`-map at `Ĉ = C`, acting on `vec Φ̂ₛ`:
`H = ((I − αβC)⁻¹C)′ ⊗ A₁ + ((I − βC)⁻¹C)′ ⊗ A₂`. -/
noncomputable def hMat (α β κ σ φπ φx : ℝ) (C : Matrix (Fin n) (Fin n) ℝ) :
    Matrix (Fin n × Fin 3) (Fin n × Fin 3) ℝ :=
  ((1 - (α * β) • C)⁻¹ * C)ᵀ ⊗ₖ matS α β κ σ φπ φx + ((1 - β • C)⁻¹ * C)ᵀ ⊗ₖ matD β κ σ φπ φx

/-- Woodford (2003), p. 275: the Jacobian `DT_Φ = blockdiag(DT₀, H)` of the map `Φ = T_Φ(Φ̂)`
(beliefs about `C` held at the truth). -/
noncomputable def dTP (α β κ σ φπ φx : ℝ) (C : Matrix (Fin n) (Fin n) ℝ) :
    Matrix (Fin 3 ⊕ (Fin n × Fin 3)) (Fin 3 ⊕ (Fin n × Fin 3)) ℝ :=
  fromBlocks (aInt α β κ σ φπ φx) 0 0 (hMat α β κ σ φπ φx C)

/-- Woodford (2003), p. 275: the intercept map is affine, `T₀(Φ̂₀) = T₀(0) + DT₀ Φ̂₀`. -/
theorem interceptP_eq (α β κ σ φπ φx c : ℝ) (Φ0 : Fin 3 → ℝ) :
    interceptP α β κ σ φπ φx c Φ0 = interceptP α β κ σ φπ φx c 0 + aInt α β κ σ φπ φx *ᵥ Φ0 := by
  simp only [interceptP, aInt, Matrix.add_mulVec, Matrix.smul_mulVec, Matrix.mulVec_smul,
    smul_zero, Matrix.mulVec_zero]
  module

/-- Woodford (2003), p. 275: at `Ĉ = C` the slope part is affine in `Φ̂ₛ`,
`Mₛ(Φ̂ₛ, C) C = Mₛ(0, C) C + A₁ Φ̂ₛ (I − αβC)⁻¹C + A₂ Φ̂ₛ (I − βC)⁻¹C`. -/
theorem slopeP_mul_eq (α β κ σ φπ φx : ℝ) (gr gi : Fin n → ℝ) (Φs : Matrix (Fin 3) (Fin n) ℝ)
    (C : Matrix (Fin n) (Fin n) ℝ) :
    slopeP α β κ σ φπ φx gr gi Φs C * C = slopeP α β κ σ φπ φx gr gi 0 C * C +
      matS α β κ σ φπ φx * Φs * ((1 - (α * β) • C)⁻¹ * C) +
      matD β κ σ φπ φx * Φs * ((1 - β • C)⁻¹ * C) := by
  simp only [slopeP, Matrix.add_mul, Matrix.mul_zero, Matrix.zero_mul, Matrix.mul_assoc]
  abel

/-! ### Vectorised coordinates -/

/-- Woodford (2003), p. 274: the coordinates of a belief `(Φ̂, Ĉ)`: intercepts, `vec Φ̂ₛ`,
`vec Ĉ`. -/
abbrev IdxP (n : ℕ) : Type := (Fin 3 ⊕ (Fin n × Fin 3)) ⊕ (Fin n × Fin n)

/-- Woodford (2003), p. 274: the vectorised belief `(Φ̂₀, vec Φ̂ₛ, vec Ĉ)`. -/
def vecP (B : Learning.Regression.Belief (Fin 3) (Fin n) × Matrix (Fin n) (Fin n) ℝ) :
    IdxP n → ℝ :=
  Sum.elim (Learning.Regression.vecBelief B.1) (vec B.2)

/-- Woodford (2003), p. 274: the inverse of `vecP`. -/
def unvecP (v : IdxP n → ℝ) :
    Learning.Regression.Belief (Fin 3) (Fin n) × Matrix (Fin n) (Fin n) ℝ :=
  (Learning.Regression.unvecBelief (v ∘ Sum.inl), Matrix.of fun i j => v (Sum.inr (j, i)))

/-- Woodford (2003), p. 274: `vecP ∘ unvecP = id`. -/
theorem vecP_unvecP (v : IdxP n → ℝ) : vecP (unvecP v) = v := by
  funext x
  rcases x with (i | ⟨j, i⟩) | ⟨j, i⟩ <;> rfl

/-- Woodford (2003), p. 274: `unvecP ∘ vecP = id`. -/
theorem unvecP_vecP (B : Learning.Regression.Belief (Fin 3) (Fin n) × Matrix (Fin n) (Fin n) ℝ) :
    unvecP (vecP B) = B := rfl

/-- Woodford (2003), p. 274: the `T`-map of Proposition 4.10 in vectorised coordinates. -/
noncomputable def tVecP (α β κ σ φπ φx c : ℝ) (gr gi : Fin n → ℝ)
    (C : Matrix (Fin n) (Fin n) ℝ) (v : IdxP n → ℝ) : IdxP n → ℝ :=
  vecP (tMapP α β κ σ φπ φx c gr gi C (unvecP v))

/-- Woodford (2003), p. 275: "the part of the `T` mapping that determines `C` is a constant
function". -/
theorem tVecP_inr (α β κ σ φπ φx c : ℝ) (gr gi : Fin n → ℝ) (C : Matrix (Fin n) (Fin n) ℝ)
    (v : IdxP n → ℝ) : tVecP α β κ σ φπ φx c gr gi C v ∘ Sum.inr = vec C := rfl

/-- Woodford (2003), p. 275 (Preston (2005), App. 4): with beliefs about the states held at
the truth `Ĉ = C`, the belief part of the `T`-map is affine with matrix
`DT_Φ = blockdiag(DT₀, H)`. -/
theorem tVecP_inl_eq (α β κ σ φπ φx c : ℝ) (gr gi : Fin n → ℝ) (C : Matrix (Fin n) (Fin n) ℝ)
    (w : Fin 3 ⊕ (Fin n × Fin 3) → ℝ) :
    tVecP α β κ σ φπ φx c gr gi C (Sum.elim w (vec C)) ∘ Sum.inl =
      Learning.Regression.vecBelief (interceptP α β κ σ φπ φx c 0,
        slopeP α β κ σ φπ φx gr gi 0 C * C) + dTP α β κ σ φπ φx C *ᵥ w := by
  have hu : unvecP (Sum.elim w (vec C)) = (Learning.Regression.unvecBelief w, C) := rfl
  rw [dTP, fromBlocks_mulVec]
  funext x
  rcases x with i | ⟨j, i⟩
  · simp only [tVecP, hu, tMapP, vecP, Function.comp_apply, Sum.elim_inl,
      Learning.Regression.vecBelief, Pi.add_apply, Matrix.zero_mulVec, add_zero]
    rw [interceptP_eq]
    rfl
  · simp only [tVecP, hu, tMapP, vecP, Function.comp_apply, Sum.elim_inl, Sum.elim_inr,
      Learning.Regression.vecBelief, Pi.add_apply, Matrix.zero_mulVec, zero_add, hMat,
      Matrix.add_mulVec]
    have hw : w ∘ Sum.inr = vec (Learning.Regression.unvecBelief w).2 := by
      funext ⟨j', i'⟩; rfl
    rw [hw, KroneckerSpectrum.vec_mul_mul, KroneckerSpectrum.vec_mul_mul, slopeP_mul_eq]
    simp only [vec_add, Pi.add_apply]
    ring

/-! ### Entrywise differentiability -/

/-- Woodford (2003), p. 274: a matrix-valued map is differentiable entry by entry at `x`. -/
def DiffEnt {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {m p : Type*}
    (M : E → Matrix m p ℝ) (x : E) : Prop :=
  ∀ i j, DifferentiableAt ℝ (fun y => M y i j) x

namespace DiffEnt

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {x : E}

/-- Woodford (2003), p. 274: a constant matrix. -/
theorem const {m p : Type*} (A : Matrix m p ℝ) : DiffEnt (fun _ : E => A) x :=
  fun _ _ => differentiableAt_const _

/-- Woodford (2003), p. 274: sums. -/
theorem add {m p : Type*} {M N : E → Matrix m p ℝ} (hM : DiffEnt M x) (hN : DiffEnt N x) :
    DiffEnt (fun y => M y + N y) x :=
  fun i j => (hM i j).add (hN i j)

/-- Woodford (2003), p. 274: differences. -/
theorem sub {m p : Type*} {M N : E → Matrix m p ℝ} (hM : DiffEnt M x) (hN : DiffEnt N x) :
    DiffEnt (fun y => M y - N y) x :=
  fun i j => (hM i j).sub (hN i j)

/-- Woodford (2003), p. 274: scalar multiples. -/
theorem smul {m p : Type*} {M : E → Matrix m p ℝ} (a : ℝ) (hM : DiffEnt M x) :
    DiffEnt (fun y => a • M y) x :=
  fun i j => (hM i j).const_mul a

/-- Woodford (2003), p. 274: products. -/
theorem mul {l m p : Type*} [Fintype m] {M : E → Matrix l m ℝ} {N : E → Matrix m p ℝ}
    (hM : DiffEnt M x) (hN : DiffEnt N x) : DiffEnt (fun y => M y * N y) x := fun i j => by
  simp only [Matrix.mul_apply]
  exact DifferentiableAt.fun_sum fun k _ => (hM i k).mul (hN k j)

/-- Woodford (2003), p. 274: the determinant is differentiable (a polynomial in the entries). -/
theorem det {m : Type*} [Fintype m] [DecidableEq m] {M : E → Matrix m m ℝ}
    (hM : DiffEnt M x) : DifferentiableAt ℝ (fun y => (M y).det) x := by
  simp only [Matrix.det_apply']
  refine DifferentiableAt.fun_sum fun σ _ => (differentiableAt_const _).mul ?_
  exact (HasFDerivAt.finsetProd (u := Finset.univ) (g := fun i y => M y (σ i) i)
    fun i _ => (hM (σ i) i).hasFDerivAt).differentiableAt

/-- Woodford (2003), p. 274 (`(I − βĈ)⁻¹` near `Ĉ = C`): the inverse is differentiable where
the determinant does not vanish (Cramer's rule). -/
theorem inv {m : Type*} [Fintype m] [DecidableEq m] {M : E → Matrix m m ℝ}
    (hM : DiffEnt M x) (hdet : (M x).det ≠ 0) : DiffEnt (fun y => (M y)⁻¹) x := by
  intro i j
  simp only [Matrix.inv_def, Ring.inverse_eq_inv, Matrix.smul_apply, smul_eq_mul]
  refine ((det hM).inv hdet).mul ?_
  simp only [Matrix.adjugate_apply]
  refine det (M := fun y => (M y).updateRow j (Pi.single i 1)) fun r c => ?_
  by_cases h : r = j
  · subst h
    simp only [Matrix.updateRow_self]
    exact differentiableAt_const _
  · simp only [Matrix.updateRow_ne h]
    exact hM r c

end DiffEnt

/-- Woodford (2003), p. 274: the vectorised `T`-map is differentiable at every belief whose
`Ĉ` has `det(I − αβĈ) ≠ 0` and `det(I − βĈ) ≠ 0`. -/
theorem differentiableAt_tVecP (α β κ σ φπ φx c : ℝ) (gr gi : Fin n → ℝ)
    (C : Matrix (Fin n) (Fin n) ℝ) (v : IdxP n → ℝ)
    (h1 : (1 - (α * β) • (unvecP v).2).det ≠ 0) (h2 : (1 - β • (unvecP v).2).det ≠ 0) :
    DifferentiableAt ℝ (tVecP α β κ σ φπ φx c gr gi C) v := by
  have hco : ∀ x : IdxP n, DifferentiableAt ℝ (fun y : IdxP n → ℝ => y x) v :=
    fun x => (hasFDerivAt_apply x v).differentiableAt
  have hCh : DiffEnt (fun y : IdxP n → ℝ => (unvecP y).2) v := fun i j => hco _
  have hΦs : DiffEnt (fun y : IdxP n → ℝ => (unvecP y).1.2) v := fun i j => hco _
  have hI1 : DiffEnt (fun y : IdxP n → ℝ => (1 - (α * β) • (unvecP y).2)⁻¹) v :=
    DiffEnt.inv ((DiffEnt.const 1).sub (hCh.smul _)) h1
  have hI2 : DiffEnt (fun y : IdxP n → ℝ => (1 - β • (unvecP y).2)⁻¹) v :=
    DiffEnt.inv ((DiffEnt.const 1).sub (hCh.smul _)) h2
  have hslope : DiffEnt (fun y : IdxP n → ℝ =>
      slopeP α β κ σ φπ φx gr gi (unvecP y).1.2 (unvecP y).2 * C) v := by
    have e : ∀ y : IdxP n → ℝ, slopeP α β κ σ φπ φx gr gi (unvecP y).1.2 (unvecP y).2 * C =
        (matS α β κ σ φπ φx * (unvecP y).1.2 * (1 - (α * β) • (unvecP y).2)⁻¹ +
          matD β κ σ φπ φx * (unvecP y).1.2 * (1 - β • (unvecP y).2)⁻¹ +
          σ • (vecMulVec (colD σ κ φπ φx) gr * (1 - β • (unvecP y).2)⁻¹) +
          vecMulVec (eI - σ • colD σ κ φπ φx) gi) * C := by
      intro y
      rw [slopeP, Matrix.vecMulVec_mul]
    simp only [e]
    refine DiffEnt.mul ?_ (DiffEnt.const C)
    refine ((DiffEnt.add ?_ ?_).add ?_).add (DiffEnt.const _)
    · exact ((DiffEnt.const _).mul hΦs).mul hI1
    · exact ((DiffEnt.const _).mul hΦs).mul hI2
    · exact ((DiffEnt.const _).mul hI2).smul σ
  rw [differentiableAt_pi]
  rintro ((j | ⟨j, i⟩) | ⟨j, i⟩)
  · have e : (fun y : IdxP n → ℝ => tVecP α β κ σ φπ φx c gr gi C y (Sum.inl (Sum.inl j))) =
        fun y => interceptP α β κ σ φπ φx c 0 j +
          ∑ k, aInt α β κ σ φπ φx j k * y (Sum.inl (Sum.inl k)) := by
      funext y
      simp only [tVecP, tMapP, vecP, Sum.elim_inl, Learning.Regression.vecBelief]
      rw [interceptP_eq]
      rfl
    rw [e]
    exact (differentiableAt_const _).add
      (DifferentiableAt.fun_sum fun k _ => (differentiableAt_const _).mul (hco _))
  · exact hslope i j
  · exact differentiableAt_const _

/-! ### E-stability through the Jacobian: the constant `C`-block -/

/-- Woodford (2003), p. 275 ("the eigenvalues of `DT` consist of a set of zeros plus the
eigenvalues of `DT_Φ`"): the eigenvalues of `[[P, Q], [0, 0]]` are those of `P` and, when the
second block is present, `0`. -/
theorem isEig_fromBlocks_zero_iff {ι κ : Type*} [Fintype ι] [Fintype κ]
    (P : Matrix ι ι ℂ) (Q : Matrix ι κ ℂ) (μ : ℂ) :
    KroneckerSpectrum.IsEig (fromBlocks P Q 0 (0 : Matrix κ κ ℂ)) μ ↔
      KroneckerSpectrum.IsEig P μ ∨ (μ = 0 ∧ Nonempty κ) := by
  classical
  rw [KroneckerSpectrum.isEig_iff_det, KroneckerSpectrum.isEig_iff_det]
  have e : μ • (1 : Matrix (ι ⊕ κ) (ι ⊕ κ) ℂ) - fromBlocks P Q 0 0 =
      fromBlocks (μ • 1 - P) (-Q) 0 (μ • 1) := by
    rw [← fromBlocks_one, fromBlocks_smul, sub_eq_add_neg, fromBlocks_neg, fromBlocks_add]
    simp [sub_eq_add_neg]
  rw [e, det_fromBlocks_zero₂₁, det_smul, det_one, mul_one, mul_eq_zero]
  refine or_congr Iff.rfl ⟨fun h => ⟨eq_zero_of_pow_eq_zero h, ?_⟩, fun ⟨h, hne⟩ => ?_⟩
  · by_contra hk
    rw [not_nonempty_iff] at hk
    simp [Fintype.card_eq_zero] at h
  · rw [h]
    exact zero_pow Fintype.card_ne_zero

/-- Woodford (2003), p. 275: the zeros contributed by the constant `C`-block have real part less
than one, so `[[P, Q], [0, 0]]` is E-stable iff `P` is. -/
theorem eStable_fromBlocks_zero_iff {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ]
    [DecidableEq κ] (P : Matrix ι ι ℝ) (Q : Matrix ι κ ℝ) :
    EStable (fromBlocks P Q 0 (0 : Matrix κ κ ℝ)) ↔ EStable P := by
  rw [eStable_iff, eStable_iff]
  have hm : (fromBlocks P Q 0 (0 : Matrix κ κ ℝ)).map Complex.ofReal =
      fromBlocks (P.map Complex.ofReal) (Q.map Complex.ofReal) 0 0 := by
    rw [fromBlocks_map]
    simp
  simp only [hm, isEig_fromBlocks_zero_iff]
  constructor
  · intro h μ hμ
    exact h μ (Or.inl hμ)
  · rintro h μ (hμ | ⟨rfl, -⟩)
    · exact h μ hμ
    · simp

/-- Woodford (2003), p. 275: if the second block of a map `T` is constant and, with the second
block of the argument held at its value at `v`, the first block is affine with matrix `P`, then
the Jacobian of `T` at `v` is `[[P, Q], [0, 0]]`. -/
theorem toMatrix_fderiv_of_block {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ]
    [DecidableEq κ] (T : (ι ⊕ κ → ℝ) → (ι ⊕ κ → ℝ)) (v : ι ⊕ κ → ℝ) (c : κ → ℝ)
    (k0 : ι → ℝ) (P : Matrix ι ι ℝ) (hc : ∀ w, T w ∘ Sum.inr = c)
    (haff : ∀ w : ι → ℝ, T (Sum.elim w (v ∘ Sum.inr)) ∘ Sum.inl = k0 + P *ᵥ w)
    (hd : DifferentiableAt ℝ T v) :
    LinearMap.toMatrix' (fderiv ℝ T v : (ι ⊕ κ → ℝ) →ₗ[ℝ] (ι ⊕ κ → ℝ)) =
      fromBlocks P (Matrix.toBlocks₁₂
        (LinearMap.toMatrix' (fderiv ℝ T v : (ι ⊕ κ → ℝ) →ₗ[ℝ] (ι ⊕ κ → ℝ)))) 0 0 := by
  set L := fderiv ℝ T v with hLdef
  have hL : HasFDerivAt T L v := hd.hasFDerivAt
  have hrow : ∀ r h, L h (Sum.inr r) = 0 := by
    intro r h
    have h1 := hasFDerivAt_pi'.mp hL (Sum.inr r)
    have hconst : (fun x => T x (Sum.inr r)) = fun _ => c r :=
      funext fun x => congrFun (hc x) r
    rw [hconst] at h1
    have h2 := h1.unique (hasFDerivAt_const (c r) v)
    have := congrArg (fun f : (ι ⊕ κ → ℝ) →L[ℝ] ℝ => f h) h2
    simpa using this
  let Jl : (ι → ℝ) →ₗ[ℝ] (ι ⊕ κ → ℝ) :=
    { toFun := fun w => Sum.elim w (0 : κ → ℝ)
      map_add' := fun a b => by funext x; rcases x with i | r <;> simp
      map_smul' := fun a b => by funext x; rcases x with i | r <;> simp }
  let J : (ι → ℝ) →L[ℝ] (ι ⊕ κ → ℝ) := LinearMap.toContinuousLinearMap Jl
  have hJ : ∀ w, J w = Sum.elim w (0 : κ → ℝ) := fun w => rfl
  have hemb : HasFDerivAt (fun w : ι → ℝ => Sum.elim w (v ∘ Sum.inr)) J (v ∘ Sum.inl) := by
    have e : (fun w : ι → ℝ => Sum.elim w (v ∘ Sum.inr)) =
        fun w => J w + Sum.elim (0 : ι → ℝ) (v ∘ Sum.inr) := by
      funext w x
      rcases x with i | r <;> simp [hJ]
    rw [e]
    exact J.hasFDerivAt.add_const _
  have hL' : HasFDerivAt T L (Sum.elim (v ∘ Sum.inl) (v ∘ Sum.inr)) := by
    rwa [Sum.elim_comp_inl_inr]
  have hcomp := hL'.comp (v ∘ Sum.inl) hemb
  have hblock : ∀ i j, L (Pi.single (Sum.inl j) 1) (Sum.inl i) = P i j := by
    intro i j
    have h1 := hasFDerivAt_pi'.mp hcomp (Sum.inl i)
    have e : (fun w => (T ∘ fun w : ι → ℝ => Sum.elim w (v ∘ Sum.inr)) w (Sum.inl i)) =
        fun w => (k0 + P *ᵥ w) i := funext fun w => congrFun (haff w) i
    rw [e] at h1
    have h2 := hasFDerivAt_pi'.mp (Determinacy2Learning.hasFDerivAt_affine k0 P (v ∘ Sum.inl)) i
    have h3 := congrArg (fun f : (ι → ℝ) →L[ℝ] ℝ => f (Pi.single j 1)) (h1.unique h2)
    have hJs : J (Pi.single j 1) = Pi.single (Sum.inl j) 1 := by
      rw [hJ]
      funext x
      rcases x with i' | r
      · by_cases hij : i' = j
        · subst hij; simp
        · simp [hij]
      · simp
    simp only [ContinuousLinearMap.coe_comp, Function.comp_apply,
      ContinuousLinearMap.proj_apply, hJs, LinearMap.coe_toContinuousLinearMap'] at h3
    rw [h3, Matrix.toLin'_apply, Matrix.mulVec_single_one]
    rfl
  ext x y
  rcases x with i | r <;> rcases y with j | r'
  · rw [LinearMap.toMatrix'_apply, fromBlocks_apply₁₁]
    exact hblock i j
  · rfl
  · rw [LinearMap.toMatrix'_apply, fromBlocks_apply₂₁]
    exact hrow r _
  · rw [LinearMap.toMatrix'_apply, fromBlocks_apply₂₂]
    exact hrow r _

/-- Woodford (2003), p. 275: for such a block map, a fixed point is E-stable (Jacobian
definition `EStableAt`) iff `P` is E-stable. -/
theorem eStableAt_iff_of_block {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ]
    [DecidableEq κ] (T : (ι ⊕ κ → ℝ) → (ι ⊕ κ → ℝ)) (v : ι ⊕ κ → ℝ) (c : κ → ℝ)
    (k0 : ι → ℝ) (P : Matrix ι ι ℝ) (hc : ∀ w, T w ∘ Sum.inr = c)
    (haff : ∀ w : ι → ℝ, T (Sum.elim w (v ∘ Sum.inr)) ∘ Sum.inl = k0 + P *ᵥ w)
    (hfix : T v = v) (hd : DifferentiableAt ℝ T v) :
    EStableAt T v ↔ EStable P := by
  unfold EStableAt
  rw [toMatrix_fderiv_of_block T v c k0 P hc haff hd, eStable_fromBlocks_zero_iff]
  exact ⟨fun h => h.2.2, fun h => ⟨hfix, hd, h⟩⟩

/-- Woodford (2003), p. 275: at a fixed point the belief about the states is the truth,
`Ĉ = C`. -/
theorem unvecP_snd_of_fixed {α β κ σ φπ φx c : ℝ} {gr gi : Fin n → ℝ}
    {C : Matrix (Fin n) (Fin n) ℝ} {v : IdxP n → ℝ}
    (hfix : tVecP α β κ σ φπ φx c gr gi C v = v) : v ∘ Sum.inr = vec C ∧ (unvecP v).2 = C := by
  have h : v ∘ Sum.inr = vec C := by
    rw [← hfix]
    rfl
  refine ⟨h, ?_⟩
  ext i j
  exact congrFun h (j, i)

/-- Woodford (2003), p. 275: **E-stability of the r.e.e. `(Φ̄, C)` is decided by `DT_Φ`**: at a
fixed point of the `T`-map (with `det(I − αβC) ≠ 0`, `det(I − βC) ≠ 0`), E-stability in the
sense of `EStableAt` (all eigenvalues of `DT − I` with negative real part) holds iff
`DT_Φ = blockdiag(DT₀, H)` is E-stable. -/
theorem eStableAt_tVecP_iff {α β κ σ φπ φx c : ℝ} {gr gi : Fin n → ℝ}
    {C : Matrix (Fin n) (Fin n) ℝ} {v : IdxP n → ℝ}
    (hfix : tVecP α β κ σ φπ φx c gr gi C v = v) (h1 : (1 - (α * β) • C).det ≠ 0)
    (h2 : (1 - β • C).det ≠ 0) :
    EStableAt (tVecP α β κ σ φπ φx c gr gi C) v ↔ EStable (dTP α β κ σ φπ φx C) := by
  obtain ⟨hinr, hC⟩ := unvecP_snd_of_fixed hfix
  refine eStableAt_iff_of_block _ v (vec C)
    (Learning.Regression.vecBelief (interceptP α β κ σ φπ φx c 0,
      slopeP α β κ σ φπ φx gr gi 0 C * C)) (dTP α β κ σ φπ φx C)
    (tVecP_inr α β κ σ φπ φx c gr gi C) (fun w => ?_) hfix ?_
  · rw [hinr]
    exact tVecP_inl_eq α β κ σ φπ φx c gr gi C w
  · exact differentiableAt_tVecP α β κ σ φπ φx c gr gi C v (by rwa [hC]) (by rwa [hC])

/-- Woodford (2003), p. 275 (necessity, no assumption on `C`): E-stability of a fixed point
implies E-stability of `DT_Φ`. -/
theorem eStable_dTP_of_eStableAt {α β κ σ φπ φx c : ℝ} {gr gi : Fin n → ℝ}
    {C : Matrix (Fin n) (Fin n) ℝ} {v : IdxP n → ℝ}
    (h : EStableAt (tVecP α β κ σ φπ φx c gr gi C) v) : EStable (dTP α β κ σ φπ φx C) := by
  have hfix := h.1
  obtain ⟨hinr, -⟩ := unvecP_snd_of_fixed hfix
  refine (eStableAt_iff_of_block _ v (vec C)
    (Learning.Regression.vecBelief (interceptP α β κ σ φπ φx c 0,
      slopeP α β κ σ φπ φx gr gi 0 C * C)) (dTP α β κ σ φπ φx C)
    (tVecP_inr α β κ σ φπ φx c gr gi C) (fun w => ?_) hfix h.2.1).mp h
  rw [hinr]
  exact tVecP_inl_eq α β κ σ φπ φx c gr gi C w

end Woodford.NeoWicksellianFramework.PrestonLearning
