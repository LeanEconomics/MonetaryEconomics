  set π : ℕ → Ω → ℝ := fun t => z t 0 + fun _ => πbar with hπdef
  set x : ℕ → Ω → ℝ := fun t => z t 1 + fun _ => xbarG β κ γ πbar with hxdef
  set i : ℕ → Ω → ℝ := fun t => ibar t + φπ • (π t - fun _ => πbar) +
