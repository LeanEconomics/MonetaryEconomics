      _ ≤ 2 * β * κ * σ * K1 := mul_le_mul_of_nonneg_left hlx (by positivity)
  obtain ⟨M, hM⟩ : ∃ M, M = resM (inertP κ) (predN β σ) (a25 σ) (inertPhi φπ φx)
