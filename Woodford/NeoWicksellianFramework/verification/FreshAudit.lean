      linarith
    linarith
  have hlx : l * ((1 - β) * φx / 4) ≤ K1 := by
    have : l * ((1 - β) * φx / 4) ≤ l * Φ := by
      apply mul_le_mul_of_nonneg_left _ hl0
      rw [hΦ]; have : 0 ≤ κ * φπ := by positivity
