  have hxa : 𝔼.Adapted x := fun t => by simp [hxdef, map_add, hza t 1, 𝔼.const]
  have heq := (inertia_iff_predSys 𝔼 (σ := σ) (rn := rn) hκ (p0 := p0) hπa hrule).mpr
