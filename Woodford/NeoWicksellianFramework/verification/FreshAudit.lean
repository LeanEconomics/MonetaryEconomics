(`L(μᵗ) = μᵗ H(μ)`). -/
theorem inertiaRec_pow (β σ κ γ φπ φx μ : ℝ) (t : ℕ) :
    inertiaRec β σ κ γ φπ φx (fun n => μ ^ n) t = μ ^ t * inertiaCubic β σ κ γ φπ φx μ := by
  unfold inertiaRec inertiaCubic
  simp only [pow_add]
  ring

