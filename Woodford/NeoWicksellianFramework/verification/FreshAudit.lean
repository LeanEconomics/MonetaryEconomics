      (predN β σ))) (det2 (solveMN (resM (inertiaP β σ κ γ φπ φx) (predN β σ) 0 inertiaPhi ω)
        (predN β σ))))
    {rn ibar : ℕ → Ω → ℝ} {Mg : ℝ} (hg : ∀ t ω, |gapForcing πbar rn ibar t ω| ≤ Mg)
