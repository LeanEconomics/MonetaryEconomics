  have hs0 : 𝔼.E 0 (p0 - fun _ => πbar) = p0 - fun _ => πbar := by
    rw [map_sub, hp0, 𝔼.const]
  have hs0b : ∀ x, |(p0 - fun _ => πbar : Ω → ℝ) x| ≤ B + |πbar| := fun x =>
