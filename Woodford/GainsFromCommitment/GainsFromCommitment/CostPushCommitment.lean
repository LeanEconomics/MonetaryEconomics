/-!
# Optimal commitment with cost-push shocks

Woodford (2003), *Interest and Prices*, Chapter 7, §2.1, pp. 488–492, and Appendix F.1,
pp. 709–710 (with (F.8), p. 712).

The economy is the aggregate-supply relation (2.1) `π_t = κ x_t + β E_t π_{t+1} + u_t` with a
bounded adapted cost-push shock `u`. The objective is the expected discounted loss (1.2) from a
planning date `t₀`. The constraint (2.9) and the solution (2.10) use forecasts `E_{t₀−k} u` for
every `k ≥ 1`. Dates therefore run over `ℤ`, with an integer-dated expectation system
`ExpSysZ` (the axioms of the core `ExpectationSystem`). `ExpSysZ.toNat` re-indexes from any base
date, so all of the core's forward-solution theorems apply. `ExpSysZ.ofNat` extends any
`ExpectationSystem` (perfect foresight, finite event trees) to `ℤ`.

## Main results

* `ExpSysZ.lie_identity`: the identity under (2.4),
  `E_{t₀}[φ_t E_t π_{t+1}] = E_{t₀}[φ_t π_{t+1}]` (pull-out, then tower).
* `lagrangian_eq_half_loss`: on feasible plans the Lagrangian (2.4) is half the loss.
* `loss_gap`, `loss_le`, `isOptimal_of_foc`, `optimal_unique_ae`, `optimal_unique`:
  **Lagrangian sufficiency** under uncertainty. A feasible plan satisfying (1.7)–(1.8) with a
  bounded adapted multiplier minimises the expected discounted loss, state by state at `t₀`,
  among all bounded feasible plans with the same initial constraint. The loss gap is exactly
  `E_{t₀} ∑ βᵏ[(Δπ)² + λ(Δx)²]`, so the optimum is unique (almost surely, and exactly when
  `E_t` is faithful). The pull-out and faithfulness hypotheses hold for perfect foresight and
  for every finite event tree (`ofNat_finiteTree_pullOut`, `ofNat_finiteTree_faithful`).
* The roots `0 < μ₁ < 1 < μ₂` of (1.11) are the shared `SecondOrderRE.mu1`,
  `SecondOrderRE.mu2` (`m1`, `m2`, `m_facts` specialise them to `c = κ²/λ`).
  `const_identity`: `β⁻¹ κ x*/(μ₂ − 1) = (1 − μ₁)(λ/κ) x*`.
* `as_iff_multEq`: (1.7), (1.8) and (2.1) give (2.6). `workhorse_iff` and `multEq_iff_rec27`:
  (2.6) ⇔ (2.7) for bounded adapted multipliers (the second-order workhorse, survey §4.3).
* `plan_feasible`, `plan_isOptimal`, `plan_t0_optimal`, `plan_unique`, `plan_timeless`: the
  plan generated by (2.7) from any initial multiplier is feasible and optimal. With (2.5) it is
  the `t₀`-optimal plan. `t0_optimal_noshock` is the stochastic generalisation of (1.13).
  `constrained_optimum`: for every constraint value `π̄_{t₀}` the optimum exists (initial
  multiplier from (F.2)).
* **Proposition 7.6** (`prop_7_6`, `prop_7_6_unique`, `prop_7_6_timeless`, with `F3`, `F4`,
  `infl210_eq_planInfl`): (2.10) is the constrained-optimal inflation path under (2.8)–(2.9).
* p. 490: `limit_indep_initial` (the `t₀ → −∞` limit is (2.10) whatever `φ_{t₀−1}`) and
  `selfConsistent_iff` ((2.9) is the only bounded self-consistent specification depending only
  on exogenous states).
* **Proposition 7.7** (`prop_7_7`, `prop_7_7_optimal`, `prop_7_7_unique`) and
  `rule_212_timeless` (any rule delivering (2.12) is timelessly optimal).
* **Proposition 7.8** (`constraint_213_iff_214`, `prop_7_8_optimal`, `F8`,
  `prop_7_8_invariant`, `prop_7_8`, `prop_7_8_selfConsistent`, `prop_7_8_timeless`) and `p492`.

## Notes on the printed text

* (2.4) omits `−u_t` in the constraint term. With it the term is exactly (2.1) (`lagrangian`).
* (2.15) prints `p̄_t` on the left. The statement is about the equilibrium price level `p_t`,
  which equals the value `p̄_t` of the constraint (2.14) at date `t` (`prop_7_8`,
  `prop_7_8_selfConsistent`).
-/

namespace Woodford.GainsFromCommitment.CostPushCommitment

open Filter Topology
open Sequences (summable_disc tsum_telescope)
open SecondOrderRE (mu1 mu2 mu1_pos mu1_lt_one one_lt_mu2 beta_mul_sum beta_mul_mu1_mul_mu2
  mu_key)

variable (Ω : Type*)

/-- Woodford (2003), §2.1, pp. 488–490 and App. F.1, p. 709: a family of conditional
expectations `E_t` indexed by **all integer dates** `t : ℤ`. The constraint (2.9) and the
solution (2.10) use the forecasts `E_{t₀−k} u` for every `k ≥ 1`, so the whole history before
the planning date `t₀` must exist. The axioms are those of `ExpectationSystem`: linearity,
constants, monotonicity and the law of iterated expectations in both orders. -/
structure ExpSysZ where
  /-- The expectation conditional on date-`t` information. -/
  E : ℤ → (Ω → ℝ) →ₗ[ℝ] (Ω → ℝ)
  /-- Constants are known at every date. -/
  const : ∀ t (c : ℝ), E t (fun _ => c) = fun _ => c
  /-- Expectations preserve the pointwise order. -/
  mono : ∀ t {x y : Ω → ℝ}, x ≤ y → E t x ≤ E t y
  /-- The law of iterated expectations: `E_s E_t = E_s` for `s ≤ t`. -/
  tower : ∀ {s t : ℤ}, s ≤ t → ∀ x, E s (E t x) = E s x
  /-- Earlier information is known later: `E_t E_s = E_s` for `s ≤ t`. -/
  known : ∀ {s t : ℤ}, s ≤ t → ∀ x, E t (E s x) = E s x

variable {Ω}

namespace ExpSysZ

variable (𝔽 : ExpSysZ Ω)

/-- Woodford (2003), App. F.1, p. 709: the dates from `T` onward of an integer-dated system,
re-indexed by `ℕ` (`E'_n = E_{T+n}`), form an `ExpectationSystem`, so every forward-solution
result of the shared core applies from any base date `T`. -/
def toNat (T : ℤ) : ExpectationSystem Ω where
  E n := 𝔽.E (T + n)
  const _ c := 𝔽.const _ c
  mono _ _ _ h := 𝔽.mono _ h
  tower h x := 𝔽.tower (by omega) x
  known h x := 𝔽.known (by omega) x

/-- Woodford (2003), p. 488: an `ExpectationSystem` on `ℕ` extends to all integer dates by
giving every date `t ≤ 0` the date-0 information. This shows that integer-dated systems with
genuine uncertainty exist (finite event trees, `ofNat_finiteTree_pullOut`). -/
def ofNat (𝔼 : ExpectationSystem Ω) : ExpSysZ Ω where
  E t := 𝔼.E t.toNat
  const _ c := 𝔼.const _ c
  mono _ _ _ h := 𝔼.mono _ h
  tower h x := 𝔼.tower (Int.toNat_le_toNat h) x
  known h x := 𝔼.known (Int.toNat_le_toNat h) x

/-- Woodford (2003), App. F.1: `E'_n = E_{T+n}` for the re-indexed system. -/
theorem toNat_E (T : ℤ) (n : ℕ) : (𝔽.toNat T).E n = 𝔽.E (T + n) := rfl

/-- Woodford (2003), App. F.1: `E_t` is the date-0 expectation of the system re-indexed
from `t`. -/
theorem E_eq_toNat (t : ℤ) : 𝔽.E t = (𝔽.toNat t).E 0 := by
  rw [toNat_E, Nat.cast_zero, add_zero]

/-- Woodford (2003), p. 488: `E_t` is bounded by the bound of its argument. -/
theorem abs_E_le {M : ℝ} {x : Ω → ℝ} (hx : ∀ ω, |x ω| ≤ M) (t : ℤ) (ω : Ω) :
    |𝔽.E t x ω| ≤ M := by
  rw [E_eq_toNat]
  exact (𝔽.toNat t).abs_E_le hx 0 ω

/-- Woodford (2003), p. 488: a variable known at date `s` is known at every later date. -/
theorem E_of_known {s t : ℤ} (hst : s ≤ t) {x : Ω → ℝ} (hx : 𝔽.E s x = x) : 𝔽.E t x = x := by
  rw [← hx, 𝔽.known hst]

/-- Woodford (2003), p. 488: conditional expectations of nonnegative variables are
nonnegative. -/
theorem E_nonneg {y : Ω → ℝ} (hy : 0 ≤ y) (t : ℤ) : 0 ≤ 𝔽.E t y := by
  have h := 𝔽.mono t hy
  rwa [map_zero] at h

/-- Woodford (2003), (2.4), p. 488: `E_t` commutes with a discounted sum `∑ βᵏ f_k` of
uniformly bounded random variables (`0 ≤ β < 1`). -/
theorem E_tsum_geom {β B : ℝ} (hβ0 : 0 ≤ β) (hβ1 : β < 1) {f : ℕ → Ω → ℝ}
    (hf : ∀ k ω, |f k ω| ≤ B) (t : ℤ) (ω : Ω) :
    𝔽.E t (fun ω' => ∑' k, β ^ k * f k ω') ω = ∑' k, β ^ k * 𝔽.E t (f k) ω := by
  have hb : ∀ k ω', |(β ^ k • f k) ω'| ≤ β ^ k * B := by
    intro k ω'
    rw [Pi.smul_apply, smul_eq_mul, abs_mul, abs_pow, abs_of_nonneg hβ0]
    exact mul_le_mul_of_nonneg_left (hf k ω') (pow_nonneg hβ0 k)
  have h := (𝔽.toNat t).E_tsum hβ0 hβ1 hb 0 ω
  rw [← E_eq_toNat] at h
  simp only [Pi.smul_apply, smul_eq_mul, map_smul] at h
  exact h

/-- Woodford (2003), p. 488 (the step `E_{t₀}[φ_t E_t π_{t+1}] = E_{t₀}[E_t(φ_t π_{t+1})]`): the
pull-out property `E_t(a y) = a E_t y` for `a` known at `t`. It holds for true conditional
expectations but does not follow from the axioms, so results that use it take it as a
hypothesis. -/
def PullOut : Prop := ∀ t (a y : Ω → ℝ), 𝔽.E t a = a → 𝔽.E t (a * y) = a * 𝔽.E t y

/-- Woodford (2003), p. 490 (uniqueness of the constrained optimum): `E_t` is faithful when a
nonnegative variable with zero conditional expectation is zero (no null states). Without it,
optimal plans are unique only up to `E_{t₀}`-null events (`optimal_unique_ae`). -/
def Faithful : Prop := ∀ t (y : Ω → ℝ), 0 ≤ y → 𝔽.E t y = 0 → y = 0

/-- Woodford (2003), p. 488: the extension of a system with the pull-out property has it. -/
theorem ofNat_pullOut {𝔼 : ExpectationSystem Ω} (h : 𝔼.PullOut) : (ofNat 𝔼).PullOut :=
  fun t a y ha => h t.toNat a y ha

/-- Woodford (2003), p. 488: every finite event tree, extended to integer dates, has the
pull-out property (a genuine-uncertainty instance). -/
theorem ofNat_finiteTree_pullOut {Ω' : Type*} [Fintype Ω']
    (T : ExpectationsFiniteTree.FiniteTree Ω') : (ofNat T.toExpectationSystem).PullOut :=
  ofNat_pullOut (ExpectationsFiniteTree.finiteTree_pullOut T)

/-- Woodford (2003), p. 488: perfect foresight extended to integer dates has the pull-out
property. -/
theorem ofNat_perfectForesight_pullOut : (ofNat perfectForesight).PullOut :=
  ofNat_pullOut perfectForesight_pullOut

/-- Woodford (2003), p. 490: perfect foresight is faithful. -/
theorem ofNat_perfectForesight_faithful : (ofNat perfectForesight).Faithful :=
  fun _ _ _ h => h

/-- Woodford (2003), p. 490: every finite event tree (strictly positive state probabilities),
extended to integer dates, is faithful, so the uniqueness results hold under genuine
uncertainty. -/
theorem ofNat_finiteTree_faithful {Ω' : Type*} [Fintype Ω']
    (T : ExpectationsFiniteTree.FiniteTree Ω') : (ofNat T.toExpectationSystem).Faithful := by
  classical
  intro t y hy h
  funext ω
  have h1 := congrFun h ω
  change T.condE t.toNat y ω = 0 at h1
  rw [ExpectationsFiniteTree.FiniteTree.condE, div_eq_zero_iff] at h1
  rcases h1 with h1 | h1
  · unfold ExpectationsFiniteTree.FiniteTree.num at h1
    have hnn : ∀ ω' ∈ Finset.univ, (0 : ℝ) ≤
        (if T.info t.toNat ω' ω then T.prob ω' * y ω' else 0) := fun ω' _ => by
      split_ifs
      · exact mul_nonneg (T.prob_pos ω').le (hy ω')
      · exact le_rfl
    have h2 := (Finset.sum_eq_zero_iff_of_nonneg hnn).mp h1 ω (Finset.mem_univ ω)
    simp only [(T.info t.toNat).refl ω, ↓reduceIte] at h2
    rcases mul_eq_zero.mp h2 with h3 | h3
    · exact absurd h3 (T.prob_pos ω).ne'
    · exact h3
  · exact absurd h1 (T.mass_pos _ ω).ne'

/-- Woodford (2003), p. 488, the identity below (2.4):
`E_{t₀}[φ_t E_t y] = E_{t₀}[E_t(φ_t y)] = E_{t₀}[φ_t y]` for `t ≥ t₀` and `φ_t` known at `t`
(pull-out, then the law of iterated expectations). -/
theorem lie_identity (hPO : 𝔽.PullOut) {t0 t : ℤ} (h : t0 ≤ t) {φ y : Ω → ℝ}
    (hφ : 𝔽.E t φ = φ) : 𝔽.E t0 (φ * 𝔽.E t y) = 𝔽.E t0 (φ * y) := by
  rw [← hPO t φ y hφ, 𝔽.tower h]

end ExpSysZ

/-! ### The roots of the characteristic equation (1.11)

The series tools (`summable_disc`, `tsum_telescope`) are the shared `Sequences` lemmas and the
root facts `0 < μ₁ < 1 < μ₂`, `β(μ₁ + μ₂) = 1 + β + c`, `βμ₁μ₂ = 1`, `β(1 − μ₁)(μ₂ − 1) = c`
are the shared `SecondOrderRE` lemmas. -/

/-- Woodford (2003), eq. (2.7), p. 489: the constant identity
`β⁻¹ κ x*/(μ₂ − 1) = (1 − μ₁)(λ/κ) x*` with `c = κ²/λ`. -/
theorem const_identity {β κ lam xs : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam) :
    β⁻¹ * (κ * xs) / (mu2 β (κ ^ 2 / lam) - 1) =
      (1 - mu1 β (κ ^ 2 / lam)) * (lam / κ) * xs := by
  have hc : 0 < κ ^ 2 / lam := by positivity
  have hkey := mu_key hβ hc
  have h2 : mu2 β (κ ^ 2 / lam) - 1 ≠ 0 := by linarith [one_lt_mu2 hβ hc]
  rw [div_eq_iff h2]
  set m1 := mu1 β (κ ^ 2 / lam)
  set m2 := mu2 β (κ ^ 2 / lam)
  have h : (1 - m1) * (lam / κ) * xs * (m2 - 1) = β * (1 - m1) * (m2 - 1) * (lam / κ) * xs / β := by
    field_simp
  rw [h, hkey]
  field_simp


/-! ### Bounds -/

/-- Woodford (2003), App. F.1 (bookkeeping for bounded plans): `|a²| ≤ A²` when `|a| ≤ A`. -/
theorem abs_sq_le {a A : ℝ} (h : |a| ≤ A) : |a ^ 2| ≤ A ^ 2 := by
  rw [abs_pow]
  exact pow_le_pow_left₀ (abs_nonneg a) h 2

/-- Woodford (2003), App. F.1 (bookkeeping for bounded plans): `|ab| ≤ AB`. -/
theorem abs_mul_le_of {a b A B : ℝ} (ha : |a| ≤ A) (hb : |b| ≤ B) : |a * b| ≤ A * B := by
  rw [abs_mul]
  exact mul_le_mul ha hb (abs_nonneg _) ((abs_nonneg _).trans ha)

/-- Woodford (2003), App. F.1 (bookkeeping for bounded plans): `|a − b| ≤ A + B`. -/
theorem abs_sub_le_of {a b A B : ℝ} (ha : |a| ≤ A) (hb : |b| ≤ B) : |a - b| ≤ A + B :=
  (abs_sub _ _).trans (add_le_add ha hb)

/-- Woodford (2003), App. F.1 (bookkeeping for bounded plans): `|a + b| ≤ A + B`. -/
theorem abs_add_le_of {a b A B : ℝ} (ha : |a| ≤ A) (hb : |b| ≤ B) : |a + b| ≤ A + B :=
  (abs_add_le _ _).trans (add_le_add ha hb)

/-! ### The commitment problem from date `t₀` -/

variable (𝔽 : ExpSysZ Ω)

/-- Woodford (2003), eq. (2.1), p. 486: the aggregate-supply relation with cost-push shock,
`π_t = κ x_t + β E_t π_{t+1} + u_t`, at date `t`. -/
def AS (β κ : ℝ) (u π x : ℤ → Ω → ℝ) (t : ℤ) : Prop :=
  π t = κ • x t + β • 𝔽.E t (π (t + 1)) + u t

/-- Woodford (2003), p. 488: a plan `(π, x)` from date `t₀` is **feasible** (a possible
rational-expectations equilibrium from `t₀` on) when it satisfies (2.1) at every `t ≥ t₀`, is
adapted and is bounded from `t₀` on. Values before `t₀` are the given history. -/
def Feasible (β κ : ℝ) (u : ℤ → Ω → ℝ) (t0 : ℤ) (π x : ℤ → Ω → ℝ) : Prop :=
  (∀ t, t0 ≤ t → AS 𝔽 β κ u π x t) ∧
    (∀ t, t0 ≤ t → 𝔽.E t (π t) = π t ∧ 𝔽.E t (x t) = x t) ∧
    ∃ M, ∀ t, t0 ≤ t → ∀ ω, |π t ω| ≤ M ∧ |x t ω| ≤ M

/-- Woodford (2003), eq. (1.2), p. 469, and p. 488: the expected discounted loss from `t₀`,
`E_{t₀} ∑_{k ≥ 0} βᵏ [π_{t₀+k}² + λ (x_{t₀+k} − x*)²]`, a random variable (conditioning on the
state at `t₀`). -/
noncomputable def loss (β lam xs : ℝ) (t0 : ℤ) (π x : ℤ → Ω → ℝ) : Ω → ℝ :=
  𝔽.E t0 (fun ω => ∑' k : ℕ, β ^ k * (π (t0 + k) ω ^ 2 + lam * (x (t0 + k) ω - xs) ^ 2))

/-- Woodford (2003), pp. 488–490: `(π, x)` is **optimal from `t₀`** subject to the extra
restriction `C` on the inflation path (no restriction for the `t₀`-optimal plan, the initial
constraint (2.8) `π_{t₀} = π̄_{t₀}` for the timeless problem). It is feasible, satisfies `C`,
and its expected loss is at most that of every other feasible plan satisfying `C`, in every
state at `t₀`. -/
def IsOptimal (β κ lam xs : ℝ) (u : ℤ → Ω → ℝ) (t0 : ℤ) (C : (ℤ → Ω → ℝ) → Prop)
    (π x : ℤ → Ω → ℝ) : Prop :=
  Feasible 𝔽 β κ u t0 π x ∧ C π ∧
    ∀ π' x', Feasible 𝔽 β κ u t0 π' x' → C π' →
      loss 𝔽 β lam xs t0 π x ≤ loss 𝔽 β lam xs t0 π' x'

/-- Woodford (2003), eqs. (1.7)–(1.8), p. 472, used for every `t ≥ t₀` on p. 488: the
first-order conditions `π_t + φ_t − φ_{t−1} = 0` and `λ (x_t − x*) − κ φ_t = 0`. -/
def FOC (κ lam xs : ℝ) (t0 : ℤ) (π x φ : ℤ → Ω → ℝ) : Prop :=
  ∀ t, t0 ≤ t → ∀ ω, π t ω + φ t ω - φ (t - 1) ω = 0 ∧ lam * (x t ω - xs) - κ * φ t ω = 0

/-- Woodford (2003), p. 488 and App. F.1 (**Lagrangian sufficiency**, survey §4.4): if a
feasible plan `(π, x)` satisfies the first-order conditions (1.7)–(1.8) with a bounded adapted
multiplier process `φ`, then for every other feasible plan `(π', x')` with
`φ_{t₀−1}(π'_{t₀} − π_{t₀}) = 0` the loss difference is exactly the expected discounted sum of
squared deviations, `E_{t₀} ∑ βᵏ [(π' − π)² + λ (x' − x)²]`. The linear terms cancel because
(2.1) is linear: by the identity under (2.4) they telescope to `φ_{t₀−1}(π'_{t₀} − π_{t₀})`. -/
theorem loss_gap (hPO : 𝔽.PullOut) {β κ lam xs : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1)
    {u π x π' x' φ : ℤ → Ω → ℝ} {t0 : ℤ}
    (hf : Feasible 𝔽 β κ u t0 π x) (hf' : Feasible 𝔽 β κ u t0 π' x')
    (hφa : ∀ t, t0 ≤ t → 𝔽.E t (φ t) = φ t)
    (hφb : ∃ M, ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ M)
    (hfoc : FOC κ lam xs t0 π x φ)
    (hinit : ∀ ω, φ (t0 - 1) ω * (π' t0 ω - π t0 ω) = 0) :
    loss 𝔽 β lam xs t0 π' x' = loss 𝔽 β lam xs t0 π x +
      𝔽.E t0 (fun ω => ∑' k : ℕ, β ^ k * ((π' (t0 + k) ω - π (t0 + k) ω) ^ 2 +
        lam * (x' (t0 + k) ω - x (t0 + k) ω) ^ 2)) := by
  obtain ⟨hAS, -, M, hM⟩ := hf
  obtain ⟨hAS', -, M', hM'⟩ := hf'
  obtain ⟨Mφ, hMφ⟩ := hφb
  have hβ0' := hβ0.le
  have hle : ∀ k : ℕ, t0 ≤ t0 + k := fun k => by omega
  have bπ : ∀ k : ℕ, ∀ ω, |π (t0 + k) ω| ≤ M := fun k ω => (hM _ (hle k) ω).1
  have bx : ∀ k : ℕ, ∀ ω, |x (t0 + k) ω| ≤ M := fun k ω => (hM _ (hle k) ω).2
  have bπ' : ∀ k : ℕ, ∀ ω, |π' (t0 + k) ω| ≤ M' := fun k ω => (hM' _ (hle k) ω).1
  have bx' : ∀ k : ℕ, ∀ ω, |x' (t0 + k) ω| ≤ M' := fun k ω => (hM' _ (hle k) ω).2
  set ℓ : ℕ → Ω → ℝ := fun k ω => π (t0 + k) ω ^ 2 + lam * (x (t0 + k) ω - xs) ^ 2 with hℓ
  set q : ℕ → Ω → ℝ := fun k ω => (π' (t0 + k) ω - π (t0 + k) ω) ^ 2 +
    lam * (x' (t0 + k) ω - x (t0 + k) ω) ^ 2 with hq
  set lin : ℕ → Ω → ℝ := fun k ω => π (t0 + k) ω * (π' (t0 + k) ω - π (t0 + k) ω) +
    lam * (x (t0 + k) ω - xs) * (x' (t0 + k) ω - x (t0 + k) ω) with hlin
  have bℓ : ∀ k ω, |ℓ k ω| ≤ M ^ 2 + |lam| * (M + |xs|) ^ 2 := fun k ω =>
    abs_add_le_of (abs_sq_le (bπ k ω))
      (abs_mul_le_of le_rfl (abs_sq_le (abs_sub_le_of (bx k ω) le_rfl)))
  have bq : ∀ k ω, |q k ω| ≤ (M' + M) ^ 2 + |lam| * (M' + M) ^ 2 := fun k ω =>
    abs_add_le_of (abs_sq_le (abs_sub_le_of (bπ' k ω) (bπ k ω)))
      (abs_mul_le_of le_rfl (abs_sq_le (abs_sub_le_of (bx' k ω) (bx k ω))))
  have blin : ∀ k ω, |lin k ω| ≤ M * (M' + M) + |lam| * (M + |xs|) * (M' + M) := fun k ω =>
    abs_add_le_of (abs_mul_le_of (bπ k ω) (abs_sub_le_of (bπ' k ω) (bπ k ω)))
      (abs_mul_le_of (abs_mul_le_of le_rfl (abs_sub_le_of (bx k ω) le_rfl))
        (abs_sub_le_of (bx' k ω) (bx k ω)))
  -- the integrand of the new plan splits into three discounted sums
  have hsplit : (fun ω => ∑' k : ℕ, β ^ k * (π' (t0 + k) ω ^ 2 + lam * (x' (t0 + k) ω - xs) ^ 2))
      = (fun ω => ∑' k : ℕ, β ^ k * ℓ k ω) + (fun ω => ∑' k : ℕ, β ^ k * q k ω) +
        (2 : ℝ) • (fun ω => ∑' k : ℕ, β ^ k * lin k ω) := by
    funext ω
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    rw [← (summable_disc hβ0' hβ1 (fun k => bℓ k ω)).tsum_add
      (summable_disc hβ0' hβ1 (fun k => bq k ω)), ← tsum_mul_left,
      ← ((summable_disc hβ0' hβ1 (fun k => bℓ k ω)).add
      (summable_disc hβ0' hβ1 (fun k => bq k ω))).tsum_add
      ((summable_disc hβ0' hβ1 (fun k => blin k ω)).mul_left 2)]
    refine tsum_congr fun k => ?_
    simp only [hℓ, hq, hlin]
    ring
  -- the multiplier terms
  set g : ℕ → Ω → ℝ := fun k => 𝔽.E t0 (fun ω => φ (t0 + k - 1) ω *
    (π' (t0 + k) ω - π (t0 + k) ω)) with hg
  have bg : ∀ k ω, |g k ω| ≤ Mφ * (M' + M) := by
    intro k ω
    refine 𝔽.abs_E_le (fun ω' => abs_mul_le_of (hMφ _ (by omega) ω')
      (abs_sub_le_of (bπ' k ω') (bπ k ω'))) t0 ω
  have hElin : ∀ k : ℕ, 𝔽.E t0 (lin k) = g k - β • g (k + 1) := by
    intro k
    have hk := hle k
    have hlin_eq : lin k = (fun ω => φ (t0 + k - 1) ω * (π' (t0 + k) ω - π (t0 + k) ω)) -
        β • (φ (t0 + k) * 𝔽.E (t0 + k) (π' (t0 + k + 1) - π (t0 + k + 1))) := by
      funext ω
      have e17 := (hfoc _ hk ω).1
      have e18 := (hfoc _ hk ω).2
      have eAS := congrFun (hAS _ hk) ω
      have eAS' := congrFun (hAS' _ hk) ω
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at eAS eAS'
      simp only [hlin, Pi.sub_apply, Pi.smul_apply, Pi.mul_apply, smul_eq_mul, map_sub]
      linear_combination (π' (t0 + k) ω - π (t0 + k) ω) * e17 +
        (x' (t0 + k) ω - x (t0 + k) ω) * e18 - φ (t0 + k) ω * (eAS' - eAS)
    rw [hlin_eq, map_sub, map_smul, 𝔽.lie_identity hPO hk (hφa _ hk)]
    have e1 : t0 + ((k + 1 : ℕ) : ℤ) - 1 = t0 + k := by push_cast; ring
    have e2 : t0 + ((k + 1 : ℕ) : ℤ) = t0 + k + 1 := by push_cast; ring
    have e3 : t0 + (k : ℤ) + 1 - 1 = t0 + k := by ring
    simp only [hg, e2, e3]
    rfl
  have hEC : 𝔽.E t0 (fun ω => ∑' k : ℕ, β ^ k * lin k ω) = 0 := by
    funext ω
    rw [𝔽.E_tsum_geom hβ0' hβ1 blin t0 ω]
    simp only [hElin, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
    rw [tsum_telescope hβ0' hβ1 (fun k => bg k ω)]
    have h0 : (fun ω => φ (t0 + ((0 : ℕ) : ℤ) - 1) ω *
        (π' (t0 + ((0 : ℕ) : ℤ)) ω - π (t0 + ((0 : ℕ) : ℤ)) ω)) = 0 := by
      funext ω'
      simp only [Nat.cast_zero, add_zero, Pi.zero_apply]
      exact hinit ω'
    simp only [hg, h0, map_zero, Pi.zero_apply]
  rw [loss, loss, hsplit, map_add, map_add, map_smul, hEC, smul_zero, add_zero]

/-- Woodford (2003), p. 489 and App. F.1 (**Lagrangian sufficiency**): a feasible plan that
satisfies the first-order conditions (1.7)–(1.8) with a bounded adapted multiplier has an
expected loss no larger than any feasible plan `(π', x')` with
`φ_{t₀−1}(π'_{t₀} − π_{t₀}) = 0` (`λ ≥ 0`). -/
theorem loss_le (hPO : 𝔽.PullOut) {β κ lam xs : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1)
    (hlam : 0 ≤ lam) {u π x π' x' φ : ℤ → Ω → ℝ} {t0 : ℤ}
    (hf : Feasible 𝔽 β κ u t0 π x) (hf' : Feasible 𝔽 β κ u t0 π' x')
    (hφa : ∀ t, t0 ≤ t → 𝔽.E t (φ t) = φ t)
    (hφb : ∃ M, ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ M)
    (hfoc : FOC κ lam xs t0 π x φ)
    (hinit : ∀ ω, φ (t0 - 1) ω * (π' t0 ω - π t0 ω) = 0) :
    loss 𝔽 β lam xs t0 π x ≤ loss 𝔽 β lam xs t0 π' x' := by
  rw [loss_gap 𝔽 hPO hβ0 hβ1 hf hf' hφa hφb hfoc hinit]
  have hnn : (0 : Ω → ℝ) ≤ fun ω => ∑' k : ℕ, β ^ k * ((π' (t0 + k) ω - π (t0 + k) ω) ^ 2 +
      lam * (x' (t0 + k) ω - x (t0 + k) ω) ^ 2) := fun ω =>
    tsum_nonneg fun k => mul_nonneg (pow_nonneg hβ0.le k) (by positivity)
  have h := 𝔽.E_nonneg hnn t0
  intro ω
  have := h ω
  simp only [Pi.add_apply, Pi.zero_apply] at this ⊢
  linarith

/-- Woodford (2003), pp. 488–489 and App. F.1: **sufficiency for the constrained problem**.
A feasible plan satisfying (1.7)–(1.8) with a bounded adapted multiplier is optimal from `t₀`
subject to any restriction `C` that it satisfies, provided every plan satisfying `C` makes the
initial term `φ_{t₀−1}(π'_{t₀} − π_{t₀})` vanish. Two cases: `φ_{t₀−1} = 0` with no
restriction (the `t₀`-optimal plan, (2.5)), or `C` fixing `π_{t₀}` (the constraint (2.8)). -/
theorem isOptimal_of_foc (hPO : 𝔽.PullOut) {β κ lam xs : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1)
    (hlam : 0 ≤ lam) {u π x φ : ℤ → Ω → ℝ} {t0 : ℤ} {C : (ℤ → Ω → ℝ) → Prop}
    (hf : Feasible 𝔽 β κ u t0 π x) (hC : C π)
    (hφa : ∀ t, t0 ≤ t → 𝔽.E t (φ t) = φ t)
    (hφb : ∃ M, ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ M)
    (hfoc : FOC κ lam xs t0 π x φ)
    (hinit : ∀ π', C π' → ∀ ω, φ (t0 - 1) ω * (π' t0 ω - π t0 ω) = 0) :
    IsOptimal 𝔽 β κ lam xs u t0 C π x :=
  ⟨hf, hC, fun _ _ hf' hC' => loss_le 𝔽 hPO hβ0 hβ1 hlam hf hf' hφa hφb hfoc (hinit _ hC')⟩

/-- Woodford (2003), p. 489 ("a unique bounded solution"), uniqueness up to null events: if a
plan satisfying the first-order conditions solves the problem with restriction `C` (as in
`isOptimal_of_foc`), then every other optimal plan for the same problem agrees with it
`E_{t₀}`-almost surely: `E_{t₀}(π'_t − π_t)² = 0` and `E_{t₀}(x'_t − x_t)² = 0` for all
`t ≥ t₀` (`λ > 0`, strict convexity). -/
theorem optimal_unique_ae (hPO : 𝔽.PullOut) {β κ lam xs : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1)
    (hlam : 0 < lam) {u π x φ π' x' : ℤ → Ω → ℝ} {t0 : ℤ} {C : (ℤ → Ω → ℝ) → Prop}
    (hf : Feasible 𝔽 β κ u t0 π x) (hC : C π)
    (hφa : ∀ t, t0 ≤ t → 𝔽.E t (φ t) = φ t)
    (hφb : ∃ M, ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ M)
    (hfoc : FOC κ lam xs t0 π x φ)
    (hinit : ∀ π', C π' → ∀ ω, φ (t0 - 1) ω * (π' t0 ω - π t0 ω) = 0)
    (hopt : IsOptimal 𝔽 β κ lam xs u t0 C π' x') (k : ℕ) :
    𝔽.E t0 (fun ω => (π' (t0 + k) ω - π (t0 + k) ω) ^ 2) = 0 ∧
      𝔽.E t0 (fun ω => (x' (t0 + k) ω - x (t0 + k) ω) ^ 2) = 0 := by
  obtain ⟨hf', hC', hmin⟩ := hopt
  have hgap := loss_gap 𝔽 hPO hβ0 hβ1 hf hf' hφa hφb hfoc (hinit _ hC')
  have hle := hmin π x hf hC
  obtain ⟨-, -, M, hM⟩ := hf
  obtain ⟨-, -, M', hM'⟩ := hf'
  have hle0 : ∀ j : ℕ, t0 ≤ t0 + j := fun j => by omega
  set q : ℕ → Ω → ℝ := fun j ω => (π' (t0 + j) ω - π (t0 + j) ω) ^ 2 +
    lam * (x' (t0 + j) ω - x (t0 + j) ω) ^ 2 with hq
  have bq : ∀ j ω, |q j ω| ≤ (M' + M) ^ 2 + |lam| * (M' + M) ^ 2 := fun j ω =>
    abs_add_le_of (abs_sq_le (abs_sub_le_of (hM' _ (hle0 j) ω).1 (hM _ (hle0 j) ω).1))
      (abs_mul_le_of le_rfl (abs_sq_le (abs_sub_le_of (hM' _ (hle0 j) ω).2
        (hM _ (hle0 j) ω).2)))
  have hdπ : ∀ j ω, (0 : ℝ) ≤ 𝔽.E t0 (fun ω => (π' (t0 + j) ω - π (t0 + j) ω) ^ 2) ω :=
    fun j ω => 𝔽.E_nonneg (fun ω => sq_nonneg _) t0 ω
  have hdx : ∀ j ω, (0 : ℝ) ≤ 𝔽.E t0 (fun ω => (x' (t0 + j) ω - x (t0 + j) ω) ^ 2) ω :=
    fun j ω => 𝔽.E_nonneg (fun ω => sq_nonneg _) t0 ω
  have hEq : ∀ j, 𝔽.E t0 (q j) = 𝔽.E t0 (fun ω => (π' (t0 + j) ω - π (t0 + j) ω) ^ 2) +
      lam • 𝔽.E t0 (fun ω => (x' (t0 + j) ω - x (t0 + j) ω) ^ 2) := by
    intro j
    rw [← map_smul, ← map_add]
    rfl
  have hall : ∀ ω, 𝔽.E t0 (q k) ω = 0 := by
    intro ω
    have h1 := congrFun hgap ω
    have h2 := hle ω
    simp only [Pi.add_apply] at h1
    rw [𝔽.E_tsum_geom hβ0.le hβ1 bq t0 ω] at h1
    have hterm : ∀ j, 0 ≤ β ^ j * 𝔽.E t0 (q j) ω := fun j => by
      rw [hEq j]
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      exact mul_nonneg (pow_nonneg hβ0.le j)
        (add_nonneg (hdπ j ω) (mul_nonneg hlam.le (hdx j ω)))
    have hs : Summable (fun j => β ^ j * 𝔽.E t0 (q j) ω) :=
      summable_disc hβ0.le hβ1 (fun j => 𝔽.abs_E_le (bq j) t0 ω)
    have hzero : ∑' j, β ^ j * 𝔽.E t0 (q j) ω = 0 :=
      le_antisymm (by linarith) (tsum_nonneg hterm)
    have hsum := hs.hasSum
    rw [hzero, hasSum_zero_iff_of_nonneg hterm] at hsum
    have := congrFun hsum k
    simp only [Pi.zero_apply] at this
    rcases mul_eq_zero.mp this with h | h
    · exact absurd h (pow_ne_zero k hβ0.ne')
    · exact h
  constructor
  · funext ω
    simp only [Pi.zero_apply]
    have h := hall ω
    rw [hEq k] at h
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at h
    have := mul_nonneg hlam.le (hdx k ω)
    exact le_antisymm (by linarith [hdπ k ω]) (hdπ k ω)
  · funext ω
    simp only [Pi.zero_apply]
    have h := hall ω
    rw [hEq k] at h
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at h
    have h3 := hdπ k ω
    have h4 : lam * 𝔽.E t0 (fun ω => (x' (t0 + k) ω - x (t0 + k) ω) ^ 2) ω = 0 := by
      have := mul_nonneg hlam.le (hdx k ω)
      linarith
    rcases mul_eq_zero.mp h4 with h5 | h5
    · exact absurd h5 hlam.ne'
    · exact h5

/-- Woodford (2003), p. 489 ("a unique bounded solution for the state-contingent evolution"):
with a faithful expectation system the optimal plan is **unique**: every optimal plan for the
same problem coincides with the plan satisfying the first-order conditions at every date
`t ≥ t₀` and in every state. -/
theorem optimal_unique (hPO : 𝔽.PullOut) (hF : 𝔽.Faithful) {β κ lam xs : ℝ} (hβ0 : 0 < β)
    (hβ1 : β < 1) (hlam : 0 < lam) {u π x φ π' x' : ℤ → Ω → ℝ} {t0 : ℤ}
    {C : (ℤ → Ω → ℝ) → Prop}
    (hf : Feasible 𝔽 β κ u t0 π x) (hC : C π)
    (hφa : ∀ t, t0 ≤ t → 𝔽.E t (φ t) = φ t)
    (hφb : ∃ M, ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ M)
    (hfoc : FOC κ lam xs t0 π x φ)
    (hinit : ∀ π', C π' → ∀ ω, φ (t0 - 1) ω * (π' t0 ω - π t0 ω) = 0)
    (hopt : IsOptimal 𝔽 β κ lam xs u t0 C π' x') :
    ∀ t, t0 ≤ t → π' t = π t ∧ x' t = x t := by
  intro t ht
  obtain ⟨h1, h2⟩ := optimal_unique_ae 𝔽 hPO hβ0 hβ1 hlam hf hC hφa hφb hfoc hinit hopt
    (t - t0).toNat
  have ht' : t0 + ((t - t0).toNat : ℤ) = t := by omega
  rw [ht'] at h1 h2
  have h1' := hF t0 _ (fun ω => sq_nonneg _) h1
  have h2' := hF t0 _ (fun ω => sq_nonneg _) h2
  constructor
  · funext ω
    have := congrFun h1' ω
    simp only [Pi.zero_apply, pow_eq_zero_iff two_ne_zero, sub_eq_zero] at this
    exact this
  · funext ω
    have := congrFun h2' ω
    simp only [Pi.zero_apply, pow_eq_zero_iff two_ne_zero, sub_eq_zero] at this
    exact this


/-! ### The forward term `β⁻¹ ∑ μ₂^{−j−1} E_t u_{t+j}` -/

/-- Woodford (2003), eq. (2.7), p. 489: the forward term
`β⁻¹ ∑_{j ≥ 0} μ^{−j−1} E_t u_{t+j}` (used with `μ = μ₂`). -/
noncomputable def fwd (β μ : ℝ) (u : ℤ → Ω → ℝ) (t : ℤ) : Ω → ℝ :=
  fun ω => β⁻¹ * ∑' j : ℕ, (μ ^ (j + 1))⁻¹ * 𝔽.E t (u (t + j)) ω

/-- Woodford (2003), eq. (2.7), p. 489: the forward term is a multiple of the shared core's
forward series `∑ aᵏ E_t u_{t+k}` with `a = μ⁻¹`, computed in the system re-indexed from any
base date `T`. -/
theorem fwd_eq_forwardSeries (β μ : ℝ) (u : ℤ → Ω → ℝ) (T : ℤ) (n : ℕ) :
    fwd 𝔽 β μ u (T + n) =
      (β⁻¹ * μ⁻¹) • (𝔽.toNat T).forwardSeries μ⁻¹ (fun m : ℕ => u (T + m)) n := by
  funext ω
  simp only [fwd, ExpectationSystem.forwardSeries, Pi.smul_apply, smul_eq_mul,
    ExpSysZ.toNat_E]
  rw [mul_assoc]
  congr 1
  rw [← tsum_mul_left]
  refine tsum_congr fun j => ?_
  rw [Nat.cast_add, ← add_assoc, pow_succ, mul_inv, inv_pow]
  ring

/-- Woodford (2003), eq. (2.7), p. 489: `E_t u` is the date-0 forward series from base `t`. -/
theorem fwd_eq_forwardSeries_zero (β μ : ℝ) (u : ℤ → Ω → ℝ) (t : ℤ) :
    fwd 𝔽 β μ u t =
      (β⁻¹ * μ⁻¹) • (𝔽.toNat t).forwardSeries μ⁻¹ (fun m : ℕ => u (t + m)) 0 := by
  have h := fwd_eq_forwardSeries 𝔽 β μ u t 0
  rwa [Nat.cast_zero, add_zero] at h

/-- Woodford (2003), eq. (2.7), p. 489: for `μ > 1` the inverse `μ⁻¹` lies in `[0, 1)`. -/
theorem inv_mem_Ico {μ : ℝ} (hμ : 1 < μ) : 0 ≤ μ⁻¹ ∧ μ⁻¹ < 1 :=
  ⟨inv_nonneg.mpr (by linarith), inv_lt_one_of_one_lt₀ hμ⟩

/-- Woodford (2003), eq. (2.7), p. 489: the forward term is bounded for bounded `u`. -/
theorem fwd_bounded {β μ M : ℝ} (hμ : 1 < μ) {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) :
    ∀ t ω, |fwd 𝔽 β μ u t ω| ≤ |β⁻¹ * μ⁻¹| * (M / (1 - μ⁻¹)) := by
  intro t ω
  obtain ⟨ha0, ha1⟩ := inv_mem_Ico hμ
  rw [fwd_eq_forwardSeries_zero, Pi.smul_apply, smul_eq_mul, abs_mul]
  refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
  have hb : ∀ k ω', |(fun m : ℕ => u (t + m)) k ω'| ≤ M := fun k ω' => hu _ ω'
  have hs := (𝔽.toNat t).forwardSeries_summable ha0 ha1 hb 0 ω
  have hg : Summable (fun k : ℕ => M * μ⁻¹ ^ k) :=
    (summable_geometric_of_lt_one ha0 ha1).mul_left M
  have hval : ∑' k : ℕ, M * μ⁻¹ ^ k = M / (1 - μ⁻¹) := by
    rw [tsum_mul_left, tsum_geometric_of_lt_one ha0 ha1, div_eq_mul_inv]
  have hterm : ∀ k : ℕ, |μ⁻¹ ^ k * (𝔽.toNat t).E 0 ((fun m : ℕ => u (t + m)) (0 + k)) ω| ≤
      M * μ⁻¹ ^ k := fun k => by
    rw [abs_mul, abs_pow, abs_of_nonneg ha0, mul_comm M]
    exact mul_le_mul_of_nonneg_left ((𝔽.toNat t).abs_E_le (hb (0 + k)) 0 ω)
      (pow_nonneg ha0 k)
  change |∑' k, μ⁻¹ ^ k * (𝔽.toNat t).E 0 ((fun m : ℕ => u (t + m)) (0 + k)) ω| ≤ _
  rw [abs_le, ← hval]
  constructor
  · rw [← tsum_neg]
    refine Summable.tsum_le_tsum (fun k => ?_) hg.neg hs
    have h1 := neg_abs_le (μ⁻¹ ^ k * (𝔽.toNat t).E 0 ((fun m : ℕ => u (t + m)) (0 + k)) ω)
    linarith [hterm k]
  · exact Summable.tsum_le_tsum (fun k => (le_abs_self _).trans (hterm k)) hs hg

/-- Woodford (2003), eq. (2.7), p. 489: the forward term is known at date `t`. -/
theorem fwd_adapted {β μ M : ℝ} (hμ : 1 < μ) {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M)
    (t : ℤ) : 𝔽.E t (fwd 𝔽 β μ u t) = fwd 𝔽 β μ u t := by
  obtain ⟨ha0, ha1⟩ := inv_mem_Ico hμ
  rw [fwd_eq_forwardSeries_zero, map_smul, 𝔽.E_eq_toNat,
    (𝔽.toNat t).forwardSeries_adapted ha0 ha1 (u := fun m : ℕ => u (t + m))
      (fun m ω => hu _ ω) 0]

/-- Woodford (2003), eq. (2.7), p. 489: the forward term solves the first-order forward
equation `F_t = μ⁻¹ E_t F_{t+1} + β⁻¹ μ⁻¹ u_t`. -/
theorem fwd_rec {β μ M : ℝ} (hμ : 1 < μ) {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hua : ∀ t, 𝔽.E t (u t) = u t) (t : ℤ) :
    fwd 𝔽 β μ u t = μ⁻¹ • 𝔽.E t (fwd 𝔽 β μ u (t + 1)) + (β⁻¹ * μ⁻¹) • u t := by
  obtain ⟨ha0, ha1⟩ := inv_mem_Ico hμ
  have hua' : (𝔽.toNat t).Adapted (fun m : ℕ => u (t + m)) := by
    intro m
    rw [ExpSysZ.toNat_E]
    exact hua _
  have hsol := (𝔽.toNat t).forwardSeries_solves ha0 ha1 (u := fun m : ℕ => u (t + m))
    (fun m ω => hu _ ω) hua' 0
  have h1 := fwd_eq_forwardSeries 𝔽 β μ u t 1
  rw [Nat.cast_one] at h1
  rw [fwd_eq_forwardSeries_zero, h1, hsol, map_smul, 𝔽.E_eq_toNat]
  simp only [Nat.cast_zero, add_zero, zero_add, smul_add, smul_smul]
  congr 1
  ring_nf

/-- Woodford (2003), eq. (2.7), p. 489: `E_t F_{t+1} = μ F_t − β⁻¹ u_t`. -/
theorem fwd_E_succ {β μ M : ℝ} (hμ : 1 < μ) {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hua : ∀ t, 𝔽.E t (u t) = u t) (t : ℤ) (ω : Ω) :
    𝔽.E t (fwd 𝔽 β μ u (t + 1)) ω = μ * fwd 𝔽 β μ u t ω - β⁻¹ * u t ω := by
  have h := congrFun (fwd_rec 𝔽 hμ hu hua (β := β) t) ω
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at h
  have hμ0 : μ ≠ 0 := by linarith
  rw [h]
  field_simp
  ring

/-- Woodford (2003), eq. (2.7), p. 489: the forward term of a constant plus a shock,
`β⁻¹ ∑ μ^{−j−1} E_t (K + u_{t+j}) = β⁻¹ K/(μ − 1) + β⁻¹ ∑ μ^{−j−1} E_t u_{t+j}`. -/
theorem fwd_const_add {β μ M K : ℝ} (hμ : 1 < μ) {u : ℤ → Ω → ℝ}
    (hu : ∀ t ω, |u t ω| ≤ M) (t : ℤ) (ω : Ω) :
    fwd 𝔽 β μ (fun s => (fun _ => K) + u s) t ω = β⁻¹ * K / (μ - 1) + fwd 𝔽 β μ u t ω := by
  obtain ⟨ha0, ha1⟩ := inv_mem_Ico hμ
  have hμ1 : |(1 : ℝ)| < |μ| := by rw [abs_one, abs_of_pos (by linarith)]; exact hμ
  simp only [fwd, map_add, 𝔽.const, Pi.add_apply]
  have hs1 : Summable (fun j : ℕ => (μ ^ (j + 1))⁻¹ * K) := by
    have := (ForwardSolution.hasSum_geometric_ratio K hμ1).summable
    refine this.congr fun j => ?_
    rw [one_pow, mul_one]
    field_simp
  have hs2 : Summable (fun j : ℕ => (μ ^ (j + 1))⁻¹ * 𝔽.E t (u (t + j)) ω) := by
    refine Summable.of_norm_bounded
      ((summable_geometric_of_lt_one ha0 ha1).mul_right (μ⁻¹ * M)) (fun j => ?_)
    rw [Real.norm_eq_abs, abs_mul, ← inv_pow, abs_pow, abs_of_nonneg ha0, pow_succ]
    rw [mul_assoc]
    exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (𝔽.abs_E_le (hu _) t ω) ha0)
      (pow_nonneg ha0 j)
  have hval : ∑' j : ℕ, (μ ^ (j + 1))⁻¹ * K = K / (μ - 1) := by
    rw [← ForwardSolution.tsum_geometric_ratio K hμ1]
    refine tsum_congr fun j => ?_
    rw [one_pow, mul_one]
    field_simp
  simp_rw [mul_add]
  rw [hs1.tsum_add hs2, hval]
  ring

/-! ### The workhorse: second-order expectational difference equations (survey §4.3) -/

/-- Woodford (2003), eqs. (2.6)–(2.7), p. 489 (survey §4.3, the workhorse lemma; restated
in this module as the Chapter 7 core lacks it). Let `0 < β`, `c > 0`, `f` bounded and adapted,
and `y` adapted from `t₀` and bounded from `t₀ − 1`. Then
`β E_t y_{t+1} − (1 + β + c) y_t + y_{t−1} = f_t` for all `t ≥ t₀` **if and only if**
`y_t = μ₁ y_{t−1} − β⁻¹ ∑_j μ₂^{−j−1} E_t f_{t+j}` for all `t ≥ t₀`. -/
theorem workhorse_iff {β c M Mf : ℝ} (hβ : 0 < β) (hc : 0 < c) {f y : ℤ → Ω → ℝ} {t0 : ℤ}
    (hfb : ∀ t ω, |f t ω| ≤ Mf) (hfa : ∀ t, 𝔽.E t (f t) = f t)
    (hya : ∀ t, t0 ≤ t → 𝔽.E t (y t) = y t) (hyb : ∀ t, t0 - 1 ≤ t → ∀ ω, |y t ω| ≤ M) :
    (∀ t, t0 ≤ t → β • 𝔽.E t (y (t + 1)) - (1 + β + c) • y t + y (t - 1) = f t) ↔
      (∀ t, t0 ≤ t → y t = mu1 β c • y (t - 1) - fwd 𝔽 β (mu2 β c) f t) := by
  have hμ2 := one_lt_mu2 hβ hc
  have hsum := beta_mul_sum (c := c) hβ
  have hprod := beta_mul_mu1_mul_mu2 hβ hc
  have hββ : β * β⁻¹ = 1 := mul_inv_cancel₀ hβ.ne'
  constructor
  · intro h
    set μ1 := mu1 β c with hμ1
    set μ2 := mu2 β c with hμ2'
    set w : ℕ → Ω → ℝ := fun n => y (t0 + n) - μ1 • y (t0 + n - 1) + fwd 𝔽 β μ2 f (t0 + n)
      with hw
    have hrec : ∀ n : ℕ, w n = μ2⁻¹ • (𝔽.toNat t0).E n (w (n + 1)) + (0 : ℕ → Ω → ℝ) n := by
      intro n
      have ht : t0 ≤ t0 + n := by omega
      have e1 : t0 + ((n + 1 : ℕ) : ℤ) = t0 + n + 1 := by push_cast; ring
      have e2 : t0 + (n : ℤ) + 1 - 1 = t0 + n := by ring
      funext ω
      simp only [hw, ExpSysZ.toNat_E, e1, e2, map_add, map_sub, map_smul, Pi.add_apply,
        Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply, add_zero]
      rw [hya _ ht, fwd_E_succ 𝔽 hμ2 hfb hfa]
      have eS := congrFun (h _ ht) ω
      simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at eS
      have hμ2pos : μ2 ≠ 0 := by linarith
      have key : β * (𝔽.E (t0 + n) (y (t0 + n + 1)) ω - μ1 * y (t0 + n) ω +
          (μ2 * fwd 𝔽 β μ2 f (t0 + n) ω - β⁻¹ * f (t0 + n) ω) -
          μ2 * (y (t0 + n) ω - μ1 * y (t0 + n - 1) ω + fwd 𝔽 β μ2 f (t0 + n) ω)) = 0 := by
        linear_combination eS - y (t0 + n) ω * hsum + y (t0 + n - 1) ω * hprod -
          f (t0 + n) ω * hββ
      have key' := (mul_eq_zero.mp key).resolve_left hβ.ne'
      have hA : 𝔽.E (t0 + n) (y (t0 + n + 1)) ω - μ1 * y (t0 + n) ω +
          (μ2 * fwd 𝔽 β μ2 f (t0 + n) ω - β⁻¹ * f (t0 + n) ω) =
          μ2 * (y (t0 + n) ω - μ1 * y (t0 + n - 1) ω + fwd 𝔽 β μ2 f (t0 + n) ω) := by
        linarith
      rw [hA, ← mul_assoc, inv_mul_cancel₀ hμ2pos, one_mul]
    have hwb : BoundedProc w := by
      refine ⟨M + |μ1| * M + |β⁻¹ * μ2⁻¹| * (Mf / (1 - μ2⁻¹)), fun n ω => ?_⟩
      simp only [hw, Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
      exact abs_add_le_of (abs_sub_le_of (hyb _ (by omega) ω)
        (abs_mul_le_of le_rfl (hyb _ (by omega) ω))) (fwd_bounded 𝔽 hμ2 hfb _ ω)
    have hμinv : |μ2⁻¹| < 1 := by
      rw [abs_of_nonneg (inv_mem_Ico hμ2).1]
      exact (inv_mem_Ico hμ2).2
    have hz : ∀ n : ℕ, (0 : ℕ → Ω → ℝ) n =
        μ2⁻¹ • (𝔽.toNat t0).E n ((0 : ℕ → Ω → ℝ) (n + 1)) + (0 : ℕ → Ω → ℝ) n := by
      intro n
      simp
    have hw0 := (𝔽.toNat t0).forward_unique hμinv hrec hz hwb ⟨0, fun _ _ => by simp⟩
    intro t ht
    have hn := congrFun hw0 (t - t0).toNat
    have et : t0 + (((t - t0).toNat : ℕ) : ℤ) = t := by omega
    simp only [hw, et, Pi.zero_apply] at hn
    funext ω
    have := congrFun hn ω
    simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at this ⊢
    linarith
  · intro h t ht
    have h1 := h (t + 1) (by omega)
    rw [add_sub_cancel_right] at h1
    have h0 := h t ht
    funext ω
    have eE : 𝔽.E t (y (t + 1)) ω = mu1 β c * y t ω - (mu2 β c * fwd 𝔽 β (mu2 β c) f t ω -
        β⁻¹ * f t ω) := by
      rw [h1, map_sub, map_smul, hya t ht]
      simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
      rw [fwd_E_succ 𝔽 hμ2 hfb hfa]
    have eF := congrFun h0 ω
    simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at eF
    simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    rw [eE]
    linear_combination (-β * mu2 β c) * eF + y t ω * hsum - y (t - 1) ω * hprod +
      f t ω * hββ

/-! ### Backward recursion from an initial condition -/

/-- Woodford (2003), p. 489 ("(2.7) can be solved recursively ... starting from any initial
condition"): the solution of `y_t = μ y_{t−1} + g_t` (`t ≥ t₀`) with `y_{t₀−1} = y₀`,
`y_t = μ^{t−t₀+1} y₀ + ∑_{k=0}^{t−t₀} μᵏ g_{t−k}`. -/
noncomputable def backSol (μ : ℝ) (y0 : Ω → ℝ) (g : ℤ → Ω → ℝ) (t0 t : ℤ) : Ω → ℝ :=
  fun ω => μ ^ (t - t0 + 1).toNat * y0 ω +
    ∑ k ∈ Finset.range (t - t0 + 1).toNat, μ ^ k * g (t - k) ω

/-- Woodford (2003), p. 489: the recursion starts from `y_{t₀−1} = y₀`. -/
theorem backSol_init (μ : ℝ) (y0 : Ω → ℝ) (g : ℤ → Ω → ℝ) (t0 : ℤ) :
    backSol μ y0 g t0 (t0 - 1) = y0 := by
  funext ω
  have h : (t0 - 1 - t0 + 1).toNat = 0 := by omega
  simp [backSol]

/-- Woodford (2003), p. 489: the recursion `y_t = μ y_{t−1} + g_t` holds for `t ≥ t₀`. -/
theorem backSol_succ (μ : ℝ) (y0 : Ω → ℝ) (g : ℤ → Ω → ℝ) {t0 t : ℤ} (ht : t0 ≤ t) :
    backSol μ y0 g t0 t = μ • backSol μ y0 g t0 (t - 1) + g t := by
  funext ω
  have h1 : (t - t0 + 1).toNat = (t - t0).toNat + 1 := by omega
  have h2 : (t - 1 - t0 + 1).toNat = (t - t0).toNat := by omega
  have h3 : ∀ i : ℕ, μ ^ (i + 1) * g (t - ((i + 1 : ℕ) : ℤ)) ω =
      μ * (μ ^ i * g (t - 1 - i) ω) := by
    intro i
    have : t - ((i + 1 : ℕ) : ℤ) = t - 1 - i := by push_cast; ring
    rw [this]
    ring
  simp only [backSol, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  rw [h1, h2, Finset.sum_range_succ']
  simp only [h3, pow_zero, one_mul, Nat.cast_zero, sub_zero, ← Finset.mul_sum]
  ring

/-- Woodford (2003), p. 489: the backward recursion has exactly one solution from a given
initial condition. -/
theorem eq_backSol {μ : ℝ} {y0 : Ω → ℝ} {g y : ℤ → Ω → ℝ} {t0 : ℤ} (hinit : y (t0 - 1) = y0)
    (hrec : ∀ t, t0 ≤ t → y t = μ • y (t - 1) + g t) :
    ∀ t, t0 - 1 ≤ t → y t = backSol μ y0 g t0 t := by
  intro t ht
  induction t, ht using Int.leInduction with
  | base => rw [hinit, backSol_init]
  | succ n hn ih =>
    rw [hrec (n + 1) (by omega), backSol_succ μ y0 g (by omega), add_sub_cancel_right, ih]

/-- Woodford (2003), p. 489: the backward solution is bounded when `0 ≤ μ < 1`, `y₀` and `g`
are bounded. -/
theorem backSol_bounded {μ A B : ℝ} (hμ0 : 0 ≤ μ) (hμ1 : μ < 1) {y0 : Ω → ℝ}
    {g : ℤ → Ω → ℝ} (hy0 : ∀ ω, |y0 ω| ≤ A) (hg : ∀ t ω, |g t ω| ≤ B) (t0 t : ℤ) (ω : Ω) :
    |backSol μ y0 g t0 t ω| ≤ A + B / (1 - μ) := by
  have hA : 0 ≤ A := (abs_nonneg _).trans (hy0 ω)
  have hB : 0 ≤ B := (abs_nonneg _).trans (hg t ω)
  set n := (t - t0 + 1).toNat
  have hgs : Summable (fun k : ℕ => μ ^ k) := summable_geometric_of_lt_one hμ0 hμ1
  have hpart : ∑ k ∈ Finset.range n, μ ^ k ≤ 1 / (1 - μ) := by
    rw [one_div, ← tsum_geometric_of_lt_one hμ0 hμ1]
    exact hgs.sum_le_tsum _ (fun k _ => pow_nonneg hμ0 k)
  refine abs_add_le_of ?_ ?_
  · rw [abs_mul, abs_pow, abs_of_nonneg hμ0]
    calc μ ^ n * |y0 ω| ≤ 1 * A :=
          mul_le_mul (pow_le_one₀ hμ0 hμ1.le) (hy0 ω) (abs_nonneg _) zero_le_one
      _ = A := one_mul A
  · refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ k ∈ Finset.range n, |μ ^ k * g (t - k) ω|
        ≤ ∑ k ∈ Finset.range n, μ ^ k * B := Finset.sum_le_sum fun k _ => by
          rw [abs_mul, abs_pow, abs_of_nonneg hμ0]
          exact mul_le_mul_of_nonneg_left (hg _ ω) (pow_nonneg hμ0 k)
      _ = (∑ k ∈ Finset.range n, μ ^ k) * B := by rw [Finset.sum_mul]
      _ ≤ 1 / (1 - μ) * B := mul_le_mul_of_nonneg_right hpart hB
      _ = B / (1 - μ) := by ring

/-- Woodford (2003), p. 490 and footnote 19 (`t₀ → −∞` with `|μ₁| < 1`): for a fixed date `t`
and any uniformly bounded family of initial conditions `y₀(t₀)`, the backward solution at
`t` converges, as the starting date `t₀ → −∞`, to `∑_{k ≥ 0} μᵏ g_{t−k}`. The limit does
not depend on the initial conditions. -/
theorem backSol_tendsto {μ A B : ℝ} (hμ0 : 0 ≤ μ) (hμ1 : μ < 1) {y0 : ℤ → Ω → ℝ}
    {g : ℤ → Ω → ℝ} (hy0 : ∀ s ω, |y0 s ω| ≤ A) (hg : ∀ t ω, |g t ω| ≤ B) (t : ℤ) (ω : Ω) :
    Tendsto (fun t0 => backSol μ (y0 t0) g t0 t ω) atBot
      (𝓝 (∑' k : ℕ, μ ^ k * g (t - k) ω)) := by
  have hn : Tendsto (fun t0 : ℤ => (t - t0 + 1).toNat) atBot atTop := by
    refine tendsto_atTop.2 fun N => eventually_atBot.2 ⟨t - N, fun s hs => ?_⟩
    omega
  have hs : Summable (fun k : ℕ => μ ^ k * g (t - k) ω) :=
    summable_disc hμ0 hμ1 (fun k => hg _ ω)
  have h2 := hs.hasSum.tendsto_sum_nat.comp hn
  have h1 : Tendsto (fun t0 : ℤ => μ ^ (t - t0 + 1).toNat * y0 t0 ω) atBot (𝓝 0) := by
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun _ => norm_nonneg _) (fun s => ?_)
      (by simpa using ((tendsto_pow_atTop_nhds_zero_of_lt_one hμ0 hμ1).comp hn).mul_const A)
    rw [sub_zero, Real.norm_eq_abs, abs_mul, abs_pow, abs_of_nonneg hμ0]
    exact mul_le_mul_of_nonneg_left (hy0 s ω) (pow_nonneg hμ0 _)
  simpa [backSol] using h1.add h2


/-! ### The multiplier equations (2.6) and (2.7) -/

/-- Woodford (2003), p. 489: `μ₁` for the model, the smaller root of (1.11) with `c = κ²/λ`. -/
noncomputable def m1 (β κ lam : ℝ) : ℝ := mu1 β (κ ^ 2 / lam)

/-- Woodford (2003), p. 489: `μ₂` for the model, the larger root of (1.11) with `c = κ²/λ`. -/
noncomputable def m2 (β κ lam : ℝ) : ℝ := mu2 β (κ ^ 2 / lam)

/-- Woodford (2003), p. 489: the root facts `0 < μ₁ < 1 < μ₂`, `β (μ₁ + μ₂) = 1 + β + κ²/λ`,
`β μ₁ μ₂ = 1` and `β (1 − μ₁)(μ₂ − 1) = κ²/λ`. -/
theorem m_facts {β κ lam : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam) :
    0 < m1 β κ lam ∧ m1 β κ lam < 1 ∧ 1 < m2 β κ lam ∧
      β * (m1 β κ lam + m2 β κ lam) = 1 + β + κ ^ 2 / lam ∧
      β * m1 β κ lam * m2 β κ lam = 1 ∧
      β * (1 - m1 β κ lam) * (m2 β κ lam - 1) = κ ^ 2 / lam := by
  have hc : 0 < κ ^ 2 / lam := by positivity
  exact ⟨mu1_pos hβ hc, mu1_lt_one hβ hc, one_lt_mu2 hβ hc, beta_mul_sum hβ,
    beta_mul_mu1_mul_mu2 hβ hc, mu_key hβ hc⟩

/-- Woodford (2003), eq. (2.7), p. 489: the constant of (2.7), `C = (1 − μ₁)(λ/κ) x*`,
satisfies `C β (μ₂ − 1) = κ x*`. -/
theorem m_const {β κ lam xs : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam) :
    (1 - m1 β κ lam) * (lam / κ) * xs * (β * (m2 β κ lam - 1)) = κ * xs := by
  obtain ⟨-, -, -, -, -, hkey⟩ := m_facts hβ hκ hlam
  have h : (1 - m1 β κ lam) * (lam / κ) * xs * (β * (m2 β κ lam - 1)) =
      (β * (1 - m1 β κ lam) * (m2 β κ lam - 1)) * (lam / κ) * xs := by ring
  rw [h, hkey]
  field_simp

/-- Woodford (2003), eq. (2.6), p. 488: the stochastic multiplier equation
`β E_t φ_{t+1} − (1 + β + κ²/λ) φ_t + φ_{t−1} = κ x* + u_t` at date `t`. -/
def MultEq (β κ lam xs : ℝ) (u φ : ℤ → Ω → ℝ) (t : ℤ) : Prop :=
  β • 𝔽.E t (φ (t + 1)) - (1 + β + κ ^ 2 / lam) • φ t + φ (t - 1) = (fun _ => κ * xs) + u t

/-- Woodford (2003), eq. (2.7), p. 489: the solved multiplier law
`φ_t = μ₁ φ_{t−1} − (1 − μ₁)(λ/κ) x* − β⁻¹ ∑_j μ₂^{−j−1} E_t u_{t+j}` at date `t`. -/
def Rec27 (β κ lam xs : ℝ) (u φ : ℤ → Ω → ℝ) (t : ℤ) : Prop :=
  φ t = m1 β κ lam • φ (t - 1) - (fun _ => (1 - m1 β κ lam) * (lam / κ) * xs) -
    fwd 𝔽 β (m2 β κ lam) u t

/-- Woodford (2003), eq. (1.7), p. 472: the inflation path implied by a multiplier path,
`π_t = φ_{t−1} − φ_t`. -/
def planInfl (φ : ℤ → Ω → ℝ) (t : ℤ) : Ω → ℝ := φ (t - 1) - φ t

/-- Woodford (2003), eq. (1.8), p. 472: the output-gap path implied by a multiplier path,
`x_t = x* + (κ/λ) φ_t`. -/
noncomputable def planGap (κ lam xs : ℝ) (φ : ℤ → Ω → ℝ) (t : ℤ) : Ω → ℝ :=
  fun ω => xs + κ / lam * φ t ω

/-- Woodford (2003), eqs. (1.7)–(1.8), p. 472: the paths `planInfl`, `planGap` satisfy the
first-order conditions with multiplier `φ`. -/
theorem plan_foc {κ lam xs : ℝ} (hlam : 0 < lam) (φ : ℤ → Ω → ℝ) (t0 : ℤ) :
    FOC κ lam xs t0 (planInfl φ) (planGap κ lam xs φ) φ := by
  intro t _ ω
  refine ⟨by simp [planInfl], ?_⟩
  simp only [planGap]
  field_simp
  ring

/-- Woodford (2003), p. 488 ("using (1.7) and (1.8) to substitute for `π_t` and `x_t` in
(2.1)"): when `π_t = φ_{t−1} − φ_t`, `π_{t+1} = φ_t − φ_{t+1}` and `x_t = x* + (κ/λ) φ_t`
with `φ_t` known at `t`, the AS relation (2.1) at `t` holds **if and only if** the multiplier
equation (2.6) holds at `t`. -/
theorem as_iff_multEq {β κ lam xs : ℝ} {u φ π x : ℤ → Ω → ℝ} {t : ℤ}
    (hφa : 𝔽.E t (φ t) = φ t) (hπt : π t = φ (t - 1) - φ t)
    (hπt1 : π (t + 1) = φ t - φ (t + 1)) (hxt : x t = fun ω => xs + κ / lam * φ t ω) :
    AS 𝔽 β κ u π x t ↔ MultEq 𝔽 β κ lam xs u φ t := by
  rw [AS, MultEq, hπt, hπt1, hxt, map_sub, hφa]
  have hc : κ ^ 2 / lam = κ * (κ / lam) := by ring
  rw [hc]
  constructor
  · intro h
    funext ω
    have h1 := congrFun h ω
    simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at h1 ⊢
    linear_combination h1
  · intro h
    funext ω
    have h1 := congrFun h ω
    simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at h1 ⊢
    linear_combination h1

/-- Woodford (2003), eqs. (2.6)–(2.7), p. 489: for a multiplier process that is adapted from
`t₀` and bounded from `t₀ − 1`, the stochastic multiplier equation (2.6) holds at every
`t ≥ t₀` **if and only if** the solved law (2.7) does. This is the workhorse with
`f_t = κ x* + u_t`, together with the constant identity
`β⁻¹ κ x*/(μ₂ − 1) = (1 − μ₁)(λ/κ) x*`. -/
theorem multEq_iff_rec27 {β κ lam xs M Mφ : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u φ : ℤ → Ω → ℝ} {t0 : ℤ} (hu : ∀ t ω, |u t ω| ≤ M) (hua : ∀ t, 𝔽.E t (u t) = u t)
    (hφa : ∀ t, t0 ≤ t → 𝔽.E t (φ t) = φ t) (hφb : ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ Mφ) :
    (∀ t, t0 ≤ t → MultEq 𝔽 β κ lam xs u φ t) ↔ (∀ t, t0 ≤ t → Rec27 𝔽 β κ lam xs u φ t) := by
  have hc : 0 < κ ^ 2 / lam := by positivity
  have hμ2 := one_lt_mu2 hβ hc
  have hfb : ∀ t ω, |((fun _ => κ * xs) + u t : Ω → ℝ) ω| ≤ |κ * xs| + M := fun t ω =>
    abs_add_le_of le_rfl (hu t ω)
  have hfa : ∀ t, 𝔽.E t ((fun _ => κ * xs) + u t) = (fun _ => κ * xs) + u t := fun t => by
    rw [map_add, 𝔽.const, hua]
  have hw := workhorse_iff 𝔽 hβ hc hfb hfa hφa hφb
  have hF : ∀ t, fwd 𝔽 β (mu2 β (κ ^ 2 / lam)) (fun s => (fun _ => κ * xs) + u s) t =
      (fun _ => (1 - m1 β κ lam) * (lam / κ) * xs) + fwd 𝔽 β (m2 β κ lam) u t := by
    intro t
    funext ω
    rw [fwd_const_add 𝔽 hμ2 hu, Pi.add_apply, m1, m2, const_identity hβ hκ hlam]
  simp only [MultEq, Rec27]
  rw [hw]
  constructor
  · intro h t ht
    rw [h t ht, hF, m1]
    abel
  · intro h t ht
    rw [h t ht, hF, m1]
    abel

/-- Woodford (2003), App. F.1, p. 709: a multiplier path following (2.7) from `t₀`, with
`φ_{t₀−1}` known at `t₀`, is adapted: `φ_t` and `φ_{t−1}` are known at every `t ≥ t₀`. -/
theorem rec27_adapted {β κ lam xs M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u φ : ℤ → Ω → ℝ} {t0 : ℤ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hrec : ∀ t, t0 ≤ t → Rec27 𝔽 β κ lam xs u φ t) (hφ0 : 𝔽.E t0 (φ (t0 - 1)) = φ (t0 - 1)) :
    ∀ t, t0 ≤ t → 𝔽.E t (φ t) = φ t ∧ 𝔽.E t (φ (t - 1)) = φ (t - 1) := by
  have hμ2 := (m_facts hβ hκ hlam).2.2.1
  have step : ∀ t, t0 ≤ t → 𝔽.E t (φ (t - 1)) = φ (t - 1) → 𝔽.E t (φ t) = φ t := by
    intro t ht h
    rw [hrec t ht, map_sub, map_sub, map_smul, h, 𝔽.const, fwd_adapted 𝔽 hμ2 hu]
  intro t ht
  induction t, ht using Int.leInduction with
  | base => exact ⟨step t0 le_rfl hφ0, hφ0⟩
  | succ n hn ih =>
    have h1 : 𝔽.E (n + 1) (φ (n + 1 - 1)) = φ (n + 1 - 1) := by
      rw [add_sub_cancel_right]
      exact 𝔽.E_of_known (by omega) ih.1
    exact ⟨step (n + 1) (by omega) h1, h1⟩

/-- Woodford (2003), p. 489 ("substituting this solution for the path of the Lagrange
multipliers into (1.7) and (1.8), one obtains unique bounded solutions for the paths of
inflation and the output gap"): a bounded multiplier path following (2.7) from `t₀`, with
`φ_{t₀−1}` known at `t₀`, yields a **feasible** plan. -/
theorem plan_feasible {β κ lam xs M Mφ : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u φ : ℤ → Ω → ℝ} {t0 : ℤ} (hu : ∀ t ω, |u t ω| ≤ M) (hua : ∀ t, 𝔽.E t (u t) = u t)
    (hrec : ∀ t, t0 ≤ t → Rec27 𝔽 β κ lam xs u φ t) (hφ0 : 𝔽.E t0 (φ (t0 - 1)) = φ (t0 - 1))
    (hφb : ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ Mφ) :
    Feasible 𝔽 β κ u t0 (planInfl φ) (planGap κ lam xs φ) := by
  have had := rec27_adapted 𝔽 hβ hκ hlam hu hrec hφ0
  have hmult := (multEq_iff_rec27 𝔽 hβ hκ hlam hu hua (fun t ht => (had t ht).1) hφb).mpr hrec
  have hφb' : ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ |Mφ| := fun t ht ω =>
    (hφb t ht ω).trans (le_abs_self _)
  refine ⟨fun t ht => ?_, fun t ht => ⟨?_, ?_⟩, ⟨|Mφ| + |Mφ| + (|xs| + |κ / lam| * |Mφ|),
    fun t ht ω => ⟨?_, ?_⟩⟩⟩
  · refine (as_iff_multEq 𝔽 (had t ht).1 rfl ?_ rfl).mpr (hmult t ht)
    simp only [planInfl, add_sub_cancel_right]
  · simp only [planInfl]
    rw [map_sub, (had t ht).1, (had t ht).2]
  · have h : planGap κ lam xs φ t = (fun _ => xs) + (κ / lam) • φ t := by
      funext ω
      simp [planGap]
    rw [h, map_add, map_smul, 𝔽.const, (had t ht).1]
  · simp only [planInfl, Pi.sub_apply]
    have := abs_sub_le_of (hφb' (t - 1) (by omega) ω) (hφb' t (by omega) ω)
    have h2 : 0 ≤ |xs| + |κ / lam| * |Mφ| := by positivity
    linarith
  · simp only [planGap]
    have := abs_add_le_of (le_refl |xs|) (abs_mul_le_of (le_refl |κ / lam|)
      (hφb' t (by omega) ω))
    linarith [abs_nonneg Mφ]

/-- Woodford (2003), eq. (F.2), p. 709: along a multiplier path following (2.7), inflation is
`π_t = (1 − μ₁) φ_{t−1} + (1 − μ₁)(λ/κ) x* + β⁻¹ ∑_j μ₂^{−j−1} E_t u_{t+j}`. -/
theorem planInfl_F2 {β κ lam xs : ℝ} {u φ : ℤ → Ω → ℝ} {t : ℤ}
    (hrec : Rec27 𝔽 β κ lam xs u φ t) (ω : Ω) :
    planInfl φ t ω = (1 - m1 β κ lam) * φ (t - 1) ω + (1 - m1 β κ lam) * (lam / κ) * xs +
      fwd 𝔽 β (m2 β κ lam) u t ω := by
  simp only [planInfl, Pi.sub_apply]
  rw [hrec]
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  ring

/-- Woodford (2003), pp. 489–490 and App. F.1 (**the constrained optimum**): a bounded
multiplier path following (2.7) from `t₀`, with `φ_{t₀−1}` known at `t₀`, yields a plan that
is **optimal** from `t₀` subject to the initial constraint (2.8) `π_{t₀} = π̄_{t₀}` with
`π̄_{t₀}` its own initial inflation rate. The proof is Lagrangian sufficiency. -/
theorem plan_isOptimal (hPO : 𝔽.PullOut) {β κ lam xs M Mφ : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1)
    (hκ : 0 < κ) (hlam : 0 < lam) {u φ : ℤ → Ω → ℝ} {t0 : ℤ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hua : ∀ t, 𝔽.E t (u t) = u t) (hrec : ∀ t, t0 ≤ t → Rec27 𝔽 β κ lam xs u φ t)
    (hφ0 : 𝔽.E t0 (φ (t0 - 1)) = φ (t0 - 1)) (hφb : ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ Mφ) :
    IsOptimal 𝔽 β κ lam xs u t0 (fun π' => π' t0 = planInfl φ t0) (planInfl φ)
      (planGap κ lam xs φ) := by
  refine isOptimal_of_foc 𝔽 hPO hβ0 hβ1 hlam.le
    (plan_feasible 𝔽 hβ0 hκ hlam hu hua hrec hφ0 hφb) rfl
    (fun t ht => (rec27_adapted 𝔽 hβ0 hκ hlam hu hrec hφ0 t ht).1) ⟨Mφ, hφb⟩
    (plan_foc hlam φ t0) ?_
  intro π' hπ' ω
  rw [hπ', sub_self, mul_zero]

/-- Woodford (2003), p. 489 (**the `t₀`-optimal commitment**): with the initial condition (2.5)
`φ_{t₀−1} = 0`, the plan generated by (2.7) is optimal from `t₀` among **all** feasible plans
(no initial constraint). -/
theorem plan_t0_optimal (hPO : 𝔽.PullOut) {β κ lam xs M Mφ : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1)
    (hκ : 0 < κ) (hlam : 0 < lam) {u φ : ℤ → Ω → ℝ} {t0 : ℤ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hua : ∀ t, 𝔽.E t (u t) = u t) (hrec : ∀ t, t0 ≤ t → Rec27 𝔽 β κ lam xs u φ t)
    (h25 : φ (t0 - 1) = 0) (hφb : ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ Mφ) :
    IsOptimal 𝔽 β κ lam xs u t0 (fun _ => True) (planInfl φ) (planGap κ lam xs φ) := by
  have hφ0 : 𝔽.E t0 (φ (t0 - 1)) = φ (t0 - 1) := by rw [h25, map_zero]
  refine isOptimal_of_foc 𝔽 hPO hβ0 hβ1 hlam.le
    (plan_feasible 𝔽 hβ0 hκ hlam hu hua hrec hφ0 hφb) trivial
    (fun t ht => (rec27_adapted 𝔽 hβ0 hκ hlam hu hrec hφ0 t ht).1) ⟨Mφ, hφb⟩
    (plan_foc hlam φ t0) ?_
  intro π' _ ω
  rw [h25, Pi.zero_apply, zero_mul]

/-- Woodford (2003), p. 489 ("a unique bounded solution ... for any given specification of
the initial condition"): with a faithful expectation system, every optimal plan for the
constrained problem of `plan_isOptimal` coincides with the plan generated by (2.7). -/
theorem plan_unique (hPO : 𝔽.PullOut) (hF : 𝔽.Faithful) {β κ lam xs M Mφ : ℝ} (hβ0 : 0 < β)
    (hβ1 : β < 1) (hκ : 0 < κ) (hlam : 0 < lam) {u φ π' x' : ℤ → Ω → ℝ} {t0 : ℤ}
    (hu : ∀ t ω, |u t ω| ≤ M) (hua : ∀ t, 𝔽.E t (u t) = u t)
    (hrec : ∀ t, t0 ≤ t → Rec27 𝔽 β κ lam xs u φ t) (hφ0 : 𝔽.E t0 (φ (t0 - 1)) = φ (t0 - 1))
    (hφb : ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ Mφ)
    (hopt : IsOptimal 𝔽 β κ lam xs u t0 (fun π' => π' t0 = planInfl φ t0) π' x') :
    ∀ t, t0 ≤ t → π' t = planInfl φ t ∧ x' t = planGap κ lam xs φ t := by
  refine optimal_unique 𝔽 hPO hF hβ0 hβ1 hlam (C := fun π' => π' t0 = planInfl φ t0)
    (plan_feasible 𝔽 hβ0 hκ hlam hu hua hrec hφ0 hφb) rfl
    (fun t ht => (rec27_adapted 𝔽 hβ0 hκ hlam hu hrec hφ0 t ht).1) ⟨Mφ, hφb⟩
    (plan_foc hlam φ t0) ?_ hopt
  intro π'' hπ'' ω
  rw [hπ'', sub_self, mul_zero]

/-- Woodford (2003), p. 489 ("optimal from a timeless perspective"): a plan `(π, x)` from
`t₀` is **timelessly optimal** for a constraint specification `S` (a value `S t₁` for every
date) when, for every later date `t₁ ≥ t₀`, its continuation from `t₁` minimises the expected
discounted loss from `t₁` among feasible plans satisfying `π_{t₁} = S t₁`. -/
def TimelesslyOptimal (β κ lam xs : ℝ) (u : ℤ → Ω → ℝ) (t0 : ℤ) (S : ℤ → Ω → ℝ)
    (π x : ℤ → Ω → ℝ) : Prop :=
  ∀ t1, t0 ≤ t1 → IsOptimal 𝔽 β κ lam xs u t1 (fun π' => π' t1 = S t1) π x

/-- Woodford (2003), pp. 489–490: a plan generated by (2.7) from `t₀` (bounded, with `φ_{t₀−1}`
known at `t₀`) is timelessly optimal for the specification `S t₁ = π_{t₁}`. Its continuation
from any `t₁ ≥ t₀` is again generated by (2.7), with initial multiplier `φ_{t₁−1}`, which is
known at `t₁`. -/
theorem plan_timeless (hPO : 𝔽.PullOut) {β κ lam xs M Mφ : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1)
    (hκ : 0 < κ) (hlam : 0 < lam) {u φ : ℤ → Ω → ℝ} {t0 : ℤ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hua : ∀ t, 𝔽.E t (u t) = u t) (hrec : ∀ t, t0 ≤ t → Rec27 𝔽 β κ lam xs u φ t)
    (hφ0 : 𝔽.E t0 (φ (t0 - 1)) = φ (t0 - 1)) (hφb : ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ Mφ) :
    TimelesslyOptimal 𝔽 β κ lam xs u t0 (planInfl φ) (planInfl φ) (planGap κ lam xs φ) := by
  intro t1 ht1
  have had := rec27_adapted 𝔽 hβ0 hκ hlam hu hrec hφ0
  exact plan_isOptimal 𝔽 hPO hβ0 hβ1 hκ hlam hu hua (fun t ht => hrec t (by omega))
    (had t1 ht1).2 (fun t ht => hφb t (by omega))


/-! ### The constrained optimum for an arbitrary initial constraint (2.8) -/

/-- Woodford (2003), p. 489: the multiplier path solving (2.7) recursively from the initial
multiplier `φ_{t₀−1} = φ₀`. -/
noncomputable def multPath (β κ lam xs : ℝ) (u : ℤ → Ω → ℝ) (φ0 : Ω → ℝ) (t0 : ℤ) :
    ℤ → Ω → ℝ :=
  backSol (m1 β κ lam) φ0
    (fun t ω => -((1 - m1 β κ lam) * (lam / κ) * xs + fwd 𝔽 β (m2 β κ lam) u t ω)) t0

/-- Woodford (2003), p. 489: `multPath` starts from `φ_{t₀−1} = φ₀`. -/
theorem multPath_init (β κ lam xs : ℝ) (u : ℤ → Ω → ℝ) (φ0 : Ω → ℝ) (t0 : ℤ) :
    multPath 𝔽 β κ lam xs u φ0 t0 (t0 - 1) = φ0 :=
  backSol_init _ _ _ _

/-- Woodford (2003), eq. (2.7), p. 489: `multPath` satisfies (2.7) at every `t ≥ t₀`. -/
theorem multPath_rec27 (β κ lam xs : ℝ) (u : ℤ → Ω → ℝ) (φ0 : Ω → ℝ) {t0 t : ℤ}
    (ht : t0 ≤ t) : Rec27 𝔽 β κ lam xs u (multPath 𝔽 β κ lam xs u φ0 t0) t := by
  rw [Rec27, multPath, backSol_succ _ _ _ ht]
  funext ω
  simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  ring

/-- Woodford (2003), eq. (2.7), p. 489: the constant-plus-forward forcing term of (2.7) is
bounded. -/
theorem forcing27_bounded {β κ lam xs M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) (t : ℤ) (ω : Ω) :
    |-((1 - m1 β κ lam) * (lam / κ) * xs + fwd 𝔽 β (m2 β κ lam) u t ω)| ≤
      |(1 - m1 β κ lam) * (lam / κ) * xs| +
        |β⁻¹ * (m2 β κ lam)⁻¹| * (M / (1 - (m2 β κ lam)⁻¹)) := by
  rw [abs_neg]
  exact abs_add_le_of le_rfl (fwd_bounded 𝔽 (m_facts hβ hκ hlam).2.2.1 hu t ω)

/-- Woodford (2003), p. 489: `multPath` is bounded when `φ₀` is (`|μ₁| < 1`). -/
theorem multPath_bounded {β κ lam xs M A : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) {φ0 : Ω → ℝ} (hφ0 : ∀ ω, |φ0 ω| ≤ A)
    (t0 t : ℤ) (ω : Ω) :
    |multPath 𝔽 β κ lam xs u φ0 t0 t ω| ≤ A + (|(1 - m1 β κ lam) * (lam / κ) * xs| +
      |β⁻¹ * (m2 β κ lam)⁻¹| * (M / (1 - (m2 β κ lam)⁻¹))) / (1 - m1 β κ lam) := by
  obtain ⟨h1, h2, -⟩ := m_facts hβ hκ hlam
  exact backSol_bounded h1.le h2 hφ0 (forcing27_bounded 𝔽 hβ hκ hlam hu) t0 t ω

/-- Woodford (2003), App. F.1, p. 709: the initial multiplier consistent with the constraint
(2.8), obtained by solving (F.2) at `t₀` for `φ_{t₀−1}`:
`φ_{t₀−1} = (π̄_{t₀} − β⁻¹ ∑ μ₂^{−j−1} E_{t₀} u_{t₀+j})/(1 − μ₁) − (λ/κ) x*`. -/
noncomputable def initMult (β κ lam xs : ℝ) (u : ℤ → Ω → ℝ) (pibar : Ω → ℝ) (t0 : ℤ) :
    Ω → ℝ :=
  fun ω => (pibar ω - fwd 𝔽 β (m2 β κ lam) u t0 ω) / (1 - m1 β κ lam) - lam / κ * xs

/-- Woodford (2003), App. F.1, p. 709: with the initial multiplier `initMult`, (F.2) gives
`π_{t₀} = π̄_{t₀}`. -/
theorem initMult_spec {β κ lam xs : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    (u : ℤ → Ω → ℝ) (pibar : Ω → ℝ) (t0 : ℤ) :
    planInfl (multPath 𝔽 β κ lam xs u (initMult 𝔽 β κ lam xs u pibar t0) t0) t0 = pibar := by
  have h1 := (m_facts hβ hκ hlam).2.1
  have hne : 1 - m1 β κ lam ≠ 0 := by linarith
  funext ω
  rw [planInfl_F2 𝔽 (multPath_rec27 𝔽 β κ lam xs u _ le_rfl), multPath_init, initMult]
  field_simp
  ring

/-- Woodford (2003), App. F.1, p. 709: (F.2) is invertible in `φ_{t₀−1}`: the initial
multiplier producing `π_{t₀} = π̄` is unique. -/
theorem initMult_unique {β κ lam xs : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} {pibar φ0 : Ω → ℝ} {t0 : ℤ}
    (h : planInfl (multPath 𝔽 β κ lam xs u φ0 t0) t0 = pibar) :
    φ0 = initMult 𝔽 β κ lam xs u pibar t0 := by
  have h1 := (m_facts hβ hκ hlam).2.1
  have hne : 1 - m1 β κ lam ≠ 0 := by linarith
  funext ω
  have h2 := congrFun h ω
  rw [planInfl_F2 𝔽 (multPath_rec27 𝔽 β κ lam xs u _ le_rfl), multPath_init] at h2
  rw [initMult, ← h2]
  field_simp
  ring

/-- Woodford (2003), App. F.1, p. 709: the initial multiplier is known at `t₀` when `π̄_{t₀}` is. -/
theorem initMult_known {β κ lam xs M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) {pibar : Ω → ℝ} {t0 : ℤ}
    (hpi : 𝔽.E t0 pibar = pibar) :
    𝔽.E t0 (initMult 𝔽 β κ lam xs u pibar t0) = initMult 𝔽 β κ lam xs u pibar t0 := by
  have h : initMult 𝔽 β κ lam xs u pibar t0 = (1 - m1 β κ lam)⁻¹ •
      (pibar - fwd 𝔽 β (m2 β κ lam) u t0) - fun _ => lam / κ * xs := by
    funext ω
    simp only [initMult, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    ring
  rw [h, map_sub, map_smul, map_sub, hpi, fwd_adapted 𝔽 (m_facts hβ hκ hlam).2.2.1 hu,
    𝔽.const]

/-- Woodford (2003), App. F.1, p. 709: the initial multiplier is bounded when `π̄_{t₀}` is. -/
theorem initMult_bounded {β κ lam xs M A : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) {pibar : Ω → ℝ} (hpb : ∀ ω, |pibar ω| ≤ A)
    (t0 : ℤ) (ω : Ω) :
    |initMult 𝔽 β κ lam xs u pibar t0 ω| ≤
      (A + |β⁻¹ * (m2 β κ lam)⁻¹| * (M / (1 - (m2 β κ lam)⁻¹))) / (1 - m1 β κ lam) +
        |lam / κ * xs| := by
  have h1 := (m_facts hβ hκ hlam).2.1
  have hpos : 0 < 1 - m1 β κ lam := by linarith
  simp only [initMult]
  refine abs_sub_le_of ?_ le_rfl
  rw [abs_div, abs_of_pos hpos]
  exact div_le_div_of_nonneg_right
    (abs_sub_le_of (hpb ω) (fwd_bounded 𝔽 (m_facts hβ hκ hlam).2.2.1 hu t0 ω)) hpos.le

/-- Woodford (2003), p. 489 (**existence and form of the constrained optimum**): for every
bounded initial constraint value `π̄_{t₀}` known at `t₀`, the plan generated by (2.7) from the
initial multiplier `initMult` (the solution of (F.2)) is optimal from `t₀` subject to (2.8)
`π_{t₀} = π̄_{t₀}`. -/
theorem constrained_optimum (hPO : 𝔽.PullOut) {β κ lam xs M A : ℝ} (hβ0 : 0 < β)
    (hβ1 : β < 1) (hκ : 0 < κ) (hlam : 0 < lam) {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hua : ∀ t, 𝔽.E t (u t) = u t) {pibar : Ω → ℝ} {t0 : ℤ} (hpi : 𝔽.E t0 pibar = pibar)
    (hpb : ∀ ω, |pibar ω| ≤ A) :
    IsOptimal 𝔽 β κ lam xs u t0 (fun π' => π' t0 = pibar)
      (planInfl (multPath 𝔽 β κ lam xs u (initMult 𝔽 β κ lam xs u pibar t0) t0))
      (planGap κ lam xs (multPath 𝔽 β κ lam xs u (initMult 𝔽 β κ lam xs u pibar t0) t0)) := by
  have h := plan_isOptimal 𝔽 hPO hβ0 hβ1 hκ hlam hu hua
    (fun t ht => multPath_rec27 𝔽 β κ lam xs u (initMult 𝔽 β κ lam xs u pibar t0) ht)
    (by rw [multPath_init]; exact initMult_known 𝔽 hβ0 hκ hlam hu hpi)
    (fun t _ ω => multPath_bounded 𝔽 hβ0 hκ hlam hu
      (initMult_bounded 𝔽 hβ0 hκ hlam hu hpb t0) t0 t ω)
  rwa [initMult_spec 𝔽 hβ0 hκ hlam] at h

/-- Woodford (2003), p. 489 (**uniqueness of the constrained optimum**): with a faithful
expectation system, every optimal plan subject to (2.8) coincides with the plan of
`constrained_optimum` at every `t ≥ t₀`. -/
theorem constrained_optimum_unique (hPO : 𝔽.PullOut) (hF : 𝔽.Faithful) {β κ lam xs M A : ℝ}
    (hβ0 : 0 < β) (hβ1 : β < 1) (hκ : 0 < κ) (hlam : 0 < lam) {u : ℤ → Ω → ℝ}
    (hu : ∀ t ω, |u t ω| ≤ M) (hua : ∀ t, 𝔽.E t (u t) = u t) {pibar : Ω → ℝ} {t0 : ℤ}
    (hpi : 𝔽.E t0 pibar = pibar) (hpb : ∀ ω, |pibar ω| ≤ A) {π' x' : ℤ → Ω → ℝ}
    (hopt : IsOptimal 𝔽 β κ lam xs u t0 (fun π' => π' t0 = pibar) π' x') :
    ∀ t, t0 ≤ t →
      π' t = planInfl (multPath 𝔽 β κ lam xs u (initMult 𝔽 β κ lam xs u pibar t0) t0) t ∧
      x' t = planGap κ lam xs
        (multPath 𝔽 β κ lam xs u (initMult 𝔽 β κ lam xs u pibar t0) t0) t := by
  refine plan_unique 𝔽 hPO hF hβ0 hβ1 hκ hlam hu hua
    (fun t ht => multPath_rec27 𝔽 β κ lam xs u (initMult 𝔽 β κ lam xs u pibar t0) ht)
    (by rw [multPath_init]; exact initMult_known 𝔽 hβ0 hκ hlam hu hpi)
    (fun t _ ω => multPath_bounded 𝔽 hβ0 hκ hlam hu
      (initMult_bounded 𝔽 hβ0 hκ hlam hu hpb t0) t0 t ω) ?_
  rwa [initMult_spec 𝔽 hβ0 hκ hlam]


/-! ### Proposition 7.6 and Appendix F.1 -/

/-- Woodford (2003), eq. (F.4), p. 710: the backward sum `S_t = ∑_{k ≥ 0} μ₁ᵏ F_{t−k}` of the
forward terms `F_s = β⁻¹ ∑_j μ₂^{−j−1} E_s u_{s+j}`. -/
noncomputable def backSum (β κ lam : ℝ) (u : ℤ → Ω → ℝ) (t : ℤ) : Ω → ℝ :=
  fun ω => ∑' k : ℕ, m1 β κ lam ^ k * fwd 𝔽 β (m2 β κ lam) u (t - k) ω

/-- Woodford (2003), eq. (F.4), p. 710: the backward sum converges (`0 < μ₁ < 1`). -/
theorem backSum_summable {β κ lam M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) (t : ℤ) (ω : Ω) :
    Summable (fun k : ℕ => m1 β κ lam ^ k * fwd 𝔽 β (m2 β κ lam) u (t - k) ω) := by
  obtain ⟨h1, h2, h3, -⟩ := m_facts hβ hκ hlam
  exact summable_disc h1.le h2 (fun k => fwd_bounded 𝔽 h3 hu _ ω)

/-- Woodford (2003), eq. (F.4), p. 710: `S_t = F_t + μ₁ S_{t−1}`. -/
theorem backSum_succ {β κ lam M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) (t : ℤ) (ω : Ω) :
    backSum 𝔽 β κ lam u t ω =
      fwd 𝔽 β (m2 β κ lam) u t ω + m1 β κ lam * backSum 𝔽 β κ lam u (t - 1) ω := by
  simp only [backSum]
  rw [(backSum_summable 𝔽 hβ hκ hlam hu t ω).tsum_eq_zero_add, pow_zero, one_mul,
    Nat.cast_zero, sub_zero, ← tsum_mul_left]
  congr 1
  refine tsum_congr fun k => ?_
  have e : t - ((k + 1 : ℕ) : ℤ) = t - 1 - k := by push_cast; ring
  rw [e, pow_succ]
  ring

/-- Woodford (2003), eq. (F.4), p. 710: the backward sum is bounded. -/
theorem backSum_bounded {β κ lam M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) (t : ℤ) (ω : Ω) :
    |backSum 𝔽 β κ lam u t ω| ≤
      |β⁻¹ * (m2 β κ lam)⁻¹| * (M / (1 - (m2 β κ lam)⁻¹)) * (1 - m1 β κ lam)⁻¹ := by
  obtain ⟨h1, h2, h3, -⟩ := m_facts hβ hκ hlam
  have hg := (hasSum_geometric_of_lt_one h1.le h2).mul_left
    (|β⁻¹ * (m2 β κ lam)⁻¹| * (M / (1 - (m2 β κ lam)⁻¹)))
  have h := tsum_of_norm_bounded hg (f := fun k : ℕ =>
    m1 β κ lam ^ k * fwd 𝔽 β (m2 β κ lam) u (t - k) ω) (fun k => by
      rw [Real.norm_eq_abs, abs_mul, abs_pow, abs_of_pos h1, mul_comm]
      exact mul_le_mul_of_nonneg_right (fwd_bounded 𝔽 h3 hu _ ω) (pow_nonneg h1.le k))
  rw [Real.norm_eq_abs] at h
  exact h

/-- Woodford (2003), eq. (F.4), p. 710: the backward sum `S_t` is known at date `t`. -/
theorem backSum_adapted {β κ lam M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) (t : ℤ) :
    𝔽.E t (backSum 𝔽 β κ lam u t) = backSum 𝔽 β κ lam u t := by
  obtain ⟨h1, h2, h3, -⟩ := m_facts hβ hκ hlam
  funext ω
  have h := 𝔽.E_tsum_geom h1.le h2 (f := fun k : ℕ => fwd 𝔽 β (m2 β κ lam) u (t - k))
    (fun k ω' => fwd_bounded 𝔽 h3 hu _ ω') t ω
  change 𝔽.E t (fun ω' => ∑' k : ℕ, m1 β κ lam ^ k * fwd 𝔽 β (m2 β κ lam) u (t - k) ω') ω = _
  rw [h]
  refine tsum_congr fun k => ?_
  rw [𝔽.E_of_known (by omega) (fwd_adapted 𝔽 h3 hu (t - k))]

/-- Woodford (2003), eqs. (2.9)–(2.10) and (F.3)–(F.4): the double sums of the book,
`β⁻¹ ∑_{k ≥ 0} ∑_{j ≥ 0} μ₁ᵏ μ₂^{−j−1} E_{s−k} u_{s−k+j}`, equal the backward sum `S_s`. -/
theorem double_sum_eq {β κ lam : ℝ} (hβ : 0 < β) (u : ℤ → Ω → ℝ) (s : ℤ) (ω : Ω) :
    β⁻¹ * ∑' k : ℕ, ∑' j : ℕ, m1 β κ lam ^ k * (m2 β κ lam ^ (j + 1))⁻¹ *
      𝔽.E (s - k) (u (s - k + j)) ω = backSum 𝔽 β κ lam u s ω := by
  have hinner : ∀ k : ℕ, ∑' j : ℕ, m1 β κ lam ^ k * (m2 β κ lam ^ (j + 1))⁻¹ *
      𝔽.E (s - k) (u (s - k + j)) ω =
      β * (m1 β κ lam ^ k * fwd 𝔽 β (m2 β κ lam) u (s - k) ω) := by
    intro k
    simp only [fwd, mul_assoc, tsum_mul_left]
    field_simp
  simp only [hinner, tsum_mul_left, backSum]
  field_simp

/-- Woodford (2003), eq. (F.4), p. 710: the multiplier path
`φ_t = −(λ/κ) x* − β⁻¹ ∑_{k ≥ 1} ∑_{j ≥ 0} μ₁^{k−1} μ₂^{−j−1} E_{t+1−k} u_{t+1+j−k}`
(the book's `k ≥ 1` is `k + 1` here). -/
noncomputable def phiF4 (β κ lam xs : ℝ) (u : ℤ → Ω → ℝ) (t : ℤ) : Ω → ℝ :=
  fun ω => -(lam / κ) * xs - β⁻¹ * ∑' k : ℕ, ∑' j : ℕ,
    m1 β κ lam ^ k * (m2 β κ lam ^ (j + 1))⁻¹ * 𝔽.E (t + 1 - (k + 1)) (u (t + 1 + j - (k + 1))) ω

/-- Woodford (2003), eq. (2.10), p. 490 (= (F.1), p. 709): the constrained-optimal inflation
process `π_t = β⁻¹ ∑_j μ₂^{−j−1} E_t u_{t+j}
− β⁻¹ (1 − μ₁) ∑_{k ≥ 1} ∑_{j ≥ 0} μ₁^{k−1} μ₂^{−j−1} E_{t−k} u_{t+j−k}`
(the book's `k ≥ 1` is `k + 1` here). -/
noncomputable def infl210 (β κ lam : ℝ) (u : ℤ → Ω → ℝ) (t : ℤ) : Ω → ℝ :=
  fun ω => β⁻¹ * ∑' j : ℕ, (m2 β κ lam ^ (j + 1))⁻¹ * 𝔽.E t (u (t + j)) ω -
    β⁻¹ * (1 - m1 β κ lam) * ∑' k : ℕ, ∑' j : ℕ,
      m1 β κ lam ^ k * (m2 β κ lam ^ (j + 1))⁻¹ * 𝔽.E (t - (k + 1)) (u (t + j - (k + 1))) ω

/-- Woodford (2003), eq. (2.9), p. 489: the self-consistent initial constraint value
`π̄_{t₀}`. It is the expression (2.10) evaluated at the date `t₀`. -/
noncomputable def pibar29 (β κ lam : ℝ) (u : ℤ → Ω → ℝ) (t0 : ℤ) : Ω → ℝ :=
  infl210 𝔽 β κ lam u t0

/-- Woodford (2003), eq. (F.4), p. 710: `φ_t = −(λ/κ) x* − S_t`. -/
theorem phiF4_eq {β κ lam xs : ℝ} (hβ : 0 < β) (u : ℤ → Ω → ℝ) (t : ℤ) (ω : Ω) :
    phiF4 𝔽 β κ lam xs u t ω = -(lam / κ) * xs - backSum 𝔽 β κ lam u t ω := by
  rw [← double_sum_eq 𝔽 hβ u t ω, phiF4]
  congr 3
  funext k
  congr 1
  funext j
  have e1 : t + 1 - ((k : ℤ) + 1) = t - k := by ring
  have e2 : t + 1 + (j : ℤ) - ((k : ℤ) + 1) = t - k + j := by ring
  rw [e1, e2]

/-- Woodford (2003), eq. (2.10), p. 490: `π_t = F_t − (1 − μ₁) S_{t−1}`. -/
theorem infl210_eq {β κ lam : ℝ} (hβ : 0 < β) (u : ℤ → Ω → ℝ) (t : ℤ) (ω : Ω) :
    infl210 𝔽 β κ lam u t ω =
      fwd 𝔽 β (m2 β κ lam) u t ω - (1 - m1 β κ lam) * backSum 𝔽 β κ lam u (t - 1) ω := by
  rw [← double_sum_eq 𝔽 hβ u (t - 1) ω, infl210, fwd]
  have h : ∑' k : ℕ, ∑' j : ℕ, m1 β κ lam ^ k * (m2 β κ lam ^ (j + 1))⁻¹ *
      𝔽.E (t - (k + 1)) (u (t + j - (k + 1))) ω =
      ∑' k : ℕ, ∑' j : ℕ, m1 β κ lam ^ k * (m2 β κ lam ^ (j + 1))⁻¹ *
      𝔽.E (t - 1 - k) (u (t - 1 - k + j)) ω := by
    congr 1
    funext k
    congr 1
    funext j
    have e1 : t - ((k : ℤ) + 1) = t - 1 - k := by ring
    have e2 : t + (j : ℤ) - ((k : ℤ) + 1) = t - 1 - k + j := by ring
    rw [e1, e2]
  rw [h]
  ring

/-- Woodford (2003), eqs. (F.4) and (2.7), p. 710: the path (F.4) satisfies (2.7) at every
date ("proceeding recursively"). -/
theorem phiF4_rec27 {β κ lam xs M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) (t : ℤ) :
    Rec27 𝔽 β κ lam xs u (phiF4 𝔽 β κ lam xs u) t := by
  rw [Rec27]
  funext ω
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  rw [phiF4_eq 𝔽 hβ, phiF4_eq 𝔽 hβ, backSum_succ 𝔽 hβ hκ hlam hu]
  ring

/-- Woodford (2003), eq. (F.4), p. 710: the path (F.4) is bounded. -/
theorem phiF4_bounded {β κ lam xs M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) (t : ℤ) (ω : Ω) :
    |phiF4 𝔽 β κ lam xs u t ω| ≤ |lam / κ * xs| +
      |β⁻¹ * (m2 β κ lam)⁻¹| * (M / (1 - (m2 β κ lam)⁻¹)) * (1 - m1 β κ lam)⁻¹ := by
  rw [phiF4_eq 𝔽 hβ, neg_mul, sub_eq_add_neg, ← neg_add, abs_neg]
  exact abs_add_le_of le_rfl (backSum_bounded 𝔽 hβ hκ hlam hu t ω)

/-- Woodford (2003), eq. (F.4), p. 710: `φ_t` of (F.4) is known at date `t`. -/
theorem phiF4_adapted {β κ lam xs M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) (t : ℤ) :
    𝔽.E t (phiF4 𝔽 β κ lam xs u t) = phiF4 𝔽 β κ lam xs u t := by
  have h : phiF4 𝔽 β κ lam xs u t = (fun _ => -(lam / κ) * xs) - backSum 𝔽 β κ lam u t := by
    funext ω
    rw [phiF4_eq 𝔽 hβ, Pi.sub_apply]
  rw [h, map_sub, 𝔽.const, backSum_adapted 𝔽 hβ hκ hlam hu]

/-- Woodford (2003), App. F.1, p. 710: "substitution of (F.4) into (1.7) then yields (F.1)":
`π_t = φ_{t−1} − φ_t` along (F.4) is exactly (2.10). -/
theorem infl210_eq_planInfl {β κ lam xs M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) :
    infl210 𝔽 β κ lam u = planInfl (phiF4 𝔽 β κ lam xs u) := by
  funext t ω
  simp only [planInfl, Pi.sub_apply]
  rw [infl210_eq 𝔽 hβ, phiF4_eq 𝔽 hβ, phiF4_eq 𝔽 hβ, backSum_succ 𝔽 hβ hκ hlam hu t]
  ring

/-- Woodford (2003), p. 489: a multiplier path that satisfies (2.7) from `t₀` is the recursive
solution from its own initial value `φ_{t₀−1}`. -/
theorem eq_multPath {β κ lam xs : ℝ} {u ψ : ℤ → Ω → ℝ} {t0 : ℤ}
    (hrec : ∀ t, t0 ≤ t → Rec27 𝔽 β κ lam xs u ψ t) :
    ∀ t, t0 - 1 ≤ t → ψ t = multPath 𝔽 β κ lam xs u (ψ (t0 - 1)) t0 t := by
  refine eq_backSol rfl fun t ht => ?_
  rw [hrec t ht]
  funext ω
  simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  ring

/-- Woodford (2003), eq. (F.3), p. 710: the initial multiplier consistent with the constraint
(2.8)–(2.9) is `φ_{t₀−1} = −(λ/κ) x* − β⁻¹ ∑_{k ≥ 1} ∑_j μ₁^{k−1} μ₂^{−j−1} E_{t₀−k} u_{t₀+j−k}`,
i.e. the value at `t₀ − 1` of (F.4). -/
theorem F3 {β κ lam xs M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam) {u : ℤ → Ω → ℝ}
    (hu : ∀ t ω, |u t ω| ≤ M) (t0 : ℤ) :
    initMult 𝔽 β κ lam xs u (pibar29 𝔽 β κ lam u t0) t0 = phiF4 𝔽 β κ lam xs u (t0 - 1) := by
  symm
  refine initMult_unique 𝔽 hβ hκ hlam ?_
  have hpath := eq_multPath 𝔽 (fun t _ => phiF4_rec27 𝔽 (xs := xs) hβ hκ hlam hu t) (t0 := t0)
  simp only [planInfl]
  rw [← hpath t0 (by omega), ← hpath (t0 - 1) le_rfl, pibar29,
    infl210_eq_planInfl 𝔽 (xs := xs) hβ hκ hlam hu]
  rfl

/-- Woodford (2003), eq. (F.4), p. 710 ("proceeding recursively, one similarly obtains (F.4)
for arbitrary `t ≥ t₀ − 1`"): the multiplier path of the constrained optimum with constraint
(2.9) is (F.4). -/
theorem F4 {β κ lam xs M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam) {u : ℤ → Ω → ℝ}
    (hu : ∀ t ω, |u t ω| ≤ M) (t0 : ℤ) :
    ∀ t, t0 - 1 ≤ t → multPath 𝔽 β κ lam xs u (initMult 𝔽 β κ lam xs u
      (pibar29 𝔽 β κ lam u t0) t0) t0 t = phiF4 𝔽 β κ lam xs u t := by
  intro t ht
  rw [F3 𝔽 hβ hκ hlam hu,
    ← eq_multPath 𝔽 (fun t _ => phiF4_rec27 𝔽 (xs := xs) hβ hκ hlam hu t) t ht]

/-- Woodford (2003), **Proposition 7.6**, p. 490 (proof App. F.1): for every date `t₀`, the
inflation process (2.10), with output gap `x_t = x* + (κ/λ) φ_t` along (F.4), is the
state-contingent evolution that **minimises** the expected discounted loss from `t₀` among all
bounded feasible plans subject to the initial constraint (2.8) with `π̄_{t₀}` given by (2.9).
Optimality is proved by Lagrangian sufficiency under any expectation system with the pull-out
property. -/
theorem prop_7_6 (hPO : 𝔽.PullOut) {β κ lam xs M : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1)
    (hκ : 0 < κ) (hlam : 0 < lam) {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hua : ∀ t, 𝔽.E t (u t) = u t) (t0 : ℤ) :
    IsOptimal 𝔽 β κ lam xs u t0 (fun π' => π' t0 = pibar29 𝔽 β κ lam u t0)
      (infl210 𝔽 β κ lam u) (planGap κ lam xs (phiF4 𝔽 β κ lam xs u)) := by
  have h := plan_isOptimal 𝔽 hPO hβ0 hβ1 hκ hlam hu hua (xs := xs)
    (fun t _ => phiF4_rec27 𝔽 hβ0 hκ hlam hu t)
    (𝔽.E_of_known (by omega) (phiF4_adapted 𝔽 hβ0 hκ hlam hu (t0 - 1)))
    (fun t _ ω => phiF4_bounded 𝔽 hβ0 hκ hlam hu t ω)
  rw [← infl210_eq_planInfl 𝔽 hβ0 hκ hlam hu] at h
  exact h

/-- Woodford (2003), **Proposition 7.6**, p. 490, uniqueness ("is given by (2.10) for all
`t ≥ t₀`"): with a faithful expectation system, every optimal plan subject to (2.8)–(2.9) has
inflation (2.10) and output gap `x* + (κ/λ) φ_t` at every `t ≥ t₀`. -/
theorem prop_7_6_unique (hPO : 𝔽.PullOut) (hF : 𝔽.Faithful) {β κ lam xs M : ℝ}
    (hβ0 : 0 < β) (hβ1 : β < 1) (hκ : 0 < κ) (hlam : 0 < lam) {u : ℤ → Ω → ℝ}
    (hu : ∀ t ω, |u t ω| ≤ M) (hua : ∀ t, 𝔽.E t (u t) = u t) {t0 : ℤ} {π' x' : ℤ → Ω → ℝ}
    (hopt : IsOptimal 𝔽 β κ lam xs u t0 (fun π' => π' t0 = pibar29 𝔽 β κ lam u t0) π' x') :
    ∀ t, t0 ≤ t → π' t = infl210 𝔽 β κ lam u t ∧
      x' t = planGap κ lam xs (phiF4 𝔽 β κ lam xs u) t := by
  have hC : pibar29 𝔽 β κ lam u t0 = planInfl (phiF4 𝔽 β κ lam xs u) t0 := by
    rw [pibar29, infl210_eq_planInfl 𝔽 hβ0 hκ hlam hu]
  rw [hC] at hopt
  have h := plan_unique 𝔽 hPO hF hβ0 hβ1 hκ hlam hu hua (xs := xs) (t0 := t0)
    (fun t _ => phiF4_rec27 𝔽 hβ0 hκ hlam hu t)
    (𝔽.E_of_known (by omega) (phiF4_adapted 𝔽 hβ0 hκ hlam hu (t0 - 1)))
    (fun t _ ω => phiF4_bounded 𝔽 hβ0 hκ hlam hu t ω) hopt
  rw [← infl210_eq_planInfl 𝔽 hβ0 hκ hlam hu] at h
  exact h

/-- Woodford (2003), p. 490 ("in the constrained-optimal evolution, inflation in every period
after `t₀` is chosen to be the same time-invariant function of past disturbances as it has
been constrained to be in period `t₀`"): the plan (2.10) is **timelessly optimal** for the
specification (2.9). -/
theorem prop_7_6_timeless (hPO : 𝔽.PullOut) {β κ lam xs M : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1)
    (hκ : 0 < κ) (hlam : 0 < lam) {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hua : ∀ t, 𝔽.E t (u t) = u t) (t0 : ℤ) :
    TimelesslyOptimal 𝔽 β κ lam xs u t0 (pibar29 𝔽 β κ lam u) (infl210 𝔽 β κ lam u)
      (planGap κ lam xs (phiF4 𝔽 β κ lam xs u)) :=
  fun t1 _ => prop_7_6 𝔽 hPO hβ0 hβ1 hκ hlam hu hua t1


/-! ### The uniqueness claim of p. 490: the limit `t₀ → −∞` -/

/-- Woodford (2003), p. 490 and fn. 19: the limit of the backward solution of (2.7),
`∑_k μ₁ᵏ (−(1 − μ₁)(λ/κ) x* − F_{s−k})`, is the multiplier (F.4). -/
theorem tsum_forcing_eq_phiF4 {β κ lam xs M : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) (s : ℤ) (ω : Ω) :
    ∑' k : ℕ, m1 β κ lam ^ k *
      -((1 - m1 β κ lam) * (lam / κ) * xs + fwd 𝔽 β (m2 β κ lam) u (s - k) ω) =
      phiF4 𝔽 β κ lam xs u s ω := by
  obtain ⟨h1, h2, -⟩ := m_facts hβ hκ hlam
  have hg : Summable (fun k : ℕ => -((1 - m1 β κ lam) * (lam / κ) * xs) * m1 β κ lam ^ k) :=
    (summable_geometric_of_lt_one h1.le h2).mul_left _
  have hb := (backSum_summable 𝔽 hβ hκ hlam hu s ω).neg
  have hterm : ∀ k : ℕ, m1 β κ lam ^ k *
      -((1 - m1 β κ lam) * (lam / κ) * xs + fwd 𝔽 β (m2 β κ lam) u (s - k) ω) =
      -((1 - m1 β κ lam) * (lam / κ) * xs) * m1 β κ lam ^ k +
        -(m1 β κ lam ^ k * fwd 𝔽 β (m2 β κ lam) u (s - k) ω) := fun k => by ring
  simp_rw [hterm]
  rw [hg.tsum_add hb, tsum_mul_left, tsum_geometric_of_lt_one h1.le h2, tsum_neg,
    phiF4_eq 𝔽 hβ, backSum]
  have hne : 1 - m1 β κ lam ≠ 0 := by linarith
  field_simp
  ring

/-- Woodford (2003), p. 490 and footnote 19 (**independence of the initial multiplier**):
whatever the (uniformly bounded) initial multipliers `φ_{t₀−1}`, the inflation rate at a fixed
date `t` generated by (2.7) from `t₀` converges, as `t₀ → −∞`, to (2.10). -/
theorem limit_indep_initial {β κ lam xs M A : ℝ} (hβ : 0 < β) (hκ : 0 < κ) (hlam : 0 < lam)
    {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M) {φ0 : ℤ → Ω → ℝ} (hφ0 : ∀ s ω, |φ0 s ω| ≤ A)
    (t : ℤ) (ω : Ω) :
    Tendsto (fun t0 => planInfl (multPath 𝔽 β κ lam xs u (φ0 t0) t0) t ω) atBot
      (𝓝 (infl210 𝔽 β κ lam u t ω)) := by
  obtain ⟨h1, h2, -⟩ := m_facts hβ hκ hlam
  have hg := forcing27_bounded 𝔽 (xs := xs) hβ hκ hlam hu
  have l1 := backSol_tendsto h1.le h2 hφ0 hg (t - 1) ω
  have l2 := backSol_tendsto h1.le h2 hφ0 hg t ω
  rw [tsum_forcing_eq_phiF4 𝔽 hβ hκ hlam hu] at l1 l2
  rw [infl210_eq_planInfl 𝔽 (xs := xs) hβ hκ hlam hu]
  exact l1.sub l2

/-- Woodford (2003), p. 490: a specification `P` of the initial constraint value as a process
(a function of the state, fixed independently of the plan) is **self-consistent** when, for
every date `t₀`, the plan following `P` is optimal from `t₀` subject to `π_{t₀} = P_{t₀}`
(the constrained-optimal evolution keeps satisfying the same rule). -/
def SelfConsistent (β κ lam xs : ℝ) (u P : ℤ → Ω → ℝ) : Prop :=
  ∀ t0, ∃ x, IsOptimal 𝔽 β κ lam xs u t0 (fun π' => π' t0 = P t0) P x

/-- Woodford (2003), p. 490: (2.9)/(2.10) is self-consistent. -/
theorem infl210_selfConsistent (hPO : 𝔽.PullOut) {β κ lam xs M : ℝ} (hβ0 : 0 < β)
    (hβ1 : β < 1) (hκ : 0 < κ) (hlam : 0 < lam) {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hua : ∀ t, 𝔽.E t (u t) = u t) : SelfConsistent 𝔽 β κ lam xs u (infl210 𝔽 β κ lam u) :=
  fun t0 => ⟨_, prop_7_6 𝔽 hPO hβ0 hβ1 hκ hlam hu hua t0⟩

/-- Woodford (2003), p. 490 (**(2.9) is the only self-consistent specification depending only
on the history of exogenous disturbances**): with a faithful expectation system, every bounded
self-consistent specification `P` is (2.10). Proof as in the book: the constrained-optimal
evolution from `t₀` follows (2.7) for some `φ_{t₀−1}`, and letting `t₀ → −∞` gives (2.10)
whatever the initial multipliers. -/
theorem selfConsistent_unique (hPO : 𝔽.PullOut) (hF : 𝔽.Faithful) {β κ lam xs M A : ℝ}
    (hβ0 : 0 < β) (hβ1 : β < 1) (hκ : 0 < κ) (hlam : 0 < lam) {u P : ℤ → Ω → ℝ}
    (hu : ∀ t ω, |u t ω| ≤ M) (hua : ∀ t, 𝔽.E t (u t) = u t) (hPb : ∀ t ω, |P t ω| ≤ A)
    (hP : SelfConsistent 𝔽 β κ lam xs u P) : P = infl210 𝔽 β κ lam u := by
  have hknown : ∀ t0, 𝔽.E t0 (P t0) = P t0 := fun t0 => by
    obtain ⟨x, hx⟩ := hP t0
    exact (hx.1.2.1 t0 le_rfl).1
  have heq : ∀ t0 t, t0 ≤ t → P t = planInfl (multPath 𝔽 β κ lam xs u
      (initMult 𝔽 β κ lam xs u (P t0) t0) t0) t := fun t0 t ht => by
    obtain ⟨x, hx⟩ := hP t0
    exact (constrained_optimum_unique 𝔽 hPO hF hβ0 hβ1 hκ hlam hu hua (hknown t0) (hPb t0) hx
      t ht).1
  funext t ω
  have hlim := limit_indep_initial 𝔽 (xs := xs) hβ0 hκ hlam hu
    (φ0 := fun t0 => initMult 𝔽 β κ lam xs u (P t0) t0)
    (fun s ω' => initMult_bounded 𝔽 hβ0 hκ hlam hu (hPb s) s ω') t ω
  have hlim2 : Tendsto (fun t0 => planInfl (multPath 𝔽 β κ lam xs u
      (initMult 𝔽 β κ lam xs u (P t0) t0) t0) t ω) atBot (𝓝 (P t ω)) := by
    refine tendsto_const_nhds.congr' (eventually_atBot.2 ⟨t, fun s hs => ?_⟩)
    exact congrFun (heq s t hs) ω
  exact tendsto_nhds_unique hlim2 hlim

/-- Woodford (2003), p. 490: for bounded specifications and a faithful expectation system,
`P` is self-consistent **if and only if** it is (2.10). -/
theorem selfConsistent_iff (hPO : 𝔽.PullOut) (hF : 𝔽.Faithful) {β κ lam xs M A : ℝ}
    (hβ0 : 0 < β) (hβ1 : β < 1) (hκ : 0 < κ) (hlam : 0 < lam) {u P : ℤ → Ω → ℝ}
    (hu : ∀ t ω, |u t ω| ≤ M) (hua : ∀ t, 𝔽.E t (u t) = u t) (hPb : ∀ t ω, |P t ω| ≤ A) :
    SelfConsistent 𝔽 β κ lam xs u P ↔ P = infl210 𝔽 β κ lam u := by
  constructor
  · exact selfConsistent_unique 𝔽 hPO hF hβ0 hβ1 hκ hlam hu hua hPb
  · rintro rfl
    exact infl210_selfConsistent 𝔽 hPO hβ0 hβ1 hκ hlam hu hua

/-! ### Proposition 7.7 -/

/-- Woodford (2003), eq. (2.11), p. 490: the initial constraint value
`π̄_{t₀} = (1 − μ₁)(λ/κ) x_{t₀−1} + β⁻¹ ∑_j μ₂^{−j−1} E_{t₀} u_{t₀+j}`, where `x_{t₀−1}` is the
predetermined output gap. -/
noncomputable def pibar211 (β κ lam : ℝ) (u : ℤ → Ω → ℝ) (xprev : Ω → ℝ) (t0 : ℤ) : Ω → ℝ :=
  fun ω => (1 - m1 β κ lam) * (lam / κ) * xprev ω +
    β⁻¹ * ∑' j : ℕ, (m2 β κ lam ^ (j + 1))⁻¹ * 𝔽.E t0 (u (t0 + j)) ω

/-- Woodford (2003), Prop. 7.7, p. 491: the initial multiplier `φ_{t₀−1} = (λ/κ)(x_{t₀−1} − x*)`
that solves (F.2) with the constraint (2.11). -/
noncomputable def init211 (κ lam xs : ℝ) (xprev : Ω → ℝ) : Ω → ℝ :=
  fun ω => lam / κ * (xprev ω - xs)

/-- Woodford (2003), Prop. 7.7, p. 491: `init211` is known at `t₀` when `x_{t₀−1}` is. -/
theorem init211_known {κ lam xs : ℝ} {xprev : Ω → ℝ} {t0 : ℤ} (hx : 𝔽.E t0 xprev = xprev) :
    𝔽.E t0 (init211 κ lam xs xprev) = init211 κ lam xs xprev := by
  have h : init211 κ lam xs xprev = (lam / κ) • xprev - fun _ => lam / κ * xs := by
    funext ω
    simp only [init211, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    ring
  rw [h, map_sub, map_smul, hx, 𝔽.const]

/-- Woodford (2003), Prop. 7.7, p. 491: `init211` is bounded when `x_{t₀−1}` is. -/
theorem init211_bounded {κ lam xs A : ℝ} {xprev : Ω → ℝ} (hx : ∀ ω, |xprev ω| ≤ A) (ω : Ω) :
    |init211 κ lam xs xprev ω| ≤ |lam / κ| * (A + |xs|) :=
  abs_mul_le_of le_rfl (abs_sub_le_of (hx ω) le_rfl)

/-- Woodford (2003), Prop. 7.7, p. 491: along the plan generated from `init211`, the output
gap at `t₀ − 1` is the given predetermined value `x_{t₀−1}`. -/
theorem prop_7_7_gap_init {β κ lam xs : ℝ} (hκ : 0 < κ) (hlam : 0 < lam) (u : ℤ → Ω → ℝ)
    (xprev : Ω → ℝ) (t0 : ℤ) :
    planGap κ lam xs (multPath 𝔽 β κ lam xs u (init211 κ lam xs xprev) t0) (t0 - 1) = xprev := by
  funext ω
  rw [planGap, multPath_init, init211]
  field_simp
  ring

/-- Woodford (2003), **Proposition 7.7**, p. 491, eq. (2.12): along the constrained-optimal
plan with initial constraint (2.11), inflation satisfies
`π_t = (1 − μ₁)(λ/κ) x_{t−1} + β⁻¹ ∑_j μ₂^{−j−1} E_t u_{t+j}` at every `t ≥ t₀` (with
`x_{t₀−1}` the predetermined value, `prop_7_7_gap_init`). -/
theorem prop_7_7 {β κ lam xs : ℝ} (hκ : 0 < κ) (hlam : 0 < lam) (u : ℤ → Ω → ℝ)
    (xprev : Ω → ℝ) {t0 t : ℤ} (ht : t0 ≤ t) (ω : Ω) :
    planInfl (multPath 𝔽 β κ lam xs u (init211 κ lam xs xprev) t0) t ω =
      (1 - m1 β κ lam) * (lam / κ) *
        planGap κ lam xs (multPath 𝔽 β κ lam xs u (init211 κ lam xs xprev) t0) (t - 1) ω +
      β⁻¹ * ∑' j : ℕ, (m2 β κ lam ^ (j + 1))⁻¹ * 𝔽.E t (u (t + j)) ω := by
  rw [planInfl_F2 𝔽 (multPath_rec27 𝔽 β κ lam xs u _ ht), planGap]
  change _ = _ + fwd 𝔽 β (m2 β κ lam) u t ω
  field_simp
  ring

/-- Woodford (2003), **Proposition 7.7**, p. 491, optimality: the plan generated from
`init211` is optimal from `t₀` subject to the initial constraint (2.11). -/
theorem prop_7_7_optimal (hPO : 𝔽.PullOut) {β κ lam xs M A : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1)
    (hκ : 0 < κ) (hlam : 0 < lam) {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hua : ∀ t, 𝔽.E t (u t) = u t) {xprev : Ω → ℝ} {t0 : ℤ} (hx : 𝔽.E t0 xprev = xprev)
    (hxb : ∀ ω, |xprev ω| ≤ A) :
    IsOptimal 𝔽 β κ lam xs u t0 (fun π' => π' t0 = pibar211 𝔽 β κ lam u xprev t0)
      (planInfl (multPath 𝔽 β κ lam xs u (init211 κ lam xs xprev) t0))
      (planGap κ lam xs (multPath 𝔽 β κ lam xs u (init211 κ lam xs xprev) t0)) := by
  have h := plan_isOptimal 𝔽 hPO hβ0 hβ1 hκ hlam hu hua
    (fun t ht => multPath_rec27 𝔽 β κ lam xs u (init211 κ lam xs xprev) ht)
    (by rw [multPath_init]; exact init211_known 𝔽 hx)
    (fun t _ ω => multPath_bounded 𝔽 hβ0 hκ hlam hu (init211_bounded hxb) t0 t ω)
  have hval : planInfl (multPath 𝔽 β κ lam xs u (init211 κ lam xs xprev) t0) t0 =
      pibar211 𝔽 β κ lam u xprev t0 := by
    funext ω
    rw [prop_7_7 𝔽 hκ hlam u xprev le_rfl, prop_7_7_gap_init 𝔽 hκ hlam]
    rfl
  rwa [hval] at h

/-- Woodford (2003), **Proposition 7.7**, p. 491, uniqueness: with a faithful expectation
system every optimal plan subject to (2.11) satisfies (2.12) at every `t > t₀` (and (2.11) at
`t₀`). -/
theorem prop_7_7_unique (hPO : 𝔽.PullOut) (hF : 𝔽.Faithful) {β κ lam xs M A : ℝ}
    (hβ0 : 0 < β) (hβ1 : β < 1) (hκ : 0 < κ) (hlam : 0 < lam) {u : ℤ → Ω → ℝ}
    (hu : ∀ t ω, |u t ω| ≤ M) (hua : ∀ t, 𝔽.E t (u t) = u t) {xprev : Ω → ℝ} {t0 : ℤ}
    (hx : 𝔽.E t0 xprev = xprev) (hxb : ∀ ω, |xprev ω| ≤ A) {π' x' : ℤ → Ω → ℝ}
    (hopt : IsOptimal 𝔽 β κ lam xs u t0 (fun π' => π' t0 = pibar211 𝔽 β κ lam u xprev t0)
      π' x') :
    ∀ t, t0 < t → ∀ ω, π' t ω = (1 - m1 β κ lam) * (lam / κ) * x' (t - 1) ω +
      β⁻¹ * ∑' j : ℕ, (m2 β κ lam ^ (j + 1))⁻¹ * 𝔽.E t (u (t + j)) ω := by
  have hval : pibar211 𝔽 β κ lam u xprev t0 =
      planInfl (multPath 𝔽 β κ lam xs u (init211 κ lam xs xprev) t0) t0 := by
    funext ω
    rw [prop_7_7 𝔽 hκ hlam u xprev le_rfl, prop_7_7_gap_init 𝔽 hκ hlam]
    rfl
  rw [hval] at hopt
  have hu' := plan_unique 𝔽 hPO hF hβ0 hβ1 hκ hlam hu hua
    (fun t ht => multPath_rec27 𝔽 β κ lam xs u (init211 κ lam xs xprev) ht)
    (by rw [multPath_init]; exact init211_known 𝔽 hx)
    (fun t _ ω => multPath_bounded 𝔽 hβ0 hκ hlam hu (init211_bounded hxb) t0 t ω) hopt
  intro t ht ω
  rw [(hu' t ht.le).1, (hu' (t - 1) (by omega)).2, prop_7_7 𝔽 hκ hlam u xprev ht.le]

/-- Woodford (2003), p. 491 ("a time-invariant policy rule that results in a determinate
equilibrium in which the inflation rate always satisfies (2.12) is optimal from a timeless
perspective"): every feasible plan from `t₀` that satisfies (2.12) at every `t ≥ t₀` (with a
bounded predetermined `x_{t₀−1}`) is **timelessly optimal** for the constraint specification
(2.11) built from its own lagged output gap. -/
theorem rule_212_timeless (hPO : 𝔽.PullOut) {β κ lam xs M A : ℝ} (hβ0 : 0 < β)
    (hβ1 : β < 1) (hκ : 0 < κ) (hlam : 0 < lam) {u π x : ℤ → Ω → ℝ} {t0 : ℤ}
    (hu : ∀ t ω, |u t ω| ≤ M) (hua : ∀ t, 𝔽.E t (u t) = u t)
    (hf : Feasible 𝔽 β κ u t0 π x)
    (hx0b : ∀ ω, |x (t0 - 1) ω| ≤ A)
    (h212 : ∀ t, t0 ≤ t → ∀ ω, π t ω = (1 - m1 β κ lam) * (lam / κ) * x (t - 1) ω +
      fwd 𝔽 β (m2 β κ lam) u t ω) :
    TimelesslyOptimal 𝔽 β κ lam xs u t0
      (fun t1 => pibar211 𝔽 β κ lam u (x (t1 - 1)) t1) π x := by
  obtain ⟨hm0, hm1, hm2, -, hprod, hkey⟩ := m_facts hβ0 hκ hlam
  obtain ⟨hAS, hAd, Mx, hMx⟩ := hf
  set φ : ℤ → Ω → ℝ := fun t ω => lam / κ * (x t ω - xs) with hφ
  have hββ : β * β⁻¹ = 1 := mul_inv_cancel₀ hβ0.ne'
  have hcL : κ ^ 2 / lam * (lam / κ) = κ := by field_simp
  have hpos : β * m2 β κ lam * (1 - m1 β κ lam) ≠ 0 := by
    have : 0 < β * m2 β κ lam * (1 - m1 β κ lam) :=
      mul_pos (mul_pos hβ0 (by linarith)) (by linarith)
    exact this.ne'
  -- the solved law (2.7) for `φ = (λ/κ)(x − x*)`
  have hrec : ∀ t, t0 ≤ t → ∀ ω, φ t ω = m1 β κ lam * φ (t - 1) ω -
      (1 - m1 β κ lam) * (lam / κ) * xs - fwd 𝔽 β (m2 β κ lam) u t ω := by
    intro t ht ω
    have eA := congrFun (hAS t ht) ω
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at eA
    have eB := h212 t ht ω
    have hπ1 : π (t + 1) = (fun ω => (1 - m1 β κ lam) * (lam / κ) * x t ω) +
        fwd 𝔽 β (m2 β κ lam) u (t + 1) := by
      funext ω'
      rw [h212 (t + 1) (by omega) ω', add_sub_cancel_right, Pi.add_apply]
    have eP : 𝔽.E t (π (t + 1)) ω = (1 - m1 β κ lam) * (lam / κ) * x t ω +
        (m2 β κ lam * fwd 𝔽 β (m2 β κ lam) u t ω - β⁻¹ * u t ω) := by
      have hx : (fun ω => (1 - m1 β κ lam) * (lam / κ) * x t ω) =
          ((1 - m1 β κ lam) * (lam / κ)) • x t := by
        funext ω'
        simp
      rw [hπ1, map_add, hx, map_smul, (hAd t ht).2, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
        fwd_E_succ 𝔽 hm2 hu hua]
    rw [eP] at eA
    have hG : β * m2 β κ lam * (1 - m1 β κ lam) * (lam / κ * x t ω -
        m1 β κ lam * (lam / κ) * x (t - 1) ω + fwd 𝔽 β (m2 β κ lam) u t ω) = 0 := by
      linear_combination eB - eA + u t ω * hββ + lam / κ * x t ω * hkey + x t ω * hcL -
        ((1 - m1 β κ lam) * (lam / κ) * x (t - 1) ω + fwd 𝔽 β (m2 β κ lam) u t ω) * hprod
    have hG' := (mul_eq_zero.mp hG).resolve_left hpos
    simp only [hφ]
    linear_combination hG'
  have hφa : ∀ t, t0 ≤ t → 𝔽.E t (φ t) = φ t := by
    intro t ht
    have h : φ t = (lam / κ) • x t - fun _ => lam / κ * xs := by
      funext ω
      simp only [hφ, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
      ring
    rw [h, map_sub, map_smul, (hAd t ht).2, 𝔽.const]
  have hφb : ∀ t, t0 - 1 ≤ t → ∀ ω, |φ t ω| ≤ |lam / κ| * ((|Mx| + A) + |xs|) := by
    intro t ht ω
    refine abs_mul_le_of le_rfl (abs_sub_le_of ?_ le_rfl)
    rcases eq_or_lt_of_le ht with h | h
    · rw [← h]
      linarith [hx0b ω, abs_nonneg Mx]
    · linarith [(hMx t (by omega) ω).2, le_abs_self Mx, (abs_nonneg _).trans (hx0b ω)]
  have hfoc : FOC κ lam xs t0 π x φ := by
    intro t ht ω
    refine ⟨?_, ?_⟩
    · have e := hrec t ht ω
      rw [h212 t ht ω]
      simp only [hφ] at e ⊢
      linear_combination e
    · simp only [hφ]
      field_simp
      ring
  intro t1 ht1
  have hf1 : Feasible 𝔽 β κ u t1 π x :=
    ⟨fun t ht => hAS t (by omega), fun t ht => hAd t (by omega),
      Mx, fun t ht => hMx t (by omega)⟩
  refine isOptimal_of_foc 𝔽 hPO hβ0 hβ1 hlam.le hf1 ?_ (fun t ht => hφa t (by omega))
    ⟨_, fun t ht => hφb t (by omega)⟩ (fun t ht => hfoc t (by omega)) ?_
  · funext ω
    rw [h212 t1 ht1 ω]
    rfl
  · intro π' hπ' ω
    have h1 : π' t1 ω = π t1 ω := by
      rw [hπ', h212 t1 ht1 ω]
      rfl
    rw [h1, sub_self, mul_zero]


/-! ### Proposition 7.8: the price-level form -/

/-- Woodford (2003), eq. (2.13), p. 491: the initial constraint value
`π̄_{t₀} = −(1 − μ₁)(p_{t₀−1} − p̄) + β⁻¹ ∑_j μ₂^{−j−1} E_{t₀} u_{t₀+j}` with target price level
`p̄` (allowed to be any variable known at `t₀`; the book takes a constant). -/
noncomputable def pibar213 (β κ lam : ℝ) (u : ℤ → Ω → ℝ) (pprev pbar : Ω → ℝ) (t0 : ℤ) :
    Ω → ℝ :=
  fun ω => -(1 - m1 β κ lam) * (pprev ω - pbar ω) +
    β⁻¹ * ∑' j : ℕ, (m2 β κ lam ^ (j + 1))⁻¹ * 𝔽.E t0 (u (t0 + j)) ω

/-- Woodford (2003), eq. (2.14), p. 491: the equivalent constraint on the initial price level,
`p̄_{t₀} = (1 − μ₁) p̄ + μ₁ p_{t₀−1} + β⁻¹ ∑_j μ₂^{−j−1} E_{t₀} u_{t₀+j}`. -/
noncomputable def pbar214 (β κ lam : ℝ) (u : ℤ → Ω → ℝ) (pprev pbar : Ω → ℝ) (t0 : ℤ) :
    Ω → ℝ :=
  fun ω => (1 - m1 β κ lam) * pbar ω + m1 β κ lam * pprev ω +
    β⁻¹ * ∑' j : ℕ, (m2 β κ lam ^ (j + 1))⁻¹ * 𝔽.E t0 (u (t0 + j)) ω

/-- Woodford (2003), p. 491: the constraints (2.13) on `π_{t₀}` and (2.14) on `p_{t₀}` are
equivalent, given `p_{t₀} = p_{t₀−1} + π_{t₀}`. -/
theorem constraint_213_iff_214 (β κ lam : ℝ) (u : ℤ → Ω → ℝ) {π' p : ℤ → Ω → ℝ}
    {pprev pbar : Ω → ℝ} {t0 : ℤ} (hp : p t0 = pprev + π' t0) :
    π' t0 = pibar213 𝔽 β κ lam u pprev pbar t0 ↔ p t0 = pbar214 𝔽 β κ lam u pprev pbar t0 := by
  constructor
  · intro h
    funext ω
    have h1 := congrFun h ω
    have h2 := congrFun hp ω
    simp only [pibar213, pbar214, Pi.add_apply] at h1 h2 ⊢
    linarith
  · intro h
    funext ω
    have h1 := congrFun h ω
    have h2 := congrFun hp ω
    simp only [pibar213, pbar214, Pi.add_apply] at h1 h2 ⊢
    linarith

/-- Woodford (2003), App. F.3, p. 712: the initial multiplier consistent with (2.13),
`φ_{t₀−1} = −(λ/κ) x* − (p_{t₀−1} − p̄)`. -/
noncomputable def init213 (κ lam xs : ℝ) (pprev pbar : Ω → ℝ) : Ω → ℝ :=
  fun ω => -(lam / κ) * xs - (pprev ω - pbar ω)

/-- Woodford (2003), p. 712: `init213` is known at `t₀`. -/
theorem init213_known {κ lam xs : ℝ} {pprev pbar : Ω → ℝ} {t0 : ℤ}
    (hp : 𝔽.E t0 pprev = pprev) (hb : 𝔽.E t0 pbar = pbar) :
    𝔽.E t0 (init213 κ lam xs pprev pbar) = init213 κ lam xs pprev pbar := by
  have h : init213 κ lam xs pprev pbar = (fun _ => -(lam / κ) * xs) - (pprev - pbar) := by
    funext ω
    simp [init213]
  rw [h, map_sub, map_sub, hp, hb, 𝔽.const]

/-- Woodford (2003), p. 712: `init213` is bounded. -/
theorem init213_bounded {κ lam xs A B : ℝ} {pprev pbar : Ω → ℝ} (hp : ∀ ω, |pprev ω| ≤ A)
    (hb : ∀ ω, |pbar ω| ≤ B) (ω : Ω) :
    |init213 κ lam xs pprev pbar ω| ≤ |-(lam / κ) * xs| + (A + B) :=
  abs_sub_le_of le_rfl (abs_sub_le_of (hp ω) (hb ω))

/-- Woodford (2003), **Proposition 7.8**, p. 491, optimality: the plan generated by (2.7) from
`init213` is optimal from `t₀` subject to the initial constraint (2.13). -/
theorem prop_7_8_optimal (hPO : 𝔽.PullOut) {β κ lam xs M A B : ℝ} (hβ0 : 0 < β)
    (hβ1 : β < 1) (hκ : 0 < κ) (hlam : 0 < lam) {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hua : ∀ t, 𝔽.E t (u t) = u t) {pprev pbar : Ω → ℝ} {t0 : ℤ}
    (hp : 𝔽.E t0 pprev = pprev) (hb : 𝔽.E t0 pbar = pbar) (hpb : ∀ ω, |pprev ω| ≤ A)
    (hbb : ∀ ω, |pbar ω| ≤ B) :
    IsOptimal 𝔽 β κ lam xs u t0 (fun π' => π' t0 = pibar213 𝔽 β κ lam u pprev pbar t0)
      (planInfl (multPath 𝔽 β κ lam xs u (init213 κ lam xs pprev pbar) t0))
      (planGap κ lam xs (multPath 𝔽 β κ lam xs u (init213 κ lam xs pprev pbar) t0)) := by
  have h := plan_isOptimal 𝔽 hPO hβ0 hβ1 hκ hlam hu hua
    (fun t ht => multPath_rec27 𝔽 β κ lam xs u (init213 κ lam xs pprev pbar) ht)
    (by rw [multPath_init]; exact init213_known 𝔽 hp hb)
    (fun t _ ω => multPath_bounded 𝔽 hβ0 hκ hlam hu (init213_bounded hpb hbb) t0 t ω)
  have hval : planInfl (multPath 𝔽 β κ lam xs u (init213 κ lam xs pprev pbar) t0) t0 =
      pibar213 𝔽 β κ lam u pprev pbar t0 := by
    funext ω
    rw [planInfl_F2 𝔽 (multPath_rec27 𝔽 β κ lam xs u _ le_rfl), multPath_init]
    simp only [init213, pibar213, fwd]
    ring
  rwa [hval] at h

/-- Woodford (2003), eq. (F.8), p. 712: (1.7) rewritten with `π_t = p_t − p_{t−1}` says
`p_t + φ_t = p_{t−1} + φ_{t−1}`. The sum `p + φ` never changes. -/
theorem F8 {κ lam xs : ℝ} {π x φ p : ℤ → Ω → ℝ} {t0 : ℤ} (hfoc : FOC κ lam xs t0 π x φ)
    (hp : ∀ t, t0 ≤ t → p t = p (t - 1) + π t) :
    ∀ t, t0 ≤ t → ∀ ω, p t ω + φ t ω = p (t - 1) ω + φ (t - 1) ω := by
  intro t ht ω
  have h1 := (hfoc t ht ω).1
  have h2 := congrFun (hp t ht) ω
  simp only [Pi.add_apply] at h2
  linarith

/-- Woodford (2003), **Proposition 7.8**, p. 491, and App. F.3: along the constrained-optimal
plan for (2.13), with the price level `p_t = p_{t−1} + π_t` from `p_{t₀−1}`, the sum
`p_t + φ_t` is constant and equal to `p̄ − (λ/κ) x*` for every `t ≥ t₀ − 1` (by (F.8)). -/
theorem prop_7_8_invariant {β κ lam xs : ℝ} (hlam : 0 < lam) (u : ℤ → Ω → ℝ)
    {pprev pbar : Ω → ℝ} {t0 : ℤ} {p : ℤ → Ω → ℝ} (hp0 : p (t0 - 1) = pprev)
    (hp : ∀ t, t0 ≤ t →
      p t = p (t - 1) + planInfl (multPath 𝔽 β κ lam xs u (init213 κ lam xs pprev pbar) t0) t) :
    ∀ t, t0 - 1 ≤ t → ∀ ω, p t ω + multPath 𝔽 β κ lam xs u
      (init213 κ lam xs pprev pbar) t0 t ω = pbar ω - lam / κ * xs := by
  have h8 := F8 (plan_foc (κ := κ) (xs := xs) hlam _ t0) hp
  intro t ht
  induction t, ht using Int.leInduction with
  | base =>
    intro ω
    rw [hp0, multPath_init, init213]
    ring
  | succ n hn ih =>
    intro ω
    rw [h8 (n + 1) (by omega) ω, add_sub_cancel_right, ih ω]

/-- Woodford (2003), **Proposition 7.8**, p. 491, eq. (2.15): along the constrained-optimal plan
for (2.13), the price level satisfies
`p_t = (1 − μ₁) p̄ + μ₁ p_{t−1} + β⁻¹ ∑_j μ₂^{−j−1} E_t u_{t+j}` at every `t ≥ t₀`. The book
prints the left side as `p̄_t`; it is the equilibrium price level `p_t` (equal to `p̄_t`, the
value of the constraint (2.14) at date `t`, `prop_7_8_selfConsistent`). -/
theorem prop_7_8 {β κ lam xs : ℝ} (hlam : 0 < lam) (u : ℤ → Ω → ℝ) {pprev pbar : Ω → ℝ}
    {t0 : ℤ} {p : ℤ → Ω → ℝ} (hp0 : p (t0 - 1) = pprev)
    (hp : ∀ t, t0 ≤ t →
      p t = p (t - 1) + planInfl (multPath 𝔽 β κ lam xs u (init213 κ lam xs pprev pbar) t0) t)
    {t : ℤ} (ht : t0 ≤ t) (ω : Ω) :
    p t ω = (1 - m1 β κ lam) * pbar ω + m1 β κ lam * p (t - 1) ω +
      β⁻¹ * ∑' j : ℕ, (m2 β κ lam ^ (j + 1))⁻¹ * 𝔽.E t (u (t + j)) ω := by
  have hinv := prop_7_8_invariant 𝔽 hlam u hp0 hp (t - 1) (by omega) ω
  have h := congrFun (hp t ht) ω
  rw [Pi.add_apply, planInfl_F2 𝔽 (multPath_rec27 𝔽 β κ lam xs u _ ht)] at h
  rw [h]
  change _ = _ + fwd 𝔽 β (m2 β κ lam) u t ω
  linear_combination (1 - m1 β κ lam) * hinv

/-- Woodford (2003), p. 491 ("for any choice of `p̄`, this is a self-consistent constraint"):
the constrained-optimal price level satisfies the constraint (2.14) at every later date,
`p_t = p̄_t` with `p̄_t` built from `p_{t−1}`. -/
theorem prop_7_8_selfConsistent {β κ lam xs : ℝ} (hlam : 0 < lam) (u : ℤ → Ω → ℝ)
    {pprev pbar : Ω → ℝ} {t0 : ℤ} {p : ℤ → Ω → ℝ} (hp0 : p (t0 - 1) = pprev)
    (hp : ∀ t, t0 ≤ t →
      p t = p (t - 1) + planInfl (multPath 𝔽 β κ lam xs u (init213 κ lam xs pprev pbar) t0) t)
    {t : ℤ} (ht : t0 ≤ t) : p t = pbar214 𝔽 β κ lam u (p (t - 1)) pbar t := by
  funext ω
  rw [prop_7_8 𝔽 hlam u hp0 hp ht ω, pbar214]

/-- Woodford (2003), **Proposition 7.8**, p. 491 (self-consistency as timeless optimality): the
constrained-optimal plan for (2.13) is timelessly optimal for the specification (2.13) built
from its own lagged price level. -/
theorem prop_7_8_timeless (hPO : 𝔽.PullOut) {β κ lam xs M A B : ℝ} (hβ0 : 0 < β)
    (hβ1 : β < 1) (hκ : 0 < κ) (hlam : 0 < lam) {u : ℤ → Ω → ℝ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hua : ∀ t, 𝔽.E t (u t) = u t) {pprev pbar : Ω → ℝ} {t0 : ℤ}
    (hpk : 𝔽.E t0 pprev = pprev) (hb : 𝔽.E t0 pbar = pbar) (hpb : ∀ ω, |pprev ω| ≤ A)
    (hbb : ∀ ω, |pbar ω| ≤ B) {p : ℤ → Ω → ℝ} (hp0 : p (t0 - 1) = pprev)
    (hp : ∀ t, t0 ≤ t →
      p t = p (t - 1) + planInfl (multPath 𝔽 β κ lam xs u (init213 κ lam xs pprev pbar) t0) t) :
    TimelesslyOptimal 𝔽 β κ lam xs u t0 (fun t1 => pibar213 𝔽 β κ lam u (p (t1 - 1)) pbar t1)
      (planInfl (multPath 𝔽 β κ lam xs u (init213 κ lam xs pprev pbar) t0))
      (planGap κ lam xs (multPath 𝔽 β κ lam xs u (init213 κ lam xs pprev pbar) t0)) := by
  have hT := plan_timeless 𝔽 hPO hβ0 hβ1 hκ hlam hu hua
    (fun t ht => multPath_rec27 𝔽 β κ lam xs u (init213 κ lam xs pprev pbar) ht)
    (by rw [multPath_init]; exact init213_known 𝔽 hpk hb)
    (fun t _ ω => multPath_bounded 𝔽 hβ0 hκ hlam hu (init213_bounded hpb hbb) t0 t ω)
  intro t1 ht1
  have hval : planInfl (multPath 𝔽 β κ lam xs u (init213 κ lam xs pprev pbar) t0) t1 =
      pibar213 𝔽 β κ lam u (p (t1 - 1)) pbar t1 := by
    funext ω
    have hinv := prop_7_8_invariant 𝔽 hlam u hp0 hp (t1 - 1) (by omega) ω
    rw [planInfl_F2 𝔽 (multPath_rec27 𝔽 β κ lam xs u _ ht1)]
    simp only [pibar213, fwd]
    linear_combination (1 - m1 β κ lam) * hinv
  have h := hT t1 ht1
  rwa [hval] at h

/-- Woodford (2003), p. 492: for the particular target `p̄ = p_{t₀−1} + (λ/κ) x_{t₀−1}` the
constraint (2.13) is identical to (2.11), and the initial multipliers (hence the implied
state-contingent evolutions) are the same. -/
theorem p492 (β κ lam xs : ℝ) (u : ℤ → Ω → ℝ) {pprev pbar xprev : Ω → ℝ} (t0 : ℤ)
    (h : ∀ ω, pbar ω = pprev ω + lam / κ * xprev ω) :
    pibar213 𝔽 β κ lam u pprev pbar t0 = pibar211 𝔽 β κ lam u xprev t0 ∧
      init213 κ lam xs pprev pbar = init211 κ lam xs xprev := by
  constructor
  · funext ω
    simp only [pibar213, pibar211, h ω]
    ring
  · funext ω
    simp only [init213, init211, h ω]
    ring

/-! ### The `t₀`-optimal plan and the Lagrangian (2.4) -/

/-- Woodford (2003), p. 489 ("the inflation solution thus obtained is a stochastic
generalisation of (1.13)"): with no cost-push shocks the `t₀`-optimal plan (initial condition
(2.5) `φ_{t₀−1} = 0`) has inflation `π_t = (1 − μ₁)(λ/κ) x* μ₁^{t−t₀}`, the deterministic
component that depends on the time elapsed since `t₀`. -/
theorem t0_optimal_noshock (β κ lam xs : ℝ) {t0 t : ℤ} (ht : t0 ≤ t) (ω : Ω) :
    planInfl (multPath 𝔽 β κ lam xs (fun _ _ => 0) (fun _ => 0) t0) t ω =
      (1 - m1 β κ lam) * (lam / κ) * xs * m1 β κ lam ^ (t - t0).toNat := by
  have hF : ∀ s ω', fwd 𝔽 β (m2 β κ lam) (fun _ _ => 0) s ω' = 0 := by
    intro s ω'
    have h0 : ∀ r, 𝔽.E r (fun _ : Ω => (0 : ℝ)) = fun _ => 0 := fun r => 𝔽.const r 0
    simp [fwd, h0]
  have h1 : (t - t0 + 1).toNat = (t - t0).toNat + 1 := by omega
  have h2 : (t - 1 - t0 + 1).toNat = (t - t0).toNat := by omega
  simp only [planInfl, multPath, backSol, Pi.sub_apply, hF, add_zero, mul_zero, h1, h2,
    Finset.sum_range_succ]
  ring

/-- Woodford (2003), eq. (2.4), p. 488: the Lagrangian of the `t₀` commitment problem,
`E_{t₀} ∑ β^{t−t₀} {½[π_t² + λ (x_t − x*)²] + φ_t [π_t − κ x_t − β π_{t+1} − u_t]}`. The book's
constraint term omits `−u_t`. The shock does not depend on the choice variables, so the
first-order conditions are unaffected, but with `u_t` included the constraint term is exactly
(2.1). -/
noncomputable def lagrangian (β κ lam xs : ℝ) (u : ℤ → Ω → ℝ) (t0 : ℤ) (π x φ : ℤ → Ω → ℝ) :
    Ω → ℝ :=
  𝔽.E t0 (fun ω => ∑' k : ℕ, β ^ k * ((1 / 2) * (π (t0 + k) ω ^ 2 +
    lam * (x (t0 + k) ω - xs) ^ 2) + φ (t0 + k) ω * (π (t0 + k) ω - κ * x (t0 + k) ω -
      β * π (t0 + k + 1) ω - u (t0 + k) ω)))

/-- Woodford (2003), p. 488 (why `π_{t+1}` may replace `E_t π_{t+1}` in (2.4)): on every
feasible plan, for every bounded adapted multiplier process, the Lagrangian (2.4) equals half
the expected discounted loss. The constraint terms vanish in conditional expectation at `t₀` by
the identity `E_{t₀}[φ_t E_t π_{t+1}] = E_{t₀}[φ_t π_{t+1}]`. -/
theorem lagrangian_eq_half_loss (hPO : 𝔽.PullOut) {β κ lam xs M Mφ : ℝ} (hβ0 : 0 < β)
    (hβ1 : β < 1) {u π x φ : ℤ → Ω → ℝ} {t0 : ℤ} (hu : ∀ t ω, |u t ω| ≤ M)
    (hf : Feasible 𝔽 β κ u t0 π x) (hφa : ∀ t, t0 ≤ t → 𝔽.E t (φ t) = φ t)
    (hφb : ∀ t, t0 ≤ t → ∀ ω, |φ t ω| ≤ Mφ) :
    lagrangian 𝔽 β κ lam xs u t0 π x φ = (1 / 2 : ℝ) • loss 𝔽 β lam xs t0 π x := by
  obtain ⟨hAS, -, Mp, hMp⟩ := hf
  have hle : ∀ k : ℕ, t0 ≤ t0 + k := fun k => by omega
  have bπ : ∀ k : ℕ, ∀ ω, |π (t0 + k) ω| ≤ Mp := fun k ω => (hMp _ (hle k) ω).1
  have bπ1 : ∀ k : ℕ, ∀ ω, |π (t0 + k + 1) ω| ≤ Mp := fun k ω => (hMp _ (by omega) ω).1
  have bx : ∀ k : ℕ, ∀ ω, |x (t0 + k) ω| ≤ Mp := fun k ω => (hMp _ (hle k) ω).2
  set ℓ : ℕ → Ω → ℝ := fun k ω => π (t0 + k) ω ^ 2 + lam * (x (t0 + k) ω - xs) ^ 2 with hℓ
  set c : ℕ → Ω → ℝ := fun k ω => φ (t0 + k) ω * (π (t0 + k) ω - κ * x (t0 + k) ω -
    β * π (t0 + k + 1) ω - u (t0 + k) ω) with hc
  have bℓ : ∀ k ω, |ℓ k ω| ≤ Mp ^ 2 + |lam| * (Mp + |xs|) ^ 2 := fun k ω =>
    abs_add_le_of (abs_sq_le (bπ k ω))
      (abs_mul_le_of le_rfl (abs_sq_le (abs_sub_le_of (bx k ω) le_rfl)))
  have bc : ∀ k ω, |c k ω| ≤ Mφ * (Mp + |κ| * Mp + |β| * Mp + M) := fun k ω =>
    abs_mul_le_of (hφb _ (hle k) ω) (abs_sub_le_of (abs_sub_le_of (abs_sub_le_of (bπ k ω)
      (abs_mul_le_of le_rfl (bx k ω))) (abs_mul_le_of le_rfl (bπ1 k ω))) (hu _ ω))
  have hsplit : (fun ω => ∑' k : ℕ, β ^ k * ((1 / 2) * (π (t0 + k) ω ^ 2 +
      lam * (x (t0 + k) ω - xs) ^ 2) + φ (t0 + k) ω * (π (t0 + k) ω - κ * x (t0 + k) ω -
        β * π (t0 + k + 1) ω - u (t0 + k) ω))) =
      (1 / 2 : ℝ) • (fun ω => ∑' k : ℕ, β ^ k * ℓ k ω) +
        (fun ω => ∑' k : ℕ, β ^ k * c k ω) := by
    funext ω
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    rw [← tsum_mul_left, ← ((summable_disc hβ0.le hβ1 (fun k => bℓ k ω)).mul_left
      (1 / 2)).tsum_add (summable_disc hβ0.le hβ1 (fun k => bc k ω))]
    refine tsum_congr fun k => ?_
    simp only [hℓ, hc]
    ring
  have hEc : ∀ k : ℕ, 𝔽.E t0 (c k) = 0 := by
    intro k
    have hk := hle k
    have hceq : c k = β • (φ (t0 + k) * 𝔽.E (t0 + k) (π (t0 + k + 1)) -
        φ (t0 + k) * π (t0 + k + 1)) := by
      funext ω
      have eA := congrFun (hAS _ hk) ω
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at eA
      simp only [hc, Pi.smul_apply, Pi.sub_apply, Pi.mul_apply, smul_eq_mul]
      rw [eA]
      ring
    rw [hceq, map_smul, map_sub, 𝔽.lie_identity hPO hk (hφa _ hk), sub_self, smul_zero]
  have hEC : 𝔽.E t0 (fun ω => ∑' k : ℕ, β ^ k * c k ω) = 0 := by
    funext ω
    rw [𝔽.E_tsum_geom hβ0.le hβ1 bc t0 ω]
    simp [hEc]
  rw [lagrangian, loss, hsplit, map_add, map_smul, hEC, add_zero]

end Woodford.GainsFromCommitment.CostPushCommitment
