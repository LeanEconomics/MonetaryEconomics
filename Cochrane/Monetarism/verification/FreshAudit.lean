  field_simp

/-- Cochrane (2023), p. 637: **`u_m = [c^{1−θ} + αm^{1−θ}]^{(θ−γ)/(1−θ)} αm^{−θ}`**. -/
theorem hasDerivAt_cesU_m {α θ γ c m : ℝ} (hα : 0 ≤ α) (hc : 0 < c) (hm : 0 < m) (hθ : θ ≠ 1)
    (hγ : γ ≠ 1) :
