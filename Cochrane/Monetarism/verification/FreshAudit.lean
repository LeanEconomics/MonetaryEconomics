theorem rpow_one_sub {x : ℝ} (hx : 0 < x) (θ : ℝ) : x ^ (1 - θ) = x * x ^ (-θ) := by
  rw [sub_eq_add_neg, Real.rpow_add hx, Real.rpow_one]

/-- Cochrane (2023), p. 637: **`u_c = [c^{1−θ} + αm^{1−θ}]^{(θ−γ)/(1−θ)} c^{−θ}`** (`c, m > 0`,
