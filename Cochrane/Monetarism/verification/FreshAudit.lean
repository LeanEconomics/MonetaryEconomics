      (lt_div_iff₀ (by positivity)).1 (lt_of_lt_of_le hε (min_le_right _ _))
    filter_upwards [hopt.2.1 n, hmδ n, hK, hr01] with ω h1 h2 h3 h4
    by_cases hn : n = t
