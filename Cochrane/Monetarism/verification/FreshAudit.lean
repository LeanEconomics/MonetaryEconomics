  have key := pair_foc hβ (smooth₂_of_deriv hu hu') hopt hp (hcb t) (hcb (t + 1)) (hmb t)
    (hmb (t + 1)) (stronglyMeasurable_const) hrm.neg hz₂m (hz₂m.const_mul ϑ)
    (BddAt.const 0) hrb.neg hz₂b ((BddAt.const ϑ).mul hz₂b) hfin hcon
