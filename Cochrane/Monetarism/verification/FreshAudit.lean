      simp only [hz₂, hκ]
      rw [show β ^ (t + 1) * (u' (c (t + 1) ω) * (iota S Λ P t ω * r ω * Λ t ω /
        (Λ (t + 1) ω * wedge S ϑ Λ P (t + 1) ω))) = β ^ (t + 1) * u' (c (t + 1) ω) *
