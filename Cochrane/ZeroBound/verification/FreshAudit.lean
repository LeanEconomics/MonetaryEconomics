lemma iIndepFun_gaussSeq_mul (a : ℕ → ℝ) :
    iIndepFun (fun m (ω : ℕ → ℝ) => a m * ω m) gaussSeq :=
  iIndepFun_infinitePi (P := fun _ => gaussianReal 0 1) (X := fun m (x : ℝ) => a m * x)
