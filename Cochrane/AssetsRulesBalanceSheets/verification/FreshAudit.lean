        rw [e]
        exact S.E_pullOut (((hcnm (t + i)).measurable.const_div 1).stronglyMeasurable)
          (C := (n : ℝ) + 1) (Eventually.of_forall fun ω => by
            rw [abs_of_pos (one_div_pos.2 (hcn0 ω))]
