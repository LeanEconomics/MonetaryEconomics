        field_simp
        ring
      · simp [hb2, hω]
    have hbi2 : ∀ t, Integrable (b2 t) S.μ := fun t => (hbGi t).sub (hgfi t)
    have hGtvc : ∀ t, ∀ᵐ ω ∂S.μ,
        Tendsto (fun T => β ^ T * S.E t (G.indicator (b (t + T))) ω) atTop (𝓝 0) := by
      intro t
