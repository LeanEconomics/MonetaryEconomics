    have hgfK : ∀ t ω, |G.indicator (gf t) ω| ≤ K + |θ| * ((n : ℝ) + 2) * Ka := fun t ω => by
      have hK : 0 ≤ K := (abs_nonneg _).trans (hBK t ω)
      have hKa : 0 ≤ Ka := (abs_nonneg _).trans (haK t ω)
      by_cases hω : ω ∈ G
      · rw [Set.indicator_of_mem hω]
