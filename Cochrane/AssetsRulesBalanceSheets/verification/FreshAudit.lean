    have hgfpre : ∀ t, StronglyMeasurable[S.𝓕 t] (gf (t + 1)) := fun t =>
      (hBpre t).add ((stronglyMeasurable_const.mul ((hcnm t).sub stronglyMeasurable_const)).mul
