      intro t k
      have hpo : ∀ i, S.E (t + i) (fun ω => 1 / P2 (t + i + 1) ω) =ᵐ[S.μ]
          (fun ω => 1 / cn ω) * S.E (t + i) (fun ω => 1 / Pstar (t + i + 1) ω) := fun i => by
        have e : (fun ω => 1 / P2 (t + i + 1) ω) =
