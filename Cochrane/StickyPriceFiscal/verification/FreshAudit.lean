        nlinarith [hL2, hL3]
      have hJq : (4 * (-(33 / 28) / (L + 1) + 10 / 7 / (L + 3 / 10)) - 2 * (145 / 49)) *
          ((L + 1) * (L + 3 / 10)) = 4 * (-(33 / 28) * (L + 3 / 10) + 10 / 7 * (L + 1)) -
