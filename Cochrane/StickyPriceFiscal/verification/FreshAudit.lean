  have hL4 : L ^ 4 = 1 / 20 * L ^ 3 + L ^ 2 := by linear_combination L ^ 2 * hL2
  have hE : ((1 / 20 + (L - 1 / 20)) * (145 / 49) - 2 * (1 / 2) * (145 / 49 -
